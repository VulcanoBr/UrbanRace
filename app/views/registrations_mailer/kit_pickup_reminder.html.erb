<%# app/views/registrations_mailer/kit_pickup_reminder.html.erb %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #18181b; }
    .wrapper { max-width: 600px; margin: 32px auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    .header { background: <%= @urgency ? "#dc2626" : "#ea580c" %>; padding: 32px 40px; text-align: center; }
    .header h1 { color: #ffffff; font-size: 22px; font-weight: 700; line-height: 1.3; }
    .header p  { color: rgba(255,255,255,.85); font-size: 14px; margin-top: 6px; }
    .body { padding: 36px 40px; }
    .greeting { font-size: 16px; margin-bottom: 20px; }
    .info-box { background: #fef9f6; border: 1px solid #fed7aa; border-radius: 10px; padding: 20px 24px; margin-bottom: 24px; }
    .info-box h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: #9a3412; font-weight: 600; margin-bottom: 12px; }
    .info-row { display: flex; justify-content: space-between; align-items: baseline; padding: 6px 0; border-bottom: 1px solid #ffe4cc; }
    .info-row:last-child { border-bottom: none; }
    .info-row .label { font-size: 13px; color: #71717a; }
    .info-row .value { font-size: 14px; font-weight: 600; color: #18181b; text-align: right; }
    .dorsal { background: #ea580c; color: #fff; font-size: 28px; font-weight: 900; text-align: center; border-radius: 8px; padding: 14px; margin-bottom: 24px; letter-spacing: 2px; }
    .urgency-banner { background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px; font-size: 14px; color: #991b1b; font-weight: 500; }
    .cta { text-align: center; margin: 28px 0; }
    .btn { display: inline-block; background: <%= @urgency ? "#dc2626" : "#ea580c" %>; color: #ffffff !important; text-decoration: none; font-weight: 700; font-size: 15px; padding: 14px 36px; border-radius: 8px; }
    .tips { background: #f0fdf4; border-left: 4px solid #16a34a; border-radius: 0 8px 8px 0; padding: 16px 20px; margin-bottom: 24px; }
    .tips h3 { font-size: 13px; font-weight: 700; color: #15803d; margin-bottom: 8px; text-transform: uppercase; letter-spacing: .05em; }
    .tips ul { padding-left: 18px; }
    .tips li { font-size: 13px; color: #166534; margin-bottom: 4px; }
    .footer { background: #f4f4f5; padding: 24px 40px; text-align: center; font-size: 12px; color: #71717a; }
    .footer a { color: #ea580c; text-decoration: none; }
  </style>
</head>
<body>
  <div class="wrapper">

    <%# ── Header ──────────────────────────────────────────────────── %>
    <div class="header">
      <h1>
        <% if @urgency %>
          ⚠️ Retire seu kit hoje!
        <% else %>
          📦 Lembrete: retirada de kit
        <% end %>
      </h1>
      <p>Faltam <strong><%= @hours_label %></strong> para a largada de <%= @event.nome %></p>
    </div>

    <div class="body">

      <p class="greeting">Olá, <strong><%= @athlete.nome.split.first %></strong>! 👋</p>

      <% if @urgency %>
        <div class="urgency-banner">
          🚨 <strong>Atenção!</strong> Sua largada é amanhã e você ainda não retirou o kit.
          Sem o kit, não há dorsal — e sem dorsal não é possível participar da prova.
        </div>
      <% end %>

      <%# ── Dorsal ────────────────────────────────────────────────── %>
      <% if @registration.numero_dorsal.present? %>
        <div class="dorsal">
          Nº <%= @registration.numero_dorsal %>
        </div>
      <% end %>

      <%# ── Dados da inscrição ────────────────────────────────────── %>
      <div class="info-box">
        <h2>Sua inscrição</h2>
        <div class="info-row">
          <span class="label">Evento</span>
          <span class="value"><%= @event.nome %></span>
        </div>
        <div class="info-row">
          <span class="label">Data da largada</span>
          <span class="value">
            <%= I18n.l(@event.data_largada, format: :long) rescue @event.data_largada.strftime("%d/%m/%Y às %Hh%M") %>
          </span>
        </div>
        <div class="info-row">
          <span class="label">Distância</span>
          <span class="value"><%= @registration.distance.nome %></span>
        </div>
        <div class="info-row">
          <span class="label">Categoria</span>
          <span class="value"><%= @registration.category.nome %></span>
        </div>
        <div class="info-row">
          <span class="label">Tamanho do kit</span>
          <span class="value"><%= @registration.tamanho_kit %></span>
        </div>
      </div>

      <%# ── Dicas ─────────────────────────────────────────────────── %>
      <div class="tips">
        <h3>✅ O que trazer na retirada</h3>
        <ul>
          <li>Documento com foto (RG, CNH ou passaporte)</li>
          <li>Confirmação da inscrição (este e-mail ou o QR Code)</li>
          <li>Em caso de retirada por terceiro: procuração simples + cópia do documento do titular</li>
        </ul>
      </div>

      <%# ── CTA ───────────────────────────────────────────────────── %>
      <div class="cta">
        <a href="<%= Rails.application.routes.url_helpers.athlete_registration_url(@registration, host: Rails.application.config.action_mailer.default_url_options[:host]) rescue "#" %>"
           class="btn">
          Ver detalhes da minha inscrição
        </a>
      </div>

      <p style="font-size:13px; color:#71717a; text-align:center;">
        Dúvidas? Entre em contato pelo e-mail
        <a href="mailto:<%= Rails.application.config.x.support_email rescue "suporte@urbanrace.com.br" %>"
           style="color:#ea580c;">
          <%= Rails.application.config.x.support_email rescue "suporte@urbanrace.com.br" %>
        </a>
      </p>
    </div>

    <%# ── Footer ────────────────────────────────────────────────────── %>
    <div class="footer">
      <p>Você recebeu este e-mail porque está inscrito em <strong><%= @event.nome %></strong>.</p>
      <p style="margin-top:6px;">
        &copy; <%= Date.today.year %> UrbanRace. Todos os direitos reservados.
      </p>
    </div>

  </div>
</body>
</html>
