<%# Navigation Bar %>
<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" data-controller="scroll-nav">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <%= link_to root_path, class: "flex items-center group" do %>
      <%# Ajuste de tamanho do Logo: h-16 no mobile e h-24 em telas maiores %>
      <%= image_tag "logo_urbanrace_3d.png", class: "h-16 md:h-24 w-full transform group-hover:scale-105 transition duration-300", alt: "Urban Race" %>
    <% end %>

    <div class="flex items-center gap-4">
      <%= link_to "MINHAS INSCRIÇÕES", athletes_dashboard_path, class: "hidden sm:block text-[10px] font-black tracking-widest text-white/80 hover:text-white transition" %>
      <%= link_to "LOGIN", new_session_path, class: "text-xs font-bold tracking-widest text-white border border-white/30 bg-white/10 backdrop-blur-md px-6 py-2.5 rounded-full hover:bg-orange-500 hover:border-orange-500 transition-all duration-300 shadow-lg" %>
    </div>
  </div>
</nav>

<%# Hero Section: Ajustado para evitar sobreposição %>
<%# Mudamos min-h-[90vh] para min-h-screen e adicionamos pb-32 para dar espaço à barra de stats %>
<section class="relative min-h-screen flex flex-col items-center justify-center bg-green-800 pt-24 pb-32 overflow-hidden">
  
  <%# Background Ornaments %>
  <div class="absolute top-0 left-0 w-full h-full opacity-30">
    <div class="absolute top-1/4 -left-20 w-96 h-96 bg-green-500 rounded-full mix-blend-screen filter blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-1/4 -right-20 w-80 h-80 bg-orange-600 rounded-full mix-blend-screen filter blur-[100px]"></div>
  </div>

  <%# Conteúdo do Hero %>
  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    <span class="inline-block px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-500 text-[10px] font-black tracking-[0.2em] mb-6 animate-bounce">
      TEMPORADA 2026 ABERTA
    </span>
    
    <%# Ajuste de tamanho de fonte para evitar que o texto fique gigante demais em telas ultra-wide %>
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-white mb-8 tracking-tighter leading-[0.9]">
      SUA PRÓXIMA <span class="italic text-orange-500">VITÓRIA</span><br>COMEÇA AQUI.
    </h1>
    
    <p class="text-base md:text-xl text-green-100/70 max-w-2xl mx-auto mb-12 font-medium leading-relaxed">
      A plataforma definitiva para atletas que buscam desafios reais. Encontre corridas, monitore seu desempenho e supere seus limites.
    </p>

    <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
      <%= link_to "#proximas", class: "group relative bg-orange-500 text-white px-10 py-5 rounded-2xl font-black text-sm tracking-widest hover:bg-orange-600 transition shadow-xl transform hover:-translate-y-1" do %>
        VER CALENDÁRIO
        <svg class="inline-block w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M17 8l4 4m0 0l-4 4m4-4H3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <% end %>
      
      <%= link_to new_session_path, class: "group text-white font-bold text-sm tracking-widest flex items-center gap-3 hover:text-orange-400 transition" do %>
        <span class="w-12 h-12 flex items-center justify-center rounded-full bg-white/5 border border-white/10 group-hover:bg-white/10 transition">
           <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        MINHAS INSCRIÇÕES
      <% end %>
    </div>
  </div>

  <%# Stats bar: Fixada no rodapé da seção hero %>
  <div class="absolute bottom-0 left-0 right-0 bg-white/5 backdrop-blur-sm border-t border-white/10 py-8 hidden md:block">
    <div class="max-w-7xl mx-auto px-6 flex justify-around items-center">
      <div class="text-center">
        <p class="text-white text-3xl font-black">+50k</p>
        <p class="text-green-400 text-[10px] font-bold tracking-widest uppercase">Atletas Ativos</p>
      </div>
      <div class="w-px h-10 bg-white/10"></div>
      <div class="text-center">
        <p class="text-white text-3xl font-black">120</p>
        <p class="text-green-400 text-[10px] font-bold tracking-widest uppercase">Provas Anuais</p>
      </div>
      <div class="w-px h-10 bg-white/10"></div>
      <div class="text-center">
        <p class="text-white text-3xl font-black">100%</p>
        <p class="text-green-400 text-[10px] font-bold tracking-widest uppercase">Segurança no Pix</p>
      </div>
    </div>
  </div>
</section>

<%# Seção: Próximos Eventos %>
<section id="proximas" class="bg-orange-500 py-16 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-xl">
        <h2 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tighter mb-4 italic">PRÓXIMAS LARGADAS</h2>
        <div class="h-1.5 w-24 bg-green-800 rounded-full"></div>
      </div>
      <div class="flex gap-2">
        <button class="p-3 rounded-xl border border-gray-200 hover:bg-gray-50 transition"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg></button>
        <button class="p-3 rounded-xl border border-gray-200 hover:bg-gray-50 transition"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      <% @upcoming_events.each do |event| %>
        <div class="group relative bg-white rounded-[32px] p-2 border border-gray-100 shadow-[0_10px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_30px_60px_rgba(0,0,0,0.1)] transition-all duration-500 hover:-translate-y-2">
          
          <%# Header do Card com a Imagem de Banner %>
          <div class="relative h-64 overflow-hidden rounded-[28px] bg-slate-200">
            
            <% if event.banner.attached? %>
              <%# Imagem do Banner - Usamos variant para otimizar o carregamento %>
              <%= image_tag event.banner.variant(resize_to_limit: [800, 600]), 
                  class: "absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110",
                  alt: event.nome %>
            <% else %>
              <%# Fallback caso não haja imagem: um gradiente ou padrão visual %>
              <div class="absolute inset-0 bg-gradient-to-br from-black to-red-400 opacity-20"></div>
            <% end %>

            <%# Overlay Gradiente: Essencial para o contraste do texto branco sobre qualquer imagem %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent z-10"></div>

            <%# Badge: Inscrições Abertas %>
            <div class="absolute top-6 left-4 z-20">
              <span class="bg-green-500/90 backdrop-blur-sm text-white px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider shadow-lg">
                Inscrições Abertas
              </span>
            </div>

            <%# Date Badge & Info Localização %>
            <div class="absolute bottom-6 left-6 z-20 flex items-center gap-3 w-full pr-12">
              <div class="bg-white/10 backdrop-blur-md border border-white/20 p-2 rounded-xl text-white text-center min-w-[54px] shadow-xl">
                <span class="block text-xl font-black leading-none"><%= event.data_largada.day %></span>
                <span class="text-[9px] font-bold uppercase"><%= l event.data_largada, format: "%b" %></span>
              </div>
              <div class="text-white drop-shadow-md">
                <p class="text-[10px] font-bold opacity-80 uppercase tracking-widest leading-none mb-1">
                  <%= l event.data_largada, format: "%Y" %>
                </p>
                <h4 class="font-black text-lg truncate leading-tight"><%= event.cidade %></h4>
              </div>
            </div>
          </div>

          <%# Corpo do Card %>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-4 transition">
              <%= link_to event.nome, public_event_path(event), 
                  class: "group-hover:text-blue-600 transition block truncate" %>
            </h3>
            
            <div class="flex flex-wrap gap-2 mb-8">
              <% event.distances.each do |d| %>
                <span class="text-[10px] font-black text-gray-500 bg-gray-50 border border-gray-100 px-3 py-1.5 rounded-lg italic group-hover:bg-blue-50 group-hover:text-blue-600 transition duration-300">
                  <%= d.nome %>
                </span>
              <% end %>
            </div>

            <div class="flex items-center justify-between">
              <div>
                <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest">Inscrições a partir de</p>
                <p class="text-xl font-black text-gray-900">
                  <%# Lógica para pegar o preço do primeiro lote ativo %>
                  <%= number_to_currency(event.distances.first&.lots&.atuais&.first&.preco || 0) %>
                </p>
              </div>
              <%= link_to "INSCREVER", public_event_path(event.slug_url), 
                  class: "bg-gray-900 text-white px-6 py-3 rounded-2xl font-black text-xs hover:bg-orange-500 transition-all shadow-lg active:scale-95" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# Seção: Histórico (Dark) %>
<section class="bg-gray-950 py-24 px-6 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-1/2 h-full bg-orange-600/5 skew-x-12 translate-x-20"></div>
  
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="mb-16">
      <h2 class="text-3xl md:text-5xl font-black text-white tracking-tighter italic">SUA JORNADA É ETERNA</h2>
      <p class="text-gray-500 mt-2 font-bold tracking-widest uppercase text-xs text-orange-500">Resultados e Registros de Eventos Passados</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @past_events.each do |event| %>
        <div class="flex items-center justify-between bg-white/5 border border-white/10 p-6 rounded-[24px] hover:bg-white/10 transition-all group">
          <div class="flex items-center gap-6">
            <div class="text-center bg-green-500/10 rounded-2xl p-4 min-w-[80px] border border-green-500/20">
              <span class="block text-2xl font-black text-green-500 leading-none"><%= event.data_largada.day %></span>
              <span class="text-[10px] font-bold text-green-300/50 uppercase tracking-tighter"><%= l event.data_largada, format: "%b %y" %></span>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2 group-hover:text-orange-400 transition"><%= event.nome %></h4>
              <div class="flex gap-4">
                <%= link_to public_event_ranking_path(event.slug_url),
                            class: "flex items-center gap-1.5 text-[9px] font-black text-blue-400 hover:text-blue-300 tracking-widest uppercase transition" do %>

                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>

                  Classificação

                <% end %>
                <%= link_to public_event_photos_path(event.slug_url), class: "flex items-center gap-1.5 text-[9px] font-black text-green-400 hover:text-green-300 tracking-widest uppercase transition" do %>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /></svg>
                  Fotos IA
                <% end %>
              </div>
            </div>
          </div>
          <div class="hidden sm:block opacity-0 group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-300">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# Footer: Ajuste de tamanho do logo e espaçamento %>
<footer class="bg-green-800 pt-24 pb-12 px-6">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-12 border-b border-gray-200 pb-16 mb-12">
    
    <!-- 1. Bloco de Texto (Esquerda no Desktop) -->
    <div class="text-center md:text-left max-w-xs order-2 md:order-1">
      <p class="text-sm text-white leading-relaxed">
        Organizando experiências inesquecíveis no asfalto desde 2026.
      </p>
    </div>

    <!-- 2. Logotipo (Centralizado entre os textos) -->
    <div class="order-1 md:order-2 flex justify-center">
      <%= link_to root_path do %>
        <%# Tamanho ajustado para h-24 para melhor presença no centro %>
        <%= image_tag "logo_urbanrace_3d.png", 
                      class: "h-20 md:h-24 w-full opacity-90 grayscale hover:opacity-100 transition duration-300 transform hover:scale-105", 
                      alt: "Urban Race Logo" %>
      <% end %>
    </div>
    
    <!-- 3. Bloco de Links (Direita no Desktop) -->
    <div class="flex gap-16 order-3">
      <div class="flex flex-col gap-4">
        <p class="text-[10px] font-black text-white uppercase tracking-widest">Institucional</p>
        <%= link_to "Sobre Nós", sobre_path, class: "text-sm font-bold text-white hover:text-orange-400 transition" %>
        <a href="<%= contato_path %>" class="text-sm font-bold text-white hover:text-orange-500 transition">Contato</a>
      </div>
      <div class="flex flex-col gap-4">
        <p class="text-[10px] font-black text-white uppercase tracking-widest">Legal</p>
        <%= link_to "Privacidade", privacidade_path, class: "text-sm font-bold text-white hover:text-green-300 transition" %>
        <%= link_to "LGPD",        lgpd_path,        class: "text-sm font-bold text-white hover:text-green-300 transition" %>
      </div>
    </div>

  </div>

  <%# Copyright Line %>
  <p class="text-center text-[10px] font-bold text-black-200 tracking-[0.4em] uppercase">
    © 2026 URBANRACE - High Performance System
  </p>
</footer>