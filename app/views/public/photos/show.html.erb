<%# Header do Evento - Estilo Dark High Performance %>
<%# Header do Evento - Estilo Dark High Performance %>
<section class="relative bg-gray-950 pt-10 pb-24 px-6 overflow-hidden">
  <%# Ornamento de fundo %>
  <div class="absolute top-0 right-0 w-96 h-96 bg-orange-600/10 rounded-full blur-[120px]"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    
    <%# --- NOVA BARRA DE NAVEGAÇÃO SUPERIOR --- %>
    <div class="flex justify-between items-center mb-16">
      <%= link_to root_path, class: "transition transform hover:scale-105 duration-300" do %>
        <%= image_tag "logo_urbanrace_3d.png", class: "h-16 md:h-24 w-auto", alt: "Urban Race Logo" %>
      <% end %>

      <%= link_to root_path, class: "group flex items-center gap-2 text-[10px] font-black text-white/50 hover:text-orange-500 tracking-[0.2em] transition-all" do %>
        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        VOLTAR PARA HOME
      <% end %>
    </div>
    <%# ---------------------------------------- %>

    <div class="text-center">
      <span class="inline-block px-4 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-500 text-[10px] font-black tracking-[0.3em] mb-6 uppercase">
        Registros Oficiais
      </span>
      <h1 class="text-4xl md:text-7xl font-black text-white mb-6 italic uppercase leading-none">
        Galeria do <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">Evento</span>
      </h1>
      <p class="text-gray-400 font-bold tracking-widest uppercase text-sm">
        <%= @event.nome %> • <%= l @event.data_largada, format: :long %>
      </p>
    </div>
  </div>
</section>

<section class="bg-white py-20 px-6">
  <div class="max-w-7xl mx-auto">
    
    <%# Mosaico de Atletas (Random 12) %>
    <div class="mb-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
        <div>
          <h2 class="text-3xl font-black text-gray-900 italic uppercase leading-none">Atletas em Ação</h2>
          <p class="text-gray-500 text-xs font-bold mt-2 uppercase tracking-widest">Uma amostra da superação nas pistas</p>
        </div>
        
        <%# Banner de Direcionamento para o Atleta %>
        <div class="bg-gray-900 text-white p-6 rounded-3xl flex items-center gap-6 shadow-xl transform hover:scale-[1.02] transition duration-300">
          <div class="flex-1">
            <p class="text-[10px] font-black text-orange-500 uppercase tracking-widest mb-1">É corredor desta prova?</p>
            <p class="text-xs font-medium text-gray-300">Acesse seu painel para ver todas as suas fotos identificadas.</p>
          </div>
          <%= link_to "MEU PAINEL", athletes_dashboard_path, class: "bg-orange-500 text-white px-6 py-3 rounded-xl font-black text-[10px] tracking-widest hover:bg-orange-600 transition shadow-lg" %>
        </div>
      </div>

      <% if @athlete_photos.any? %>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <% @athlete_photos.each do |photo| %>
            <div class="group relative aspect-square overflow-hidden rounded-[32px] bg-gray-100 shadow-sm border border-gray-100">
              <%= image_tag photo.arquivo.variant(resize_to_limit: [600, 600]), 
                  class: "w-full h-full object-cover transition duration-700 group-hover:scale-110 group-hover:rotate-2" %>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-8">
                <span class="text-white font-black text-[10px] tracking-[0.2em] uppercase">UrbanRace Highlights</span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Galeria Completa do Evento (Sem limite) %>
    <div>
      <div class="mb-10">
        <h2 class="text-3xl font-black text-gray-900 italic uppercase leading-none">Momentos do Evento</h2>
        <p class="text-gray-500 text-xs font-bold mt-2 uppercase tracking-widest">Largada, Premiação e Bastidores</p>
      </div>

      <% if @event_photos.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @event_photos.each do |photo| %>
            <div class="group relative aspect-video overflow-hidden rounded-[32px] bg-gray-100 shadow-md border border-gray-100">
              <%= image_tag photo.arquivo.variant(resize_to_limit: [800, 600]), 
                  class: "w-full h-full object-cover transition duration-700 group-hover:scale-105" %>
              <div class="absolute top-4 left-4">
                <span class="bg-white/10 backdrop-blur-md border border-white/20 text-white text-[8px] font-black px-3 py-1 rounded-full uppercase tracking-widest">
                  Official Record
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-20 bg-gray-50 rounded-[40px] border-2 border-dashed border-gray-200">
          <p class="text-gray-400 font-bold uppercase tracking-widest text-xs">As fotos oficiais do evento serão publicadas em breve.</p>
        </div>
      <% end %>
    </div>

  </div>
</section>