<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body { font-family: sans-serif; background-color: #030712; color: #ffffff; padding: 20px; }
      .container { max-width: 600px; margin: 0 auto; background: #111827; border: 1px solid #374151; border-radius: 20px; padding: 40px; }
      .header { border-bottom: 2px solid #f97316; padding-bottom: 20px; margin-bottom: 20px; }
      .label { color: #9ca3af; font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; }
      .content { font-size: 16px; line-height: 1.6; color: #e5e7eb; }
      .footer { margin-top: 30px; font-size: 12px; color: #6b7280; border-top: 1px solid #374151; pt-20: 20px; }
      .highlight { color: #f97316; font-weight: bold; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1 style="color: #ffffff; margin: 0;">Novo Contato <span style="color: #f97316;">UrbanRace</span></h1>
      </div>
      
      <div class="content">
        <p><span class="label">Atleta/Interessado:</span><br>
        <strong style="font-size: 18px;"><%= @nome %></strong> (<%= @email %>)</p>
        
        <p><span class="label">Assunto:</span><br>
        <span class="highlight"><%= @assunto %></span></p>
        
        <p><span class="label">Mensagem:</span><br>
        <div style="background: #1f2937; padding: 20px; border-radius: 10px; font-style: italic;">
          "<%= @mensagem %>"
        </div></p>
      </div>

      <div class="footer">
        Este e-mail foi enviado automaticamente pelo Sistema UrbanRace High Performance.
      </div>
    </div>
  </body>
</html>