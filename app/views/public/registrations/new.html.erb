<div class="min-h-screen bg-gray-50 pb-12 transition-colors duration-200">
  <%# Cabeçalho da Página %>
  <div class="bg-blue-700 py-12 px-4 shadow-lg mb-8">
    <div class="max-w-4xl mx-auto">
      <%= link_to public_event_path(@event.slug_url), class: "inline-flex items-center text-blue-100 hover:text-white mb-4 text-sm font-bold transition" do %>
        <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        VOLTAR PARA O EVENTO
      <% end %>
      <h1 class="text-3xl md:text-4xl font-black text-white uppercase tracking-tight">
        Inscrição: <span class="text-orange-400"><%= @event.nome %></span>
      </h1>
      <p class="text-blue-100 mt-2 font-medium">Preencha os campos abaixo para garantir sua vaga na largada.</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4" data-controller="maskphone maskcpfcnpj">
      <%= form_with model: @registration_form, url: new_public_registration_path(@event.slug_url), method: :post,
          class: "space-y-8", data: { turbo: false } do |f| %>
      <%# Campos Ocultos cruciais para o salvamento %>
      <%= f.hidden_field :distance_id %>
      <%= f.hidden_field :lot_id %>
      <%= f.hidden_field :event_id %>
      
      <%# Mensagens de Erro Globais %>
      <% if @registration_form.errors.any? %>
        <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-xl shadow-md mb-8 animate-pulse">
          <div class="flex items-center mb-2">
            <svg class="h-5 w-5 text-red-500 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
            <h3 class="text-sm font-black text-red-800 uppercase tracking-widest">Existem erros no formulário:</h3>
          </div>
          <ul class="list-disc list-inside text-sm text-red-700 space-y-1 ml-7">
            <% @registration_form.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Seção 1: Dados do Atleta %>
      <section class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="text-lg font-black text-gray-800 uppercase flex items-center">
            <span class="bg-blue-600 text-white w-7 h-7 rounded-full flex items-center justify-center mr-3 text-xs">01</span>
            Identificação do Atleta
          </h3>
          <%  unless current_athlete %>
            <span class="text-[10px] font-bold bg-blue-100 text-blue-700 px-2 py-1 rounded-lg">CRIAREMOS SUA CONTA AUTOMATICAMENTE</span>
          <% end %>
        </div>
        
        <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="md:col-span-2">
            <%= f.label :nome, "Nome Completo", class: "block text-sm font-bold text-gray-700 mb-1" %>
            <%= f.text_field :nome, placeholder: "Como aparecerá no certificado", class: "w-full px-3 py-1 rounded-xl border-gray-300 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm" %>
          </div>

          <div>
            <%= f.label :email_address, "E-mail Principal", class: "block text-sm font-bold text-gray-700 mb-1" %>
            <%= f.email_field :email_address, placeholder: "exemplo@email.com", class: "w-full rounded-xl px-3 py-1  border-gray-300 focus:ring-blue-500 transition shadow-sm" %>
          </div>

          <div>
            <%= f.label :cpf, "CPF", class: "block text-sm font-bold text-gray-700 mb-1" %>
            <%= f.text_field :cpf, placeholder: '999.999.999-99', maxlength: "14", "data-maskcpfcnpj-target": "inputCpfCnpj", 
                                    "data-action": "keyup->maskcpfcnpj#addMaskToCpfCnpjFields",
                                    class: "w-full rounded-xl px-3 py-1 border-gray-300 focus:ring-blue-500 transition shadow-sm" %>
          </div>

          <div>
            <%= f.label :nascimento, "Data de Nascimento", class: "block text-sm font-bold text-gray-700 mb-1" %>
            <%= f.date_field :nascimento, class: "w-full rounded-xl px-3 py-1  border-gray-300 focus:ring-blue-500 transition shadow-sm" %>
          </div>

          <div>
            <%= f.label :sexo, "Sexo Biológico", class: "block text-sm font-bold text-gray-700 mb-1" %>
            <%= f.select :sexo, [ ["Masculino", "masculino"], ["Feminino", "feminino"] ], { prompt: "Selecione..." },
              {required: true, class: "w-full rounded-xl px-3 py-1  border-gray-300 focus:ring-blue-500 transition shadow-sm"} %>
          </div>
          
          <div class="md:col-span-2">
            <%= f.label :telefone, "Telefone / WhatsApp", class: "block text-sm font-bold text-gray-700 mb-1" %>
            <%= f.telephone_field :telefone, placeholder: "(99) 99999-9999",  maxlength: "15",
                                  "data-maskphone-target": "inputPhone", 
                                  "data-action": "keyup->maskphone#addMaskToPhoneFields",
                                  class: "w-full rounded-xl px-3 py-1 border-gray-300 focus:ring-blue-500 transition shadow-sm" %>
          </div>
        </div>
      </section>

      <%# Seção 2: Dados da Prova %>
      <<section class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-black text-gray-800 uppercase flex items-center">
            <span class="bg-blue-600 text-white w-7 h-7 rounded-full flex items-center justify-center mr-3 text-xs">02</span>
            Dados da Prova
          </h3>
        </div>
        
        <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <%# EXIBIÇÃO DA DISTÂNCIA (NÃO EDITÁVEL) %>
          <div>
            <label class="block text-sm font-bold text-gray-400 uppercase mb-1">Percurso Selecionado</label>
            <div class="w-full rounded-xl border border-gray-100 bg-gray-50 px-4 py-3 font-black text-blue-700 text-lg">
              <%= @distance.nome %> (<%= @distance.km %>K)
            </div>
          </div>

          <%# EXIBIÇÃO DO VALOR (NÃO EDITÁVEL) %>
          <div>
            <label class="block text-sm font-bold text-gray-400 uppercase mb-1">Valor da Inscrição</label>
            <div class="w-full rounded-xl border border-gray-100 bg-green-50 px-4 py-3 font-black text-green-700 text-lg">
              <%= number_to_currency(@current_lot.preco) %>
              <span class="text-[10px] font-bold text-green-600/60 ml-2 uppercase">Lote <%= @current_lot.numero %></span>
            </div>
          </div>

          <%# CATEGORIA (FILTRADA PELA DISTÂNCIA) %>
          <div>
            <%= f.label :category_id, "Sua Categoria (baseada na sua idade/sexo)", class: "block text-sm font-bold text-gray-700 mb-1" %>
            <%= f.collection_select :category_id, @distance.categories, :id, :nome, 
                { prompt: "Selecione a categoria..." }, 
                { class: "w-full rounded-xl px-3 py-1 border-gray-300 focus:ring-blue-500 transition shadow-sm font-bold" } %>
          </div>

          <div>
            <%= f.label :tamanho_kit, "Tamanho da Camiseta", class: "block text-sm font-bold text-gray-700 mb-1" %>
            <%= f.select :tamanho_kit, ["PP", "P", "M", "G", "GG", "EXG"], { prompt: "Escolha o tamanho..." }, class: "w-full rounded-xl px-3 py-1 border-gray-300 focus:ring-blue-500 transition shadow-sm" %>
          </div>

          <div class="md:col-span-2">
            <%= f.label :atestado_file, "Upload Atestado Médico (Obrigatório)", class: "block text-sm font-bold text-gray-700 mb-1" %>
            <%= f.file_field :atestado_file, accept: ".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png",
                class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl 
                  file:border-0 file:text-xs file:font-black file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 
                  transition file:cursor-pointer" %>
            <p class="mt-1 text-xs text-gray-500">
              Formatos aceitos: PDF, JPG e PNG. Tamanho máximo: 5 MB.
            </p>

          </div>
        </div>
      </section>


      <%# Seção 3: Segurança e Legal %>
      <section class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-black text-gray-800 uppercase flex items-center">
            <span class="bg-blue-600 text-white w-7 h-7 rounded-full flex items-center justify-center mr-3 text-xs">03</span>
            Segurança e Termos
          </h3>
        </div>
        
        <div class="p-6 md:p-8 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= f.label :contato_emergencia, "Contato de Emergência (Nome)", class: "block text-sm font-bold text-gray-700 mb-1" %>
              <%= f.text_field :contato_emergencia, placeholder: "Nome do responsável", class: "w-full rounded-xl px-3 py-1 border-gray-300 focus:ring-blue-500 shadow-sm" %>
            </div>
            <div>
              <%= f.label :fone_emergencia, "Telefone de Emergência", class: "block text-sm font-bold text-gray-700 mb-1" %>
              <%= f.text_field :fone_emergencia, placeholder: "(99) 99999-9999",  maxlength: "15",
                                  "data-maskphone-target": "inputPhone", 
                                  "data-action": "keyup->maskphone#addMaskToPhoneFields",
                                class: "w-full rounded-xl px-3 py-1 border-gray-300 focus:ring-blue-500 shadow-sm" %>
            </div>
          </div>

          <div class="bg-blue-50 p-4 rounded-2xl border border-blue-100 flex items-start">
            <div class="flex items-center h-6">
              <%= f.check_box :aceite_lgpd, class: "h-5 w-5 text-blue-600 border-gray-300 rounded-lg focus:ring-blue-500" %>
            </div>
            <div class="ml-4 text-sm">
              <%= f.label :aceite_lgpd, class: "font-medium text-blue-900" do %>
                Aceito os <a href="#" class="underline font-bold">Termos de Uso</a> e autorizo o tratamento dos meus dados conforme a <strong>LGPD</strong> para fins de cronometragem e seguro atleta.
              <% end %>
            </div>
          </div>
        </div>
      </section>

            <%# Bloco de lista de espera — aparece só quando vagas esgotam %>
      <% if @show_waitlist_option || @distance_sold_out %>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-5 mt-4">
          <div class="flex items-start gap-3">
            <div>
              <h3 class="font-semibold text-amber-800">
                Vagas esgotadas para esta distância
              </h3>
              <p class="mt-1 text-sm text-amber-700">
                Não há vagas disponíveis no momento.
                Você pode entrar na lista de espera e será notificado por e-mail
                assim que uma vaga abrir.
              </p>

              <% unless authenticated? %>
                <p class="mt-2 text-sm text-amber-700">
                  Preencha seus dados normalmente — criaremos sua conta ao confirmar a lista de espera.
                </p>
              <% end %>

              <div class="mt-4 flex items-center gap-3">
                <%# Botão que resubmete o formulário com join_waitlist=true %>
                <%= hidden_field_tag "public_registration_form[join_waitlist]", "0" %>
                <label class="flex items-center gap-2 cursor-pointer">
                  <%= check_box_tag "public_registration_form[join_waitlist]", "1",
                        params.dig(:public_registration_form, :join_waitlist) == "1",
                        class: "h-4 w-4 rounded border-amber-300 text-amber-600 focus:ring-amber-500" %>
                  <span class="text-sm font-medium text-amber-800">
                    Quero entrar na lista de espera
                  </span>
                </label>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <%# Botão de Ação %>
      <div class="flex flex-col items-center gap-4 pt-4">
        <%= f.submit "PRÓXIMA ETAPA: PAGAMENTO", class: "w-full md:w-auto bg-green-600 text-white px-12 py-5 rounded-full font-black text-xl hover:bg-green-700 hover:shadow-2xl transition transform hover:-translate-y-1 shadow-xl cursor-pointer uppercase tracking-widest active:scale-95" %>
        <p class="text-xs text-gray-400 font-bold uppercase tracking-widest">Sua conexão é segura e criptografada</p>
      </div>

    <% end %>
  </div>
</div>