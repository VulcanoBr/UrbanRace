<% content_for :title, "LGPD — Proteção de Dados | Urban Race" %>
<% content_for :description, "Entenda como a Urban Race aplica a Lei Geral de Proteção de Dados e como exercer seus direitos." %>

<%# ── NAVBAR ──────────────────────────────────────────────────────────── %>
<nav class="fixed top-0 left-0 right-0 z-50 bg-green-900/95 backdrop-blur-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <%= link_to root_path, class: "flex items-center group" do %>
      <%= image_tag "logo_urbanrace_3d.png",
            class: "h-16 md:h-20 w-auto transform group-hover:scale-105 transition duration-300",
            alt: "Urban Race" %>
    <% end %>
    <%= link_to root_path,
          class: "flex items-center gap-2 text-[10px] font-black tracking-widest text-white/70 hover:text-white transition" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      VOLTAR À HOME
    <% end %>
  </div>
</nav>

<%# ── HERO ────────────────────────────────────────────────────────────── %>
<section class="bg-green-900 pt-32 pb-16 px-6 relative overflow-hidden">
  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-green-400 rounded-full filter blur-[120px]"></div>
    <div class="absolute bottom-0 left-1/4 w-72 h-72 bg-orange-600 rounded-full filter blur-[100px]"></div>
  </div>
  <div class="relative z-10 max-w-4xl mx-auto text-center">
    <span class="inline-block px-4 py-1.5 rounded-full bg-green-500/15 border border-green-500/30 text-green-400 text-[10px] font-black tracking-[0.2em] mb-6">
      LEI Nº 13.709/2018
    </span>
    <h1 class="text-4xl md:text-6xl font-black text-white tracking-tighter mb-6">
      PROTEÇÃO DE<br>
      <span class=" bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">
        DADOS — LGPD
      </span>
    </h1>
    <p class="text-green-200/70 font-medium max-w-2xl mx-auto">
      A Urban Race está comprometida com a transparência e o respeito à sua privacidade,
      em plena conformidade com a Lei Geral de Proteção de Dados.
    </p>
    <p class="text-green-400/50 text-xs font-bold tracking-widest mt-4">
      Vigência: Lei Federal nº 13.709/2018 · Última revisão: <%= Date.today.strftime("%d/%m/%Y") %>
    </p>
  </div>
</section>

<%# ── CONTEÚDO PRINCIPAL ──────────────────────────────────────────────── %>
<section class="bg-gray-950 py-16 px-6 min-h-screen">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col lg:flex-row gap-12">

      <%# Índice %>
      <aside class="lg:w-64 flex-shrink-0">
        <div class="lg:sticky lg:top-28">
          <p class="text-[10px] font-black text-green-500 tracking-widest uppercase mb-4">Índice</p>
          <nav class="space-y-1">
            <% [
              ["01", "O que é a LGPD",          "o-que-e"],
              ["02", "Base legal",               "base-legal"],
              ["03", "Dados sensíveis",          "dados-sensiveis"],
              ["04", "Seus direitos na LGPD",    "direitos-lgpd"],
              ["05", "Como exercer direitos",    "como-exercer"],
              ["06", "Retenção e exclusão",      "retencao"],
              ["07", "Transferência internacional","transferencia"],
              ["08", "Autoridade nacional",      "anpd"],
              ["09", "Canal do titular",         "canal-titular"],
            ].each do |num, titulo, ancora| %>
              <a href="#<%= ancora %>"
                 class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 transition group">
                <span class="text-[10px] font-black text-green-500/60 group-hover:text-green-400 w-5"><%= num %></span>
                <%= titulo %>
              </a>
            <% end %>
          </nav>

          <div class="mt-8 p-4 rounded-2xl bg-green-500/10 border border-green-500/20">
            <p class="text-[10px] font-black text-green-400 tracking-widest uppercase mb-2">Também veja</p>
            <%= link_to privacidade_path, class: "text-sm font-bold text-white hover:text-green-400 transition flex items-center gap-2" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              Política de Privacidade
            <% end %>
          </div>

          <%# Destaque DPO %>
          <div class="mt-4 p-4 rounded-2xl bg-orange-500/10 border border-orange-500/20">
            <p class="text-[10px] font-black text-orange-400 tracking-widest uppercase mb-2">Encarregado (DPO)</p>
            <p class="text-white font-bold text-sm mb-1">Urban Race — DPO</p>
            <a href="mailto:dpo@urbanrace.com.br" class="text-orange-400 text-xs font-medium hover:text-orange-300 transition">
              dpo@urbanrace.com.br
            </a>
          </div>
        </div>
      </aside>

      <%# Conteúdo %>
      <main class="flex-1 max-w-3xl space-y-12">

        <%# 01 %>
        <div id="o-que-e" class="scroll-mt-28">
          <%= render "public/pages/section_header", numero: "01", titulo: "O que é a LGPD?" %>
          <p class="text-gray-300 leading-relaxed">
            A <strong class="text-white">Lei Geral de Proteção de Dados (LGPD)</strong> — Lei Federal nº 13.709/2018 —
            é a legislação brasileira que regula o tratamento de dados pessoais por pessoas físicas ou jurídicas,
            de direito público ou privado, com o objetivo de proteger os direitos fundamentais de liberdade,
            privacidade e o livre desenvolvimento da personalidade da pessoa natural.
          </p>
          <p class="text-gray-400 leading-relaxed mt-3">
            A lei é inspirada no Regulamento Geral de Proteção de Dados da União Europeia (GDPR) e
            estabelece regras claras sobre coleta, armazenamento, tratamento e compartilhamento de dados pessoais.
          </p>
          <%# Destaque informativo %>
          <div class="mt-5 flex gap-4 p-5 rounded-2xl bg-green-500/10 border border-green-500/20">
            <svg class="w-6 h-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-green-200 text-sm leading-relaxed">
              A Urban Race aplica os princípios da LGPD em todas as etapas da sua jornada conosco:
              do cadastro à publicação de resultados.
            </p>
          </div>
        </div>

        <div class="h-px bg-white/5"></div>

        <%# 02 %>
        <div id="base-legal" class="scroll-mt-28">
          <%= render "public/pages/section_header", numero: "02", titulo: "Base legal para o tratamento" %>
          <p class="text-gray-400 mb-4">
            Conforme o Art. 7º da LGPD, todo tratamento de dados precisa ter uma base legal.
            Na Urban Race, utilizamos as seguintes:
          </p>
          <div class="space-y-3">
            <% [
              ["Consentimento (Art. 7º, I)", "Para o envio de comunicações de marketing e novos eventos. Você pode revogar a qualquer momento.", "orange"],
              ["Execução de contrato (Art. 7º, V)", "Para processar sua inscrição, emitir certificado e publicar resultados — etapas essenciais da prestação do serviço.", "green"],
              ["Cumprimento de obrigação legal (Art. 7º, II)", "Para manutenção de registros fiscais, emissão de notas fiscais e atendimento a autoridades competentes.", "blue"],
              ["Exercício regular de direitos (Art. 7º, VI)", "Para defesa em processos judiciais, administrativos ou arbitrais.", "purple"],
            ].each do |base, descricao, cor| %>
              <div class="p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-<%= cor %>-500/30 transition">
                <p class="text-white font-bold text-sm mb-1"><%= base %></p>
                <p class="text-gray-400 text-sm leading-relaxed"><%= descricao %></p>
              </div>
            <% end %>
          </div>
        </div>

        <div class="h-px bg-white/5"></div>

        <%# 03 %>
        <div id="dados-sensiveis" class="scroll-mt-28">
          <%= render "public/pages/section_header", numero: "03", titulo: "Dados pessoais sensíveis" %>
          <div class="flex gap-4 p-5 rounded-2xl bg-orange-500/10 border border-orange-500/25 mb-5">
            <svg class="w-6 h-6 text-orange-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <p class="text-orange-200 text-sm leading-relaxed">
              O <strong>atestado médico</strong> coletado para participação nos eventos pode conter
              dados de saúde, classificados como dados sensíveis pelo Art. 11 da LGPD.
            </p>
          </div>
          <p class="text-gray-400 leading-relaxed">
            Esses dados recebem proteção especial e são tratados com base no
            <strong class="text-white">consentimento específico e destacado</strong> do titular (Art. 11, I),
            sendo acessados apenas pela equipe médica e organizadora do evento, com finalidade exclusiva
            de garantir a segurança do participante durante a prova.
          </p>
          <p class="text-gray-400 leading-relaxed mt-3">
            Os atestados são <strong class="text-white">excluídos automaticamente</strong> após o encerramento
            do evento e processamento das obrigações legais correspondentes.
          </p>
        </div>

        <div class="h-px bg-white/5"></div>

        <%# 04 %>
        <div id="direitos-lgpd" class="scroll-mt-28">
          <%= render "public/pages/section_header", numero: "04", titulo: "Seus direitos como titular" %>
          <p class="text-gray-400 mb-5">
            O Art. 18 da LGPD garante ao titular os seguintes direitos, que você pode exercer a qualquer momento:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% [
              { icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
                titulo: "Confirmação e Acesso",
                descricao: "Confirmar se tratamos seus dados e acessá-los (Art. 18, I e II)",
                cor: "blue" },
              { icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
                titulo: "Correção",
                descricao: "Corrigir dados incompletos, inexatos ou desatualizados (Art. 18, III)",
                cor: "yellow" },
              { icon: "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16",
                titulo: "Anonimização ou Exclusão",
                descricao: "Eliminar dados desnecessários, excessivos ou tratados sem base legal (Art. 18, IV)",
                cor: "red" },
              { icon: "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
                titulo: "Portabilidade",
                descricao: "Receber seus dados em formato estruturado para outro fornecedor (Art. 18, V)",
                cor: "purple" },
              { icon: "M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z",
                titulo: "Compartilhamento",
                descricao: "Saber com quais entidades compartilhamos seus dados (Art. 18, VII)",
                cor: "green" },
              { icon: "M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636",
                titulo: "Oposição",
                descricao: "Opor-se ao tratamento realizado sem consentimento (Art. 18, II)",
                cor: "orange" },
            ].each do |item| %>
              <div class="flex items-start gap-3 p-4 rounded-xl bg-white/5 border border-white/10 hover:border-green-500/30 transition">
                <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= item[:icon] %>"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white font-bold text-sm"><%= item[:titulo] %></p>
                  <p class="text-gray-500 text-xs mt-0.5 leading-relaxed"><%= item[:descricao] %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="h-px bg-white/5"></div>

        <%# 05 %>
        <div id="como-exercer" class="scroll-mt-28">
          <%= render "public/pages/section_header", numero: "05", titulo: "Como exercer seus direitos" %>
          <p class="text-gray-400 mb-5">
            Para exercer qualquer dos direitos acima, você pode:
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-4 p-5 rounded-2xl bg-white/5 border border-white/10">
              <div class="w-10 h-10 rounded-xl bg-orange-500/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-bold text-sm mb-1">E-mail para o DPO</p>
                <a href="mailto:dpo@urbanrace.com.br" class="text-orange-400 hover:text-orange-300 transition font-medium text-sm">
                  dpo@urbanrace.com.br
                </a>
                <p class="text-gray-500 text-xs mt-1">Prazo de resposta: até 15 dias úteis</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 rounded-2xl bg-white/5 border border-white/10">
              <div class="w-10 h-10 rounded-xl bg-green-500/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-bold text-sm mb-1">Área do atleta</p>
                <p class="text-gray-400 text-sm">Acesse seu perfil para atualizar, corrigir ou solicitar exclusão dos seus dados diretamente pela plataforma.</p>
              </div>
            </div>
          </div>
          <p class="text-gray-600 text-xs mt-4">
            Suas solicitações serão analisadas e respondidas conforme os prazos previstos na LGPD.
            Em caso de reclamação não resolvida, você pode acionar a
            <strong class="text-gray-400">Autoridade Nacional de Proteção de Dados (ANPD)</strong>.
          </p>
        </div>

        <div class="h-px bg-white/5"></div>

        <%# 06 %>
        <div id="retencao" class="scroll-mt-28">
          <%= render "public/pages/section_header", numero: "06", titulo: "Retenção e exclusão de dados" %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-white/10">
                  <th class="text-left py-3 px-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Dado</th>
                  <th class="text-left py-3 px-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Retenção</th>
                  <th class="text-left py-3 px-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Motivo</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                <% [
                  ["Cadastro do atleta",    "Enquanto a conta estiver ativa",  "Execução do serviço"],
                  ["Inscrições e pagamentos","5 anos após o evento",           "Obrigação fiscal (Código Tributário)"],
                  ["Resultados e rankings", "Indefinido (histórico esportivo)", "Legítimo interesse"],
                  ["Atestados médicos",     "Até 6 meses após o evento",       "Finalidade específica encerrada"],
                  ["Dados de navegação",    "12 meses",                         "Análise e melhoria do serviço"],
                  ["Logs de acesso",        "6 meses",                          "Marco Civil da Internet (Lei 12.965/14)"],
                ].each do |dado, retencao, motivo| %>
                  <tr class="hover:bg-white/5 transition">
                    <td class="py-3 px-4 text-white font-medium"><%= dado %></td>
                    <td class="py-3 px-4 text-gray-400"><%= retencao %></td>
                    <td class="py-3 px-4 text-gray-500 text-xs"><%= motivo %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="h-px bg-white/5"></div>

        <%# 07 %>
        <div id="transferencia" class="scroll-mt-28">
          <%= render "public/pages/section_header", numero: "07", titulo: "Transferência internacional" %>
          <p class="text-gray-400 leading-relaxed">
            Alguns de nossos fornecedores de tecnologia (como gateways de pagamento e serviços de e-mail)
            podem processar dados em servidores localizados fora do Brasil.
            Quando isso ocorre, exigimos contratualmente que esses parceiros
            <strong class="text-white">garantam nível de proteção equivalente ao da LGPD</strong>,
            conforme previsto no Art. 33 da Lei.
          </p>
          <div class="mt-4 p-4 rounded-xl bg-white/5 border border-white/10">
            <p class="text-gray-300 text-sm"><strong class="text-white">Fornecedores internacionais utilizados:</strong></p>
            <ul class="mt-2 space-y-1 text-sm text-gray-500">
              <li>· Processamento de pagamentos: Stripe Inc. (EUA — Privacy Shield / SCCs)</li>
              <li>· Envio de e-mails transacionais: SendGrid / Twilio (EUA)</li>
              <li>· Armazenamento em nuvem: Amazon Web Services (servidores Brasil/EUA)</li>
            </ul>
          </div>
        </div>

        <div class="h-px bg-white/5"></div>

        <%# 08 %>
        <div id="anpd" class="scroll-mt-28">
          <%= render "public/pages/section_header", numero: "08", titulo: "Autoridade Nacional de Proteção de Dados" %>
          <p class="text-gray-400 leading-relaxed">
            A <strong class="text-white">ANPD (Autoridade Nacional de Proteção de Dados)</strong>
            é o órgão federal responsável por fiscalizar o cumprimento da LGPD no Brasil.
            Caso você não obtenha resposta satisfatória às suas solicitações, tem o direito de
            apresentar reclamação à ANPD.
          </p>
          <div class="mt-4 flex gap-4 p-5 rounded-2xl bg-white/5 border border-white/10">
            <svg class="w-8 h-8 text-green-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            <div>
              <p class="text-white font-bold text-sm">ANPD — Autoridade Nacional de Proteção de Dados</p>
              <a href="https://www.gov.br/anpd" target="_blank" rel="noopener noreferrer"
                 class="text-green-400 hover:text-green-300 transition text-sm font-medium">
                www.gov.br/anpd
              </a>
              <p class="text-gray-500 text-xs mt-1">Portal de abertura de petições e reclamações</p>
            </div>
          </div>
        </div>

        <div class="h-px bg-white/5"></div>

        <%# 09 %>
        <div id="canal-titular" class="scroll-mt-28">
          <%= render "public/pages/section_header", numero: "09", titulo: "Canal exclusivo do titular" %>
          <div class="bg-gradient-to-br from-green-900/40 to-green-800/20 border border-green-500/30 rounded-2xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-black text-lg">Urban Race — Encarregado de Dados (DPO)</p>
                <p class="text-green-400/70 text-xs">Art. 41 da LGPD — Obrigatório para empresas com tratamento em larga escala</p>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <p class="text-gray-500 text-xs font-bold uppercase tracking-widest mb-1">E-mail (DPO)</p>
                <a href="mailto:dpo@urbanrace.com.br" class="text-green-400 hover:text-green-300 font-bold transition text-sm">
                  dpo@urbanrace.com.br
                </a>
              </div>
              <div>
                <p class="text-gray-500 text-xs font-bold uppercase tracking-widest mb-1">E-mail (Privacidade)</p>
                <a href="mailto:privacidade@urbanrace.com.br" class="text-green-400 hover:text-green-300 font-bold transition text-sm">
                  privacidade@urbanrace.com.br
                </a>
              </div>
              <div>
                <p class="text-gray-500 text-xs font-bold uppercase tracking-widest mb-1">Prazo de resposta</p>
                <p class="text-white text-sm font-bold">Até 15 dias úteis</p>
              </div>
              <div>
