<% content_for :title, "Política de Privacidade | Urban Race" %>
<% content_for :description, "Saiba como a Urban Race coleta, usa e protege seus dados pessoais." %>

<%# ── NAVBAR MINIMALISTA ───────────────────────────────────────────────── %>
<nav class="fixed top-0 left-0 right-0 z-50 bg-green-900/95 backdrop-blur-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <%= link_to root_path, class: "flex items-center group" do %>
      <%= image_tag "logo_urbanrace_3d.png",
            class: "h-16 md:h-20 w-auto transform group-hover:scale-105 transition duration-300",
            alt: "Urban Race" %>
    <% end %>
    <%= link_to root_path,
          class: "flex items-center gap-2 text-[10px] font-black tracking-widest text-white/70 hover:text-white transition" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      VOLTAR À HOME
    <% end %>
  </div>
</nav>

<%# ── HERO DA PÁGINA ──────────────────────────────────────────────────── %>
<section class="bg-green-900 pt-32 pb-16 px-6 relative overflow-hidden">
  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-green-500 rounded-full filter blur-[120px]"></div>
    <div class="absolute bottom-0 right-1/4 w-72 h-72 bg-orange-500 rounded-full filter blur-[100px]"></div>
  </div>
  <div class="relative z-10 max-w-4xl mx-auto text-center">
    <span class="inline-block px-4 py-1.5 rounded-full bg-orange-500/15 border border-orange-500/30 text-orange-400 text-[10px] font-black tracking-[0.2em] mb-6">
      DOCUMENTO LEGAL
    </span>
    <h1 class="text-4xl md:text-6xl font-black text-white tracking-tighter mb-6">
      POLÍTICA DE<br>
      <span class=" bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">
        PRIVACIDADE
      </span>
    </h1>
    <p class="text-green-200/70 font-medium max-w-xl mx-auto">
      Última atualização: <%= Date.today.strftime("%d de %B de %Y") %>
    </p>
  </div>
</section>

<%# ── ÍNDICE LATERAL + CONTEÚDO ───────────────────────────────────────── %>
<section class="bg-gray-950 py-16 px-6 min-h-screen">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col lg:flex-row gap-12">

      <%# Índice fixo (desktop) %>
      <aside class="lg:w-64 flex-shrink-0">
        <div class="lg:sticky lg:top-28">
          <p class="text-[10px] font-black text-orange-500 tracking-widest uppercase mb-4">Navegação</p>
          <nav class="space-y-1">
            <% [
              ["01", "Quem somos",            "quem-somos"],
              ["02", "Dados que coletamos",   "dados-coletados"],
              ["03", "Como usamos",           "como-usamos"],
              ["04", "Compartilhamento",      "compartilhamento"],
              ["05", "Seus direitos",         "seus-direitos"],
              ["06", "Cookies",               "cookies"],
              ["07", "Segurança",             "seguranca"],
              ["08", "Contato",               "contato"],
            ].each do |num, titulo, ancora| %>
              <a href="#<%= ancora %>"
                 class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 transition group">
                <span class="text-[10px] font-black text-orange-500/60 group-hover:text-orange-400 w-5"><%= num %></span>
                <%= titulo %>
              </a>
            <% end %>
          </nav>

          <div class="mt-8 p-4 rounded-2xl bg-orange-500/10 border border-orange-500/20">
            <p class="text-[10px] font-black text-orange-400 tracking-widest uppercase mb-2">Também veja</p>
            <%= link_to lgpd_path, class: "text-sm font-bold text-white hover:text-orange-400 transition flex items-center gap-2" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              Lei Geral de Proteção de Dados (LGPD)
            <% end %>
          </div>
        </div>
      </aside>

      <%# Conteúdo principal %>
      <main class="flex-1 max-w-3xl">
        <div class="prose prose-invert prose-lg max-w-none space-y-12">

          <%# Seção 01 %>
          <div id="quem-somos" class="scroll-mt-28">
            <%= render "public/pages/section_header", numero: "01", titulo: "Quem somos" %>
            <div class="prose-content">
              <p class="text-gray-300 leading-relaxed">
                A <strong class="text-white">Urban Race</strong> é uma plataforma especializada na organização,
                promoção e gestão de corridas de rua. Ao utilizar nossos serviços — seja se inscrevendo em
                um evento, acessando resultados ou interagindo com nosso site — você confia seus dados a nós.
                Este documento explica quais dados coletamos, por que os coletamos e como protegemos sua privacidade.
              </p>
              <p class="text-gray-400 leading-relaxed mt-3">
                Controlador responsável: <strong class="text-white">Urban Race Eventos Ltda.</strong><br>
                CNPJ: XX.XXX.XXX/XXXX-XX<br>
                Rio de Janeiro — Brasil
              </p>
            </div>
          </div>

          <div class="h-px bg-white/5"></div>

          <%# Seção 02 %>
          <div id="dados-coletados" class="scroll-mt-28">
            <%= render "public/pages/section_header", numero: "02", titulo: "Dados que coletamos" %>
            <div class="space-y-4">
              <% [
                ["Dados de identificação", "Nome completo, CPF, data de nascimento, sexo, fotografia de perfil (quando fornecida)."],
                ["Dados de contato", "E-mail, telefone e WhatsApp informados no cadastro."],
                ["Dados de saúde", "Atestado médico exigido para participação nos eventos, armazenado de forma segura e acessível apenas pela equipe organizadora."],
                ["Dados de pagamento", "Informações de cartão de crédito processadas diretamente pelo gateway de pagamento (não armazenamos dados de cartão em nossos servidores). Registros de transações Pix para comprovação."],
                ["Dados de desempenho", "Tempo de conclusão, posição no ranking, splits de cronometragem e histórico de participações."],
                ["Dados de navegação", "Endereço IP, tipo de navegador, páginas visitadas e tempo de acesso, coletados por cookies analíticos."],
              ].each do |titulo, descricao| %>
                <div class="flex gap-4 p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-orange-500/30 transition">
                  <div class="w-2 h-2 rounded-full bg-orange-500 flex-shrink-0 mt-2"></div>
                  <div>
                    <p class="text-white font-bold text-sm mb-1"><%= titulo %></p>
                    <p class="text-gray-400 text-sm leading-relaxed"><%= descricao %></p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <div class="h-px bg-white/5"></div>

          <%# Seção 03 %>
          <div id="como-usamos" class="scroll-mt-28">
            <%= render "public/pages/section_header", numero: "03", titulo: "Como usamos seus dados" %>
            <p class="text-gray-400 mb-4 leading-relaxed">Utilizamos seus dados pessoais para as seguintes finalidades:</p>
            <ul class="space-y-3">
              <% [
                "Processar e confirmar sua inscrição nos eventos",
                "Emitir certificados digitais de participação",
                "Publicar resultados e rankings das provas",
                "Enviar comunicações sobre o evento: lembretes, localização, cronograma",
                "Notificar sobre abertura de novas edições e eventos relacionados (com opção de cancelamento)",
                "Cumprir obrigações legais e regulatórias (LGPD, Código do Consumidor)",
                "Melhorar nossos serviços com base em dados analíticos agregados e anonimizados",
              ].each do |item| %>
                <li class="flex items-start gap-3 text-gray-300 text-sm">
                  <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <%= item %>
                </li>
              <% end %>
            </ul>
          </div>

          <div class="h-px bg-white/5"></div>

          <%# Seção 04 %>
          <div id="compartilhamento" class="scroll-mt-28">
            <%= render "public/pages/section_header", numero: "04", titulo: "Compartilhamento de dados" %>
            <p class="text-gray-400 mb-4 leading-relaxed">
              Não vendemos seus dados. Podemos compartilhá-los <strong class="text-white">apenas nas seguintes situações:</strong>
            </p>
            <div class="space-y-3">
              <% [
                ["Parceiros operacionais", "Empresas de cronometragem eletrônica e fotografia esportiva, exclusivamente para viabilizar a realização dos eventos."],
                ["Processadores de pagamento", "Gateways de pagamento (Stripe, Mercado Pago) para processar transações de forma segura."],
                ["Exigência legal", "Autoridades competentes quando exigido por lei, decisão judicial ou para proteção dos nossos direitos."],
              ].each do |titulo, descricao| %>
                <div class="p-5 rounded-2xl bg-white/5 border border-white/10">
                  <p class="text-white font-bold text-sm mb-1"><%= titulo %></p>
                  <p class="text-gray-400 text-sm leading-relaxed"><%= descricao %></p>
                </div>
              <% end %>
            </div>
          </div>

          <div class="h-px bg-white/5"></div>

          <%# Seção 05 %>
          <div id="seus-direitos" class="scroll-mt-28">
            <%= render "public/pages/section_header", numero: "05", titulo: "Seus direitos" %>
            <p class="text-gray-400 mb-4 leading-relaxed">
              Em conformidade com a LGPD (Lei nº 13.709/2018), você tem os seguintes direitos:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% [
                ["Acesso", "Solicitar confirmação e acesso aos seus dados"],
                ["Correção", "Corrigir dados incompletos, inexatos ou desatualizados"],
                ["Exclusão", "Solicitar a exclusão dos seus dados pessoais"],
                ["Portabilidade", "Receber seus dados em formato estruturado"],
                ["Oposição", "Opor-se ao tratamento realizado com base no legítimo interesse"],
                ["Revogação", "Revogar o consentimento a qualquer momento"],
              ].each do |titulo, descricao| %>
                <div class="flex items-start gap-3 p-4 rounded-xl bg-green-500/5 border border-green-500/20">
                  <div class="w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-white font-bold text-sm"><%= titulo %></p>
                    <p class="text-gray-400 text-xs mt-0.5"><%= descricao %></p>
                  </div>
                </div>
              <% end %>
            </div>
            <p class="text-gray-500 text-sm mt-4">
              Para exercer seus direitos, entre em contato pelo e-mail:
              <a href="mailto:privacidade@urbanrace.com.br" class="text-orange-400 hover:text-orange-300 font-bold transition">
                privacidade@urbanrace.com.br
              </a>
            </p>
          </div>

          <div class="h-px bg-white/5"></div>

          <%# Seção 06 %>
          <div id="cookies" class="scroll-mt-28">
            <%= render "public/pages/section_header", numero: "06", titulo: "Cookies" %>
            <p class="text-gray-400 leading-relaxed mb-4">
              Utilizamos cookies para melhorar sua experiência de navegação. Você pode configurar seu
              navegador para recusar cookies, mas isso pode afetar o funcionamento de algumas funcionalidades.
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-sm border-collapse">
                <thead>
                  <tr class="border-b border-white/10">
                    <th class="text-left py-3 px-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Tipo</th>
                    <th class="text-left py-3 px-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Finalidade</th>
                    <th class="text-left py-3 px-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Duração</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  <% [
                    ["Sessão", "Manter você autenticado durante a navegação", "Sessão"],
                    ["Analíticos", "Entender como os usuários interagem com o site", "12 meses"],
                    ["Preferências", "Lembrar suas configurações (tema, idioma)", "6 meses"],
                  ].each do |tipo, finalidade, duracao| %>
                    <tr class="hover:bg-white/5 transition">
                      <td class="py-3 px-4 text-white font-medium"><%= tipo %></td>
                      <td class="py-3 px-4 text-gray-400"><%= finalidade %></td>
                      <td class="py-3 px-4 text-gray-500"><%= duracao %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="h-px bg-white/5"></div>

          <%# Seção 07 %>
          <div id="seguranca" class="scroll-mt-28">
            <%= render "public/pages/section_header", numero: "07", titulo: "Segurança dos dados" %>
            <p class="text-gray-400 leading-relaxed">
              Adotamos medidas técnicas e organizacionais adequadas para proteger seus dados contra acesso
              não autorizado, alteração, divulgação ou destruição. Isso inclui:
            </p>
            <ul class="mt-4 space-y-2">
              <% [
                "Criptografia TLS/HTTPS em todas as comunicações",
                "Senhas armazenadas com hash bcrypt",
                "Acesso restrito a dados pessoais por princípio de menor privilégio",
                "Backups regulares com retenção segura",
                "Monitoramento contínuo de acessos suspeitos",
              ].each do |item| %>
                <li class="flex items-center gap-3 text-gray-300 text-sm">
                  <svg class="w-4 h-4 text-orange-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <%= item %>
                </li>
              <% end %>
            </ul>
          </div>

          <div class="h-px bg-white/5"></div>

          <%# Seção 08 %>
          <div id="contato" class="scroll-mt-28">
            <%= render "public/pages/section_header", numero: "08", titulo: "Contato e DPO" %>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
              <p class="text-gray-300 mb-4 leading-relaxed">
                Caso tenha dúvidas sobre esta Política de Privacidade ou queira exercer seus direitos,
                entre em contato com nosso Encarregado de Dados (DPO):
              </p>
              <div class="space-y-2">
                <p class="text-white font-bold">Data Protection Officer — Urban Race</p>
                <a href="mailto:privacidade@urbanrace.com.br" class="flex items-center gap-2 text-orange-400 hover:text-orange-300 transition font-medium text-sm">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  privacidade@urbanrace.com.br
                </a>
                <p class="text-gray-500 text-sm">Prazo de resposta: até 15 dias úteis</p>
              </div>
            </div>
          </div>

        </div>

        <%# Botão voltar ao topo %>
        <div class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-gray-600 text-xs">
            Este documento está em conformidade com a Lei nº 13.709/2018 (LGPD).
          </p>
          <a href="#" class="flex items-center gap-2 text-[10px] font-black text-gray-400 hover:text-white transition tracking-widest uppercase">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
            </svg>
            Voltar ao topo
          </a>
        </div>
      </main>

    </div>
  </div>
</section>

<%# ── FOOTER SIMPLES ─────────────────────────────────────────────────── %>
<footer class="bg-green-900 py-8 px-6 border-t border-white/10">
  <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <%= link_to root_path do %>
      <%= image_tag "logo_urbanrace_3d.png", class: "h-16 w-auto ", alt: "Urban Race" %>
    <% end %>
    <div class="flex items-center gap-6 text-[10px] font-black tracking-widest text-white/40 uppercase">
      <%= link_to "Home", root_path, class: "hover:text-white transition" %>
      <span>·</span>
      <%= link_to "LGPD", lgpd_path, class: "hover:text-white transition" %>
      <span>·</span>
      <span class="text-orange-500">© <%= Date.today.year %> Urban Race</span>
    </div>
  </div>
</footer>