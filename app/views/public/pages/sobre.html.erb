<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" data-controller="scroll-nav">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <%= link_to root_path, class: "flex items-center group" do %>
      <%# Ajuste de tamanho do Logo: h-16 no mobile e h-24 em telas maiores %>
      <%= image_tag "logo_urbanrace_3d.png", class: "h-16 md:h-24 w-full transform group-hover:scale-105 transition duration-300", alt: "Urban Race" %>
    <% end %>

    <div class="flex items-center gap-4">
      <%= link_to "MINHAS INSCRIÇÕES", athletes_dashboard_path, class: "hidden sm:block text-[10px] font-black tracking-widest text-white/80 hover:text-white transition" %>
      <%= link_to "LOGIN", new_session_path, class: "text-xs font-bold tracking-widest text-white border border-white/30 bg-white/10 backdrop-blur-md px-6 py-2.5 rounded-full hover:bg-orange-500 hover:border-orange-500 transition-all duration-300 shadow-lg" %>
    </div>
  </div>
</nav>

<%# ── Hero compacto ───────────────────────────────────────────────────── %>
<section class="relative min-h-[55vh] flex flex-col items-center justify-center bg-green-800 pt-28 pb-20 overflow-hidden">

  <%# Ornamentos de fundo %>
 

  <div class="pt-4 relative z-10 max-w-4xl mx-auto px-6 text-center">
    <%# Badge %>
    <span class="inline-block px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/30 text-orange-400 text-[10px] font-black tracking-[0.2em] mb-6">
      QUEM SOMOS
    </span>

    <%# Logo centralizada %>
    <div class="flex justify-center mb-8">
      <%= image_tag "logo_urbanrace_3d.png",
            class: "h-28 md:h-36 w-auto drop-shadow-2xl",
            alt: "Urban Race Logo" %>
    </div>

    <H1 h1 class="text-5xl md:text-7xl font-black text-white tracking-tighter leading-[0.9] mb-6 uppercase">
       SOBRE A 
        <span class="italic  bg-clip-text text-orange-500 ">
        URBAN RACE
      </span>
    </H1>
    <p class="text-base md:text-lg text-green-100/70 max-w-2xl mx-auto font-medium leading-relaxed">
      Organizando experiências inesquecíveis no asfalto desde 2024.
    </p>
  </div>
</section>

<%# ── Missão, Visão e Valores ─────────────────────────────────────────── %>
<section class="bg-orange-500 py-20 px-6">
  <div class="max-w-7xl mx-auto">

    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tighter italic mb-4">NOSSA ESSÊNCIA</h2>
      <div class="h-1.5 w-24 bg-green-800 rounded-full mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <%# Missão %>
      <div class="bg-white rounded-[28px] p-8 shadow-[0_10px_40px_rgba(0,0,0,0.06)] hover:shadow-[0_30px_60px_rgba(0,0,0,0.12)] transition-all duration-500 hover:-translate-y-2 group">
        <div class="w-14 h-14 flex items-center justify-center rounded-2xl bg-green-800 mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="text-xl font-black text-gray-900 tracking-tight mb-3">MISSÃO</h3>
        <p class="text-gray-500 text-sm leading-relaxed font-medium">
          Democratizar o acesso ao esporte de rua, conectando atletas de todos os níveis a eventos de alta qualidade, com tecnologia, segurança e uma experiência memorável do início ao fim.
        </p>
      </div>

      <%# Visão %>
      <div class="bg-green-800 rounded-[28px] p-8 shadow-[0_10px_40px_rgba(0,0,0,0.10)] hover:shadow-[0_30px_60px_rgba(0,0,0,0.18)] transition-all duration-500 hover:-translate-y-2 group">
        <div class="w-14 h-14 flex items-center justify-center rounded-2xl bg-orange-500 mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
        </div>
        <h3 class="text-xl font-black text-white tracking-tight mb-3">VISÃO</h3>
        <p class="text-green-100/70 text-sm leading-relaxed font-medium">
          Ser a maior plataforma de corridas de rua do Brasil até 2030, reconhecida pela excelência operacional, inovação tecnológica e pelo impacto positivo na saúde e qualidade de vida dos brasileiros.
        </p>
      </div>

      <%# Valores %>
      <div class="bg-white rounded-[28px] p-8 shadow-[0_10px_40px_rgba(0,0,0,0.06)] hover:shadow-[0_30px_60px_rgba(0,0,0,0.12)] transition-all duration-500 hover:-translate-y-2 group">
        <div class="w-14 h-14 flex items-center justify-center rounded-2xl bg-green-800 mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </div>
        <h3 class="text-xl font-black text-gray-900 tracking-tight mb-3">VALORES</h3>
        <ul class="space-y-2 text-sm text-gray-500 font-medium">
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 flex-shrink-0"></span>
            Superação e alta performance
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 flex-shrink-0"></span>
            Inclusão e comunidade
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 flex-shrink-0"></span>
            Transparência e segurança
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 flex-shrink-0"></span>
            Inovação contínua
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 flex-shrink-0"></span>
            Respeito ao atleta
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

<%# ── Nossa história ──────────────────────────────────────────────────── %>
<section class="bg-gray-950 py-24 px-6 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-1/2 h-full bg-orange-600/5 skew-x-12 translate-x-20 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <%# Texto %>
      <div>
        <span class="text-[10px] font-black tracking-[0.2em] text-orange-500 uppercase mb-4 block">Nossa História</span>
        <h2 class="text-4xl md:text-5xl font-black text-white tracking-tighter italic mb-8 leading-[0.95]">
          NASCEMOS PARA QUEM<br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">NÃO PARA.</span>
        </h2>
        <div class="space-y-5 text-gray-400 text-sm leading-relaxed font-medium">
          <p>
            A Urban Race nasceu em 2024 da paixão de um grupo de atletas e profissionais de tecnologia que sentiram na pele as dificuldades de organizar e participar de corridas de rua com qualidade real.
          </p>
          <p>
            Percebemos que o mercado carecia de uma plataforma que tratasse o atleta com o respeito que ele merece — da inscrição até o certificado digital. Assim surgiu o Urban Race: uma solução completa de gestão que coloca a experiência do corredor no centro de tudo.
          </p>
          <p>
            Hoje organizamos eventos em todo o Brasil, combinando tecnologia de ponta, atendimento humanizado e a energia única que só o asfalto proporciona.
          </p>
        </div>
      </div>

      <%# Números %>
      <div class="grid grid-cols-2 gap-6">

        <% [
          ["50k+",  "Atletas ativos", "text-orange-400"],
          ["120",   "Provas anuais",  "text-green-400"],
          ["100%",  "Pix seguro",     "text-blue-400"],
          ["2024",  "Fundação",       "text-white"],
        ].each do |num, label, cor| %>
          <div class="bg-white/5 border border-white/10 rounded-[24px] p-8 flex flex-col justify-between hover:bg-white/10 transition-all group">
            <p class="text-4xl md:text-5xl font-black <%= cor %> leading-none mb-3 group-hover:scale-105 transition-transform origin-left">
              <%= num %>
            </p>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest"><%= label %></p>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</section>

<%# ── Time / Diferenciais ─────────────────────────────────────────────── %>
<section class="bg-white py-24 px-6">
  <div class="max-w-7xl mx-auto">

    <div class="text-center mb-16">
      <span class="text-[10px] font-black tracking-[0.2em] text-orange-500 uppercase mb-3 block">Por que a Urban Race</span>
      <h2 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tighter italic">NOSSOS DIFERENCIAIS</h2>
      <div class="h-1.5 w-24 bg-green-800 rounded-full mx-auto mt-4"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

      <% [
        {
          icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
          title: "Segurança Total",
          desc:  "Pagamentos com certificação PCI DSS. Seus dados e dinheiro protegidos em todas as etapas.",
          bg:    "bg-green-800",
          cor:   "text-orange-400"
        },
        {
          icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
          title: "Check-in Rápido",
          desc:  "QR Code exclusivo por atleta. Sem filas, sem papel, sem estresse no dia do evento.",
          bg:    "bg-orange-500",
          cor:   "text-white"
        },
        {
          icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>',
          title: "Fotos por IA",
          desc:  "Reconhecimento automático do seu dorsal nas fotos. Encontre e baixe suas imagens sem esforço.",
          bg:    "bg-green-800",
          cor:   "text-orange-400"
        },
        {
          icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>',
          title: "Resultados Online",
          desc:  "Classificação em tempo real com certificado digital gerado automaticamente após a conclusão.",
          bg:    "bg-orange-500",
          cor:   "text-white"
        },
      ].each do |item| %>
        <div class="group bg-gray-50 border border-gray-100 rounded-[28px] p-8 hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl <%= item[:bg] %> mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 <%= item[:cor] %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <%= item[:icon].html_safe %>
            </svg>
          </div>
          <h3 class="text-base font-black text-gray-900 tracking-tight mb-2"><%= item[:title] %></h3>
          <p class="text-gray-400 text-sm leading-relaxed font-medium"><%= item[:desc] %></p>
        </div>
      <% end %>

    </div>
  </div>
</section>

<%# ── CTA + Link voltar ───────────────────────────────────────────────── %>
<section class="bg-green-800 py-24 px-6 relative overflow-hidden">
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <div class="absolute -bottom-20 -left-20 w-96 h-96 bg-green-500 rounded-full mix-blend-screen filter blur-[120px]"></div>
    <div class="absolute -top-20 -right-20 w-80 h-80 bg-orange-600 rounded-full mix-blend-screen filter blur-[100px]"></div>
  </div>

  <div class="relative z-10 max-w-3xl mx-auto text-center">
    <h2 class="text-4xl md:text-6xl font-black text-white tracking-tighter leading-[0.9] mb-6">
      PRONTO PARA SUA<br>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">PRÓXIMA CORRIDA?</span>
    </h2>
    <p class="text-green-100/70 text-base md:text-lg font-medium mb-12 leading-relaxed">
      Explore o calendário, escolha seu desafio e inscreva-se em minutos.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
      <%# CTA principal %>
      <%= link_to root_path,
            class: "group relative bg-orange-500 text-white px-10 py-5 rounded-2xl font-black text-sm tracking-widest hover:bg-orange-600 transition shadow-xl transform hover:-translate-y-1 flex items-center gap-3" do %>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        VOLTAR À HOME
      <% end %>

      <%# Link secundário %>
      <%= link_to athletes_dashboard_path,
            class: "group text-white font-bold text-sm tracking-widest flex items-center gap-3 hover:text-orange-400 transition" do %>
        <span class="w-12 h-12 flex items-center justify-center rounded-full bg-white/5 border border-white/10 group-hover:bg-white/10 transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </span>
        MINHAS INSCRIÇÕES
      <% end %>
    </div>
  </div>
</section>

<%# ── Footer (igual à home) ──────────────────────────────────────────── %>
<footer class="bg-green-800 pt-24 pb-12 px-6 border-t border-white/10">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-12 border-b border-white/10 pb-16 mb-12">

    <div class="text-center md:text-left max-w-xs order-2 md:order-1">
      <p class="text-sm text-white/70 leading-relaxed">
        Organizando experiências inesquecíveis no asfalto desde 2024.
      </p>
    </div>

    <div class="order-1 md:order-2 flex justify-center">
      <%= link_to root_path do %>
        <%= image_tag "logo_urbanrace_3d.png",
              class: "h-20 md:h-24 w-auto opacity-90 grayscale hover:opacity-100 hover:grayscale-0 transition duration-300 transform hover:scale-105",
              alt: "Urban Race Logo" %>
      <% end %>
    </div>

    <div class="flex gap-16 order-3">
      <div class="flex flex-col gap-4">
        <p class="text-[10px] font-black text-white uppercase tracking-widest">Institucional</p>
        <%= link_to "Sobre Nós",  sobre_path, class: "text-sm font-bold text-orange-400 transition" %>
        <%= link_to "Contato", contato_path, class:"text-sm font-bold text-white hover:text-orange-400 transition" %>
      </div>
      <div class="flex flex-col gap-4">
        <p class="text-[10px] font-black text-white uppercase tracking-widest">Legal</p>
        <%= link_to "Privacidade", privacidade_path, class: "text-sm font-bold text-white hover:text-orange-300 transition" %>
        <%= link_to "LGPD",        lgpd_path,        class: "text-sm font-bold text-white hover:text-orange-300 transition" %>
      </div>
    </div>

  </div>

  <p class="text-center text-[10px] font-bold text-white/30 tracking-[0.4em] uppercase">
    © 2024 URBANRACE - High Performance System
  </p>
</footer>
