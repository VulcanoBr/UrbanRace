<div class="min-h-screen bg-gray-50 flex flex-col items-center justify-center px-4">
  <div class="max-w-md w-full bg-white rounded-3xl shadow-2xl p-8 text-center border border-gray-100 animate-in fade-in zoom-in duration-500">
    
    <!-- Ícone de Sucesso -->
    <div class="w-20 h-20 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <h1 class="text-3xl font-black text-gray-900 mb-2 uppercase tracking-tighter">Inscrição Confirmada!</h1>
    <p class="text-gray-500 mb-8 font-medium">Seu pagamento foi aprovado e sua vaga na largada está garantida.</p>

    <!-- Card de Resumo Rápido -->
    <div class="bg-blue-50 rounded-2xl p-6 mb-8 border border-blue-100 text-left">
      <div class="flex justify-between items-center mb-2">
        <span class="text-xs font-bold text-blue-400 uppercase">Seu Número (Dorsal)</span>
        <span class="text-2xl font-black text-blue-700">#<%= @registration.numero_dorsal %></span>
      </div>
      <p class="text-sm font-bold text-blue-800"><%= @registration.event.nome %></p>
      <p class="text-xs text-blue-600"><%= @registration.category.nome %></p>
    </div>

    <div class="mt-2 p-4 mb-4 bg-gray-50 rounded-xl border border-dashed border-gray-300">
      <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Dados de Acesso à sua Área</p>
      <div class="flex items-center gap-3">
        <div class="bg-white p-2 rounded-lg shadow-sm">
          <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
        </div>
        <div class="text-left">
          <p class="text-sm font-bold text-gray-700">Login: <%= @registration.athlete.email_address %></p>
          <p class="text-xs text-gray-500">Sua conta foi criada. Use seu e-mail para entrar futuramente.</p>
        </div>
      </div>
    </div>


    <div class="space-y-4">
      <%= link_to "ACESSAR ÁREA DO CORREDOR", athletes_area_do_corredor_path, 
          class: "block w-full bg-blue-600 text-white py-4 rounded-2xl font-black text-sm shadow-xl shadow-blue-200 hover:bg-blue-700 transition transform active:scale-95" %>
      
      <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest leading-tight">
        Enviamos um e-mail com seu comprovante<br>e QR Code para a retirada do kit.
      </p>
    </div>
  </div>

  <%= link_to "Voltar para Home", root_path, class: "mt-8 text-gray-400 font-bold text-sm hover:text-gray-600" %>
</div>