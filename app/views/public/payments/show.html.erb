
<div class="min-h-screen bg-gray-50 py-10 px-4">
  <div class="max-w-lg mx-auto space-y-5">

    <%# ── Cabeçalho do pedido ────────────────────────────────────────── %>
    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-4 flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </div>
      <div>
        <p class="font-bold text-blue-900 text-sm"><%= @registration.event.nome %></p>
        <p class="text-blue-600 text-xs">
          Atleta: <%= @registration.athlete.nome %> ·
          <%= @registration.distance.nome %> · Lote <%= @registration.lot.numero %>
        </p>
      </div>
    </div>

    <%# ── Banner de SIMULAÇÃO (apenas fora de produção) ─────────────── %>
    <% unless Rails.env.production? %>
      <div class="bg-amber-50 border-2 border-dashed border-amber-400 rounded-2xl p-5">
        <div class="flex items-start gap-3">
          <div class="text-2xl flex-shrink-0">🧪</div>
          <div class="flex-1">
            <p class="font-black text-amber-800 text-sm uppercase tracking-wide mb-1">
              Modo de desenvolvimento — Simulação de Pagamento
            </p>
            <p class="text-amber-700 text-xs leading-relaxed mb-4">
              O Stripe não está configurado neste ambiente. Use o botão abaixo para
              simular um pagamento PIX aprovado. O sistema irá gravar um JSON em
              <code class="bg-amber-100 px-1 rounded font-mono">tmp/fake_payments/</code>
              e confirmar a inscrição automaticamente via job.
            </p>
            <%= button_to "✅ Simular pagamento aprovado",
                  simulate_registration_payment_path(@registration),
                  method: :post,
                  class: "w-full bg-amber-500 hover:bg-amber-600 text-white font-black
                          text-sm py-3 px-4 rounded-xl transition active:scale-95 shadow-sm
                          shadow-amber-200 cursor-pointer" %>
          </div>
        </div>
      </div>
    <% end %>

    <%# ── Timer de expiração ─────────────────────────────────────────── %>
    <div class="bg-white border border-gray-200 rounded-2xl p-4"
         data-controller="payment-timer"
         data-payment-timer-expires-at-value="<%= 30.minutes.from_now.to_i %>">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm text-gray-500 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Pix expira em
        </span>
        <span class="font-bold text-amber-600 tabular-nums text-base"
              data-payment-timer-target="display">29:59</span>
      </div>
      <div class="h-1.5 bg-gray-200 rounded-full overflow-hidden">
        <div class="h-full bg-amber-400 rounded-full transition-all duration-1000"
             data-payment-timer-target="bar" style="width: 100%"></div>
      </div>
      <p class="text-xs text-gray-400 mt-2">
        Sua vaga está reservada até o timer zerar. Não feche esta aba enquanto paga.
      </p>
    </div>

    <%# ── Resumo do pedido ───────────────────────────────────────────── %>
    <div class="bg-white border border-gray-200 rounded-2xl p-4 space-y-2">
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Inscrição <%= @registration.distance.nome %></span>
        <span class="font-medium text-gray-800">
          <%= number_to_currency(@registration.lot.preco) %>
        </span>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Taxa de processamento</span>
        <span class="font-medium text-gray-800">R$ 0,00</span>
      </div>
      <div class="flex justify-between pt-2 border-t border-gray-100">
        <span class="font-semibold text-gray-800">Total</span>
        <span class="font-bold text-blue-600 text-base">
          <%= number_to_currency(@registration.lot.preco) %>
        </span>
      </div>
    </div>

    <%# ── Passos numerados ───────────────────────────────────────────── %>
    <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
      <div class="px-5 py-3.5 border-b border-gray-100">
        <p class="text-sm font-semibold text-gray-600">Como pagar com Pix</p>
      </div>
      <% [
        ['Abra o app do seu banco', 'Qualquer banco com Pix: Nubank, Inter, Bradesco, Itaú, Caixa…'],
        ['Escolha "Pix" → "Pagar"', 'Escaneie o QR Code com a câmera do celular, ou cole o código Pix manualmente'],
        ['Confirme no app do banco', 'Esta página atualiza sozinha assim que o banco confirmar — não feche a aba!']
      ].each_with_index do |(titulo, descricao), i| %>
        <div class="flex items-start gap-3 px-5 py-4 border-b border-gray-100 last:border-0">
          <div class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold
                      flex items-center justify-center flex-shrink-0 mt-0.5">
            <%= i + 1 %>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-800"><%= titulo %></p>
            <p class="text-xs text-gray-500 mt-0.5"><%= descricao %></p>
          </div>
        </div>
      <% end %>
    </div>

    <%# ── QR Code + copia e cola ─────────────────────────────────────── %>
    <div class="bg-white border border-gray-200 rounded-2xl p-5 flex flex-col items-center gap-4"
         data-controller="payment-polling"
         data-payment-polling-id-value="<%= @registration.id %>"
         data-payment-polling-success-url-value="<%= success_registration_payment_path(@registration) %>">

      <% if @stripe_data&.dig(:qr_code_base64).present? %>
        <img src="<%= @stripe_data[:qr_code_base64] %>"
             alt="QR Code Pix para pagamento"
             class="w-44 h-44 border border-gray-100 rounded-xl p-2 shadow-sm">
      <% else %>
        <div class="w-44 h-44 border-2 border-dashed border-gray-300 rounded-xl
                    flex items-center justify-center bg-gray-50">
          <p class="text-xs text-gray-400 text-center px-3">QR Code Pix<br>sendo gerado…</p>
        </div>
      <% end %>

      <p class="text-sm text-gray-500">
        Escaneie com o app do banco ou copie o código abaixo
      </p>

      <div class="w-full flex gap-2" data-controller="clipboard">
        <input type="text" readonly
               value="<%= @stripe_data&.dig(:qr_code_copy_paste) %>"
               data-clipboard-target="source"
               class="flex-1 bg-gray-50 border border-gray-200 rounded-xl
                      px-3 py-2 text-xs font-mono text-gray-500 truncate">
        <button data-action="clipboard#copy"
                data-clipboard-target="button"
                class="flex-shrink-0 flex items-center gap-1.5 bg-blue-600 text-white
                       text-sm font-semibold px-4 py-2 rounded-xl hover:bg-blue-700
                       transition active:scale-95">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          Copiar
        </button>
      </div>

      <div class="flex items-center gap-2 text-sm text-gray-400">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        Aguardando confirmação do banco…
      </div>
    </div>

    <%# ── Pagar depois ────────────────────────────────────────────────── %>
    <div class="flex items-center gap-3">
      <div class="flex-1 h-px bg-gray-200"></div>
      <span class="text-xs text-gray-400">ou</span>
      <div class="flex-1 h-px bg-gray-200"></div>
    </div>

    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5">
      <p class="text-sm font-semibold text-gray-800 mb-1">Prefere pagar depois?</p>
      <p class="text-xs text-gray-500 mb-4 leading-relaxed">
        Sua vaga fica reservada por <strong>30 minutos</strong>.
        Depois disso o QR Code expira e a vaga pode ser liberada.
        Você pode retomar o pagamento pela <strong>sua área do corredor</strong>.
      </p>
      <%= link_to athletes_area_do_corredor_path,
            class: "inline-flex items-center gap-1.5 text-sm font-semibold
                    text-blue-600 hover:text-blue-700 transition" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        Ir para minha área e pagar mais tarde
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>
    </div>

    <div class="flex items-center justify-center gap-2 py-2">
      <svg class="w-3.5 h-3.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd"
          d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
          clip-rule="evenodd"/>
      </svg>
      <span class="text-xs text-gray-400">
        <%= Rails.env.production? ? "Pagamento processado com segurança pelo Stripe" : "Ambiente de desenvolvimento — pagamento simulado" %>
      </span>
    </div>

  </div>
</div>
