<%# app/views/organizer/nps_reports/show.html.erb %>
<div class="mb-8">
  <h1 class="text-2xl font-bold dark:text-white">Relatório de Satisfação (NPS)</h1>
  <p class="text-gray-500">Métricas de lealdade e feedback dos atletas.</p>
</div>

<% report = @nps_analytics.calculate_report %>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8">
  <!-- Card Score NPS -->
  <div class="lg:col-span-1 bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center justify-center">
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Score NPS</p>
    <div class="text-6xl font-black <%= nps_color_class(report[:score]) %>">
      <%= report[:score] %>
    </div>
    <p class="mt-4 text-sm text-gray-500"><%= report[:total_respostas] %> avaliações</p>
  </div>

  <!-- Médias por Categoria -->
  <div class="lg:col-span-3 bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border border-gray-100">
    <h3 class="font-bold mb-6 dark:text-white">Médias por Dimensão</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% report[:medias].each do |label, media| %>
        <div class="text-center p-4 bg-gray-50 dark:bg-gray-900 rounded-xl">
          <p class="text-2xl font-black text-gray-900 dark:text-white"><%= media %></p>
          <p class="text-[10px] font-bold text-gray-400 uppercase"><%= label %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Listagem de Comentários -->
<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
  <div class="p-6 border-b dark:border-gray-700">
    <h3 class="font-bold dark:text-white">O que os atletas estão dizendo</h3>
  </div>
  <div class="divide-y dark:divide-gray-700">
    <% report[:comentarios_recentes].each do |resp| %>
      <div class="p-6">
        <div class="flex items-center gap-3 mb-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-black <%= nps_badge_class(resp.nota_geral) %>">
            NOTA <%= resp.nota_geral %>
          </span>
          <span class="text-xs text-gray-400"><%= l resp.respondido_em, format: :short %></span>
        </div>
        <p class="text-gray-700 dark:text-gray-300 italic">"<%= resp.comentario %>"</p>
        <p class="text-xs text-blue-600 font-bold mt-2">— <%= resp.athlete.nome %></p>
      </div>
    <% end %>
  </div>
</div>