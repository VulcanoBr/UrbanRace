<div class="min-h-screen bg-gray-950 flex items-center justify-center px-4 py-12">

  <div class="w-full max-w-lg">

    <div class="rounded-3xl border border-white/10 bg-white/5 p-8 shadow-2xl backdrop-blur-xl">

      <div class="mb-8 text-center">

        <%= image_tag "logo_urbanrace_3d.png",
            class: "mx-auto mb-6 h-12" %>

        <h1 class="text-2xl font-black uppercase italic text-white">
          Você recebeu uma vaga!
        </h1>

        <p class="mt-3 text-sm leading-6 text-gray-400">

          <strong class="text-white">
            <%= @pending_transfer.transfer.athlete_origem.nome %>
          </strong>

          transferiu uma inscrição para você.

        </p>

      </div>

      <div class="mb-6 rounded-2xl border border-orange-500/20 bg-orange-500/10 p-5">

        <p class="text-xs font-black uppercase tracking-wider text-orange-400">
          Evento
        </p>

        <p class="mt-1 text-lg font-black text-white">
          <%= @pending_transfer.registration.event.nome %>
        </p>

        <div class="mt-3 grid grid-cols-2 gap-4 text-sm">

          <div>
            <p class="text-gray-500">
              Distância
            </p>

            <p class="font-bold text-white">
              <%= @pending_transfer.registration.distance.nome %>
            </p>
          </div>

          <div>
            <p class="text-gray-500">
              Categoria
            </p>

            <p class="font-bold text-white">
              <%= @pending_transfer.registration.category.nome %>
            </p>
          </div>

        </div>

      </div>

      <div class="mb-6 rounded-2xl border border-yellow-500/20 bg-yellow-500/10 p-4">

        <p class="text-sm leading-6 text-yellow-200">

          Este convite é válido por
          <strong>48 horas</strong>.

          Complete seu cadastro para receber a vaga.

        </p>

      </div>

      <% if @athlete.errors.any? %>

        <div class="mb-6 rounded-2xl border border-red-500/30 bg-red-500/10 p-4">

          <ul class="space-y-1 text-sm text-red-300">

            <% @athlete.errors.full_messages.each do |message| %>

              <li>
                <%= message %>
              </li>

            <% end %>

          </ul>

        </div>

      <% end %>

      <%= form_with model: @athlete,
                    url: accept_transfer_path(@pending_transfer.generate_token_for(:acceptance)),
                    method: :post,
                    class: "space-y-5" do |form| %>

        <div>

          <%= form.label :nome,
              "Nome completo",
              class: "block text-xs font-black uppercase tracking-wider text-gray-400" %>

          <%= form.text_field :nome,
              required: true,
              class: "mt-2 block w-full rounded-2xl border-white/10 bg-white/5 px-4 py-3 text-white" %>

        </div>

        <div>

          <%= form.label :cpf,
              "CPF",
              class: "block text-xs font-black uppercase tracking-wider text-gray-400" %>

          <%= form.text_field :cpf,
              value: format_cpf(@pending_transfer.cpf_destino),
              readonly: true,
              class: "mt-2 block w-full rounded-2xl border-white/10 bg-white/5 px-4 py-3 text-gray-400" %>

        </div>

        <div>

          <%= form.label :nascimento,
              "Data de nascimento",
              class: "block text-xs font-black uppercase tracking-wider text-gray-400" %>

          <%= form.date_field :nascimento,
              required: true,
              class: "mt-2 block w-full rounded-2xl border-white/10 bg-white/5 px-4 py-3 text-white" %>

        </div>

        <div>

          <%= form.label :sexo,
              "Sexo biológico",
              class: "block text-xs font-black uppercase tracking-wider text-gray-400" %>

          <%= form.select :sexo,
              [
                ["Masculino", "masculino"],
                ["Feminino", "feminino"]
              ],
              { prompt: "Selecione" },
              {
                required: true,
                class: "mt-2 block w-full rounded-2xl border-white/10 bg-white/5 px-4 py-3 text-white"
              } %>

        </div>

        <div>

          <%= form.label :password,
              "Senha",
              class: "block text-xs font-black uppercase tracking-wider text-gray-400" %>

          <%= form.password_field :password,
              required: true,
              class: "mt-2 block w-full rounded-2xl border-white/10 bg-white/5 px-4 py-3 text-white" %>

        </div>

        <div>

          <%= form.label :password_confirmation,
              "Confirme a senha",
              class: "block text-xs font-black uppercase tracking-wider text-gray-400" %>

          <%= form.password_field :password_confirmation,
              required: true,
              class: "mt-2 block w-full rounded-2xl border-white/10 bg-white/5 px-4 py-3 text-white" %>

        </div>

        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">

          <p class="text-xs leading-5 text-gray-400">

            Ao concluir o cadastro, você aceitará a transferência
            da inscrição e passará a ser o responsável pela
            participação neste evento.

          </p>

        </div>

        <%= form.submit "CONCLUIR E RECEBER VAGA",
            class: "w-full cursor-pointer rounded-2xl bg-orange-600 py-4 text-sm font-black text-white shadow-lg transition hover:bg-orange-700" %>

      <% end %>

    </div>

  </div>

</div>