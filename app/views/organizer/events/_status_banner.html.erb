<%# app/views/organizer/events/_status_banner.html.erb %>

<% if event.finished? %>
  <div class="rounded-3xl bg-green-50 border border-green-200 p-6">
    <div class="flex items-center gap-3 mb-3">
      <div class="w-9 h-9 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h3 class="font-bold text-green-800 text-sm">Evento Finalizado</h3>
    </div>
    <p class="text-xs text-green-700 leading-relaxed">
      O evento foi encerrado oficialmente. Resultados e certificados estão
      disponíveis para os atletas na plataforma pública.
    </p>
  </div>

<% elsif event.cancelled? %>
  <div class="rounded-3xl bg-red-50 border border-red-200 p-6">
    <div class="flex items-center gap-3 mb-3">
      <div class="w-9 h-9 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
        </svg>
      </div>
      <h3 class="font-bold text-red-800 text-sm">Evento Cancelado</h3>
    </div>
    <p class="text-xs text-red-700 leading-relaxed mb-3">
      Este evento foi cancelado. Inscrições canceladas e reembolsos em processamento.
    </p>
    <% if event.cancellation_reason.present? %>
      <div class="bg-red-100 rounded-xl px-3 py-2">
        <p class="text-xs font-semibold text-red-600 mb-0.5">Motivo informado</p>
        <p class="text-xs text-red-700"><%= event.cancellation_reason %></p>
      </div>
    <% end %>
  </div>
<% end %>
