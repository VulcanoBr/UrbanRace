<%= form_with(
      model: route_form,
      url: form_url,
      local: true,
      data: {
        controller: "route-map",
        "route-map-geojson-value": route_form.geojson_traca.presence || "",
        "route-map-pontos-apoio-value": route_form.pontos_apoio_json.presence || "[]"
      }
    ) do |f| %>

  <% if route_form.errors.any? %>

    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-5
                dark:border-red-900/50 dark:bg-red-900/20">

      <div class="flex gap-3">

        <div class="flex-1">

          <h2 class="font-bold text-red-800 dark:text-red-300">
            Não foi possível salvar o percurso
          </h2>

          <ul class="mt-3 list-disc pl-5 text-sm text-red-700 dark:text-red-400">

            <% route_form.errors.full_messages.each do |message| %>

              <li>
                <%= message %>
              </li>

            <% end %>

          </ul>

        </div>

      </div>

    </div>

  <% end %>


  <!-- CAMPOS OCULTOS DO MAPA -->

  <%= f.hidden_field :geojson_traca,
      data: {
        "route-map-target": "geojson"
      } %>

  <%= f.hidden_field :pontos_apoio_json,
      value: route_form.pontos_apoio_json.presence || "[]",
      data: {
        "route-map-target": "pontosApoio"
      } %>


  <!-- DISTÂNCIA -->

  <div class="mb-6">

    <%= f.label(
          :distance_id,
          "Distância",
          class: "block text-sm font-medium text-gray-700
                  dark:text-gray-300 mb-2"
        ) %>

    <%= f.collection_select(
          :distance_id,
          distances,
          :id,
          ->(distance) {
            "#{distance.nome} - #{distance.km} KM"
          },
          { prompt: "Selecione a distância" },
          {
            class: "block w-full rounded-xl border-gray-300
                    shadow-sm focus:border-blue-500
                    focus:ring-blue-500
                    dark:bg-gray-700
                    dark:border-gray-600
                    dark:text-white"
          }
        ) %>

    <% if route_form.errors[:distance_id].any? %>

      <p class="mt-2 text-sm text-red-600 dark:text-red-400">
        <%= route_form.errors[:distance_id].first %>
      </p>

    <% end %>

  </div>


  <!-- CONSTRUÇÃO -->

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">


    <!-- PAINEL -->

    <div class="lg:col-span-1">

      <div class="bg-white dark:bg-gray-800
                  rounded-2xl border border-gray-200
                  dark:border-gray-700
                  shadow-sm p-5">

        <h2 class="font-bold text-gray-900 dark:text-white">
          Construção do percurso
        </h2>


        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
          Utilize as ferramentas abaixo para definir
          largada, percurso, pontos de apoio e chegada.
        </p>


        <div class="mt-6 space-y-3">


          <!-- LARGADA -->

          <button
            type="button"
            data-action="click->route-map#startStartPoint"
            class="w-full rounded-xl bg-green-600 px-4 py-3
                   text-sm font-bold text-white
                   hover:bg-green-500
                   focus:outline-none focus:ring-2
                   focus:ring-green-500 focus:ring-offset-2">

            🟢 Definir largada

          </button>


          <!-- PERCURSO -->

          <button
            type="button"
            data-action="click->route-map#startRoute"
            class="w-full rounded-xl bg-blue-600 px-4 py-3
                   text-sm font-bold text-white
                   hover:bg-blue-500
                   focus:outline-none focus:ring-2
                   focus:ring-blue-500 focus:ring-offset-2">

            🔵 Traçar percurso

          </button>


          <!-- APOIO -->

          <button
            type="button"
            data-action="click->route-map#startSupportPoint"
            class="w-full rounded-xl bg-yellow-500 px-4 py-3
                   text-sm font-bold text-white
                   hover:bg-yellow-400
                   focus:outline-none focus:ring-2
                   focus:ring-yellow-500 focus:ring-offset-2">

            🟡 Ponto de apoio

          </button>


          <!-- CHEGADA -->

          <button
            type="button"
            data-action="click->route-map#startFinishPoint"
            class="w-full rounded-xl bg-red-600 px-4 py-3
                   text-sm font-bold text-white
                   hover:bg-red-500
                   focus:outline-none focus:ring-2
                   focus:ring-red-500 focus:ring-offset-2">

            🔴 Definir chegada

          </button>

        </div>


        <!-- DISTÂNCIA CALCULADA -->

        <div class="mt-6 border-t border-gray-200
                    dark:border-gray-700 pt-5">

          <p class="text-xs text-gray-500 dark:text-gray-400">
            Distância calculada
          </p>

          <p
            data-route-map-target="distanciaCalculada"
            class="mt-1 text-2xl font-black
                   text-blue-600 dark:text-blue-400">

            0,00 km

          </p>

        </div>


        <!-- STATUS -->

        <div
          data-route-map-target="status"
          class="mt-4 rounded-xl bg-gray-50
                 dark:bg-gray-900 p-3 text-sm
                 text-gray-600 dark:text-gray-400">

          Selecione uma ferramenta.

        </div>

      </div>

    </div>


    <!-- MAPA -->

    <div class="lg:col-span-3">

      <div
        data-route-map-target="map"
        class="w-full h-[650px]
               rounded-2xl overflow-hidden
               border border-gray-200
               dark:border-gray-700
               shadow-sm">
      </div>

    </div>

  </div>


  <!-- AÇÕES -->

  <div class="mt-6 flex justify-end gap-3">

    <%= link_to(
          "Cancelar",
          cancel_url,
          class: "rounded-xl px-5 py-3 text-sm font-bold
                  text-gray-700 dark:text-gray-300
                  hover:bg-gray-100
                  dark:hover:bg-gray-700"
        ) %>


    <%= f.submit(
          submit_label,
          class: "rounded-xl bg-blue-600 px-6 py-3
                  text-sm font-bold text-white
                  shadow-sm hover:bg-blue-500
                  focus:outline-none focus:ring-2
                  focus:ring-blue-500 focus:ring-offset-2"
        ) %>

  </div>

<% end %>