<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <div class="mb-6">

    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
      Construir Percurso
    </h1>

    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      <%= @event.nome %>
    </p>

  </div>


  <%= render(
        "form",
        route_form: @route_form,
        distances: @distances,
        form_url: organizer_event_routes_path(@event),
        cancel_url: organizer_event_routes_path(@event),
        submit_label: "Salvar Percurso"
      ) %>

</div>