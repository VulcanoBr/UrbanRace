<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <div class="mb-6">

    <div class="flex items-center gap-3">

      <%= link_to(
            "← Voltar",
            organizer_event_route_path(@event, @route),
            class: "text-sm font-medium text-gray-500
                    hover:text-gray-900
                    dark:text-gray-400
                    dark:hover:text-white"
          ) %>

    </div>


    <h1 class="mt-4 text-2xl font-bold
               text-gray-900 dark:text-white">

      Editar Percurso

    </h1>


    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">

      <%= @event.nome %>

      <span class="mx-1">
        •
      </span>

      <%= @route.distance.nome %>

    </p>

  </div>


  <%= render(
        "form",
        route_form: @route_form,
        distances: @distances,
        form_url: organizer_event_route_path(@event, @route),
        cancel_url: organizer_event_route_path(@event, @route),
        submit_label: "Atualizar Percurso"
      ) %>

</div>
