<div class="mb-8 flex items-center justify-between">
  <div class="flex items-center gap-4">
    <%= link_to organizer_event_volunteer_stations_path(@event), class: "p-2 rounded-full bg-white border shadow-sm hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-700" do %>
      <svg class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M15 19l-7-7 7-7" /></svg>
    <% end %>
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white"><%= @station.event.nome %> / <%= @station.nome %></h1>
  </div>
  <%= link_to "Editar Posto", edit_organizer_event_volunteer_station_path(@event, @station), class: "bg-white border px-4 py-2 rounded-lg text-sm font-medium dark:bg-gray-800 dark:text-white" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border p-6">
    <h3 class="text-sm font-bold text-gray-500 uppercase mb-6">Configuração Logística</h3>
    <dl class="space-y-4 text-sm">
      <div class="flex justify-between">
        <dt class="text-gray-400">Tipo:</dt>
        <dd class="font-bold dark:text-gray-200"><%= @station.tipo %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-400">KM:</dt>
        <dd class="font-bold dark:text-gray-200"><%= @station.km_posicao %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-400">Distância:</dt>
        <dd class="font-bold dark:text-gray-200"><%= @station.distance.nome %></dd>
      </div>
      <div class="flex justify-between pt-4 border-t dark:border-gray-700">
        <dt class="text-gray-400">Vagas Totais:</dt>
        <dd class="font-bold dark:text-gray-200"><%= @station.vagas %></dd>
      </div>
    </dl>
  </div>

  <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-xl shadow-sm border p-6">
    <h3 class="text-sm font-bold text-gray-500 uppercase mb-6">Voluntários Escalados</h3>
    <% if @shifts.any? %>
      <div class="divide-y dark:divide-gray-700">
        <% @shifts.each do |shift| %>
          <div class="py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-xs uppercase">
                <%= shift.volunteer.nome[0..1] %>
              </div>
              <div>
                <p class="font-bold text-gray-900 dark:text-white"><%= shift.volunteer.nome %></p>
                <p class="text-xs text-gray-500">Turno: <%= shift.turno %></p>
              </div>
            </div>
            <span class="text-xs font-bold text-green-600 uppercase"><%= shift.status %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-10">
        <p class="text-gray-400 italic">Nenhum voluntário escalado para este posto ainda.</p>
        <%= link_to "Escalar Voluntários", new_organizer_event_volunteer_station_volunteer_shift_path(@event, @station), class: "text-blue-600 font-bold text-sm hover:underline mt-2 inline-block" %>
      </div>
    <% end %>
  </div>
</div>