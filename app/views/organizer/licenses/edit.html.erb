<<%# app/views/organizer/licenses/edit.html.erb %>
<div class="mx-auto max-w-4xl">
  <div class="md:flex md:items-center md:justify-between mb-8">
    <div class="min-w-0 flex-1">
      <!-- Breadcrumbs -->
      <nav class="mb-2">
        <ol class="flex items-center space-x-2 text-sm text-gray-500">
          <li><%= link_to "Eventos", organizer_events_path, class: "hover:text-gray-700 dark:hover:text-gray-300" %></li>
          <li><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 11 7.293 7.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" /></svg></li>
          <li><%= link_to @event.nome, organizer_event_path(@event), class: "hover:text-gray-700 dark:hover:text-gray-300" %></li>
          <li><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 11 7.293 7.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" /></svg></li>
          <li><%= link_to "Licenças", organizer_event_licenses_path(@event), class: "hover:text-gray-700 dark:hover:text-gray-300" %></li>
          <li><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 11 7.293 7.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" /></svg></li>
          <li class="text-gray-900 font-semibold dark:text-white">Editar</li>
        </ol>
      </nav>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Editar Licença: <%= @license.tipo %></h2>
      <p class="text-sm text-gray-500"><%= @license.orgao %></p>
    </div>
    
    <div class="mt-4 flex md:ml-4 md:mt-0">
      <%= button_to organizer_event_license_path(@event, @license), 
                    method: :delete, 
                    data: { turbo_confirm: "Tem certeza que deseja remover esta licença? O arquivo PDF anexado também será excluído." },
                    class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-red-600 shadow-sm ring-1 ring-inset ring-red-300 hover:bg-red-50 dark:bg-gray-800 dark:ring-red-900 dark:text-red-400" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.75 1A2.75 2.25 0 006 3.75V4H5a2 2 0 00-2 2v.25C3 6.664 3.336 7 3.75 7h12.5a.75.75 0 00.75-.75V6a2 2 0 00-2-2h-1V3.75A2.75 2.25 0 0011.25 1h-2.5zM5 8.25V18a2 2 0 002 2h6a2 2 0 002-2V8.25H5z" clip-rule="evenodd" />
        </svg>
        Remover Licença
      <% end %>
    </div>
  </div>

  <%# Chamada do Form Object %>
  <%= render "form", license_form: @license_form, url: organizer_event_license_path(@event, @license) %>

  <%# Preview do PDF Atual (Opcional, mas muito útil para o Organizador) %>
  <% if @license.documento_pdf.attached? %>
    <div class="mt-8 bg-blue-50 border border-blue-100 rounded-xl p-6 dark:bg-blue-900/10 dark:border-blue-800">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          <div>
            <p class="text-sm font-bold text-blue-900 dark:text-blue-300">Documento Atual</p>
            <p class="text-xs text-blue-700 dark:text-blue-400"><%= @license.documento_pdf.filename %></p>
          </div>
        </div>
        <%= link_to "Visualizar PDF", url_for(@license.documento_pdf), target: "_blank", class: "text-sm font-bold text-blue-600 hover:underline" %>
      </div>
    </div>
  <% end %>
</div>