<%# app/views/organizer/checkin_reports/index.html.erb %>
<div class="mb-8 flex justify-between items-center">
  <div>
    <h1 class="text-2xl font-bold dark:text-white">Monitoramento de Credenciamento</h1>
    <p class="text-sm text-gray-500"><%= @event.nome %></p>
  </div>
  
  <!-- Link rápido para o Admin também poder entrar na operação se quiser -->
  <%= link_to operation_event_checkins_path(@event), class: "bg-gray-900 text-white px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
    ABRIR MODO SCANNER (CAMPO)
  <% end %>
</div>

<!-- Cards de Progresso Real-time -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="bg-white p-6 rounded-2xl border shadow-sm text-center">
    <p class="text-3xl font-black text-blue-600"><%= @stats[:presentes] %></p>
    <p class="text-xs font-bold text-gray-400 uppercase">Atletas Credenciados</p>
  </div>
  <div class="bg-white p-6 rounded-2xl border shadow-sm text-center">
    <p class="text-3xl font-black text-amber-500"><%= @stats[:ausentes] %></p>
    <p class="text-xs font-bold text-gray-400 uppercase">Aguardando Chegada</p>
  </div>
  <div class="bg-white p-6 rounded-2xl border shadow-sm text-center">
    <% percent = (@stats[:presentes].to_f / @stats[:total] * 100).round(1) rescue 0 %>
    <p class="text-3xl font-black text-green-600"><%= percent %>%</p>
    <p class="text-xs font-bold text-gray-400 uppercase">Progresso Total</p>
  </div>
</div>

<div class="bg-white dark:bg-gray-800 shadow-sm border rounded-2xl overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Atleta</th>
        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Categoria</th>
        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Dorsal</th>
        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @registrations.each do |reg| %>
        <tr>
          <td class="px-6 py-4 text-sm font-medium text-gray-900 dark:text-white"><%= reg.athlete.nome %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= reg.category.nome %></td>
          <td class="px-6 py-4 text-sm font-bold text-blue-600">#<%= reg.numero_dorsal %></td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 rounded-full text-[10px] font-black uppercase <%= reg.status == 'checked_in' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
              <%= reg.status.humanize %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>