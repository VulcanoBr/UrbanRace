<%# app/views/organizer/sponsors/new.html.erb %>
<div class="mx-auto max-w-4xl">
  <nav class="mb-4" aria-label="Back">
    <%= link_to organizer_sponsors_path(@event), class: "flex items-center text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" do %>
      <svg class="mr-1 h-5 w-5 flex-shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
      </svg>
      Voltar para Patrocinadores
    <% end %>
  </nav>

  <div class="md:flex md:items-center md:justify-between mb-8">
    <div class="min-w-0 flex-1">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl dark:text-white">
        Novo Patrocinador
      </h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Vinculando um parceiro a um evento.</p>
    </div>
  </div>

  <%# O Form Object é passado para a partial, e a URL aponta para a criação aninhada no evento %>
  <%= render "form", sponsor_form: @sponsor_form, url: organizer_sponsors_path %>
</div>