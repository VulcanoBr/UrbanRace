<%# app/views/organizer/sponsors/show.html.erb %>
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
  <div class="flex items-center gap-6">
    <%# Botão Voltar %>
    <%= link_to organizer_sponsors_path, class: "p-2 rounded-full bg-white border shadow-sm hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-700 transition-colors" do %>
      <svg class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    <% end %>

    <%# BOX DO LOGOTIPO OU ÍCONE %>
    <div class="h-20 w-20 flex-shrink-0 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl overflow-hidden shadow-sm flex items-center justify-center p-2">
      <% if @sponsor.logo.attached? %>
        <%# Exibe o logo usando variant para performance (não carrega a imagem original pesada) %>
        <%= image_tag @sponsor.logo.variant(resize_to_limit: [200, 200]), class: "max-h-full max-w-full object-contain" %>
      <% else %>
        <%# Ícone de fallback (Empresa/Building) do Heroicons (Tailwind) %>
        <svg class="h-10 w-10 text-gray-300 dark:text-gray-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.336-1.125.75-1.125h2.25c.414 0 .75.504.75 1.125V21" />
        </svg>
      <% end %>
    </div>

    <div>
      <h1 class="text-3xl font-black text-gray-900 dark:text-white tracking-tighter"><%= @sponsor.nome %></h1>
      <div class="flex items-center gap-2 mt-1">
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-bold ring-1 ring-inset <%= @sponsor.status_class %>">
          <%= @sponsor.ativo ? "ATIVO" : "INATIVO" %>
        </span>
        <% if @sponsor.website.present? %>
          <span class="text-xs text-gray-400">•</span>
          <a href="https://<%= @sponsor.website %>" target="_blank" class="text-xs font-medium text-blue-600 hover:underline">
            <%= @sponsor.website %>
          </a>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex gap-2">
    <%= link_to edit_organizer_sponsor_path(@sponsor), class: "inline-flex items-center gap-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 px-4 py-2 rounded-xl text-sm font-bold text-gray-700 dark:text-gray-200 hover:bg-gray-50 transition shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 Ayo 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
      Editar Dados
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <!-- Informações de Contato -->
  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-8">
    <h3 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-6">Informações e Contato</h3>
    <dl class="space-y-6">
      <div>
        <dt class="text-xs font-bold text-gray-500 uppercase mb-1">CNPJ</dt>
        <dd class="text-sm font-black text-gray-900 dark:text-gray-200">
          <%= @sponsor.cnpj.present? ? @sponsor.cnpj.gsub(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '\1.\2.\3/\4-\5') : "Não informado" %>
        </dd>
      </div>
      <div class="pt-4 border-t border-gray-50 dark:border-gray-700">
        <dt class="text-xs font-bold text-gray-500 uppercase mb-1">Responsável</dt>
        <dd class="text-sm font-bold text-gray-900 dark:text-gray-200"><%= @sponsor.contato %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-500 uppercase mb-1">E-mail</dt>
        <dd class="text-sm font-medium text-blue-600 hover:underline"><%= mail_to @sponsor.email_contato %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-500 uppercase mb-1">Telefone</dt>
        <dd class="text-sm font-bold text-gray-900 dark:text-gray-200">
          <%= @sponsor.phone_contato.present? ? @sponsor.phone_contato.gsub(/^(\d{2})(\d{5})(\d{4})$/, '(\1) \2-\3') : "Não informado" %>
        </dd>
      </div>
    </dl>
  </div>

  <!-- Histórico de Contratos -->
  <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-8">
    <h3 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-6">Histórico de Contratos</h3>
    
    <% if @sponsor.sponsor_contracts.any? %>
      <div class="overflow-hidden">
        <ul class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @sponsor.sponsor_contracts.each do |contract| %>
            <li class="py-5 flex justify-between items-center group hover:bg-gray-50/50 dark:hover:bg-gray-900/50 transition px-2 rounded-xl">
              <div>
                <p class="font-bold text-gray-900 dark:text-white group-hover:text-blue-600 transition"><%= contract.event.nome %></p>
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-[10px] font-black bg-blue-50 text-blue-700 px-2 py-0.5 rounded uppercase"><%= contract.cota %></span>
                  <span class="text-xs text-gray-400"><%= l contract.created_at, format: :short %></span>
                </div>
              </div>
              <div class="text-right">
                <p class="font-black text-gray-900 dark:text-white"><%= number_to_currency(contract.valor_cota) %></p>
                <span class="text-[10px] uppercase font-bold text-gray-500"><%= contract.status %></span>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center py-12 bg-gray-50 dark:bg-gray-900/50 rounded-2xl border-2 border-dashed border-gray-200 dark:border-gray-700">
        <svg class="h-12 w-12 text-gray-300 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        <p class="text-gray-400 font-medium italic">Nenhum contrato ativo.</p>
      </div>
    <% end %>
  </div>
</div>