<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Fornecedores</h1>
    <p class="mt-2 text-sm text-gray-700 dark:text-gray-400">Gestão de parceiros e serviços.</p>
  </div>
  <div class="mt-4 sm:ml-16 sm:mt-0">
    <%= link_to "Novo Fornecedor", new_organizer_supplier_path, class: "block rounded-md bg-blue-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>
</div>

<div class="mb-6 rounded-xl bg-white p-4 shadow-sm ring-1 ring-gray-900/5 dark:bg-gray-800 dark:ring-gray-700">
  <%= form_with url: organizer_suppliers_path,
                method: :get,
                local: true,
                class: "grid grid-cols-1 gap-4 md:grid-cols-3 md:items-end" do |form| %>

    <div>
      <%= form.label :nome_fornecedor,
                     "Nome do fornecedor",
                     class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.search_field :nome_fornecedor,
                            value: @nome_fornecedor,
                            placeholder: "Digite a razão social...",
                            class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white" %>
    </div>

    <div>
      <%= form.label :tipo_servico,
                     "Tipo de serviço",
                     class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.select :tipo_servico,
                      options_for_select(
                        @tipos_servico.map { |tipo| [tipo, tipo] },
                        @tipo_servico
                      ),
                      { include_blank: "Todos os serviços" },
                      class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white" %>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= form.submit "Filtrar",
                      class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>

      <% if @nome_fornecedor.present? || @tipo_servico.present? %>
        <%= link_to "Limpar filtros",
                    organizer_suppliers_path,
                    class: "inline-flex items-center justify-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700" %>
      <% end %>
    </div>

  <% end %>
</div>

<div class="bg-white dark:bg-gray-800 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl overflow-hidden">
  <div class="min-w-full overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900/50">
        <tr>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Fornecedor / CNPJ</th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Serviço</th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Contato Principal</th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Avaliação</th>
          <th class="relative py-3.5 pl-3 pr-6 sm:pr-0"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800">
        <% @suppliers.each do |supplier| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
            <td class="whitespace-nowrap px-6 py-4">
              <div class="font-medium text-gray-900 dark:text-white"><%= supplier.razao_social %></div>
              <div class="text-xs text-gray-500"><%= formatar_cnpj(supplier.cnpj) %></div>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm">
              <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10 dark:bg-blue-900/20 dark:text-blue-400">
                <%= supplier.tipo_servico %>
              </span>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
              <div class="font-medium text-gray-900 dark:text-white"><%= supplier.contato %></div>
              <div class="text-xs"><%= supplier.email_contato %></div>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm">
              <div class="flex items-center text-yellow-400">
                <svg class="h-4 w-4 fill-current mr-1" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span class="text-gray-600 dark:text-gray-300 font-bold"><%= supplier.avaliacao_media %></span>
              </div>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
              <%= link_to "Ver", organizer_supplier_path(supplier), class: "text-blue-600 hover:text-blue-900 mr-4" %>
              <%= link_to "Editar", edit_organizer_supplier_path(supplier), class: "text-gray-600 hover:text-gray-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    - Paginação -->
    <div class="mt-2 flex justify-center">
      <div class="glass-card p-2 rounded-2xl border-gray-500 flex items-center gap-1 text-white">
        <%= paginate @suppliers,
             params: {
               nome_fornecedor: @nome_fornecedor.presence,
               tipo_servico: @tipo_servico.presence
             },
             window: 2,
             outer_window: 1,
             class: "urbanrace-pagination" %>
      </div>
    </div>
  </div>
</div>