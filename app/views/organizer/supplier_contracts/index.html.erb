<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Financeiro: Contratos e Despesas</h1>
    <p class="mt-2 text-sm text-gray-700 dark:text-gray-400">Controle de contrato a fornecedores e prestadores de serviço.</p>
  </div>
  <div class="mt-4 sm:ml-16 sm:mt-0 flex gap-3">
    <div class="bg-red-50 px-4 py-2 rounded-lg border border-red-100 dark:bg-red-900/20 dark:border-red-800">
      <span class="text-xs text-red-600 dark:text-red-400 font-bold uppercase">Total em Contratos</span>
      <p class="text-lg font-bold text-red-700 dark:text-red-300"><%= number_to_currency(@total_gastos) %></p>
    </div>
    <%= link_to "Novo Lançamento", new_organizer_supplier_contract_path, class: "flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>
</div>

<div class="mb-6 rounded-xl bg-white p-4 shadow-sm ring-1 ring-gray-900/5 dark:bg-gray-800 dark:ring-gray-700">
  <%= form_with url: organizer_supplier_contracts_path,
                method: :get,
                local: true,
                class: "grid grid-cols-1 gap-4 md:grid-cols-3 md:items-end" do |form| %>

    <div>
      <%= form.label :nome_fornecedor,
                     "Nome do fornecedor",
                     class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.search_field :nome_fornecedor,
                            value: @nome_fornecedor,
                            placeholder: "Pesquisar fornecedor...",
                            class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white" %>
    </div>

    <div>
      <%= form.label :tipo_servico,
                     "Tipo de serviço",
                     class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.select :tipo_servico,
                      options_for_select(
                        @tipos_servico,
                        @tipo_servico
                      ),
                      { include_blank: "Todos os serviços" },
                      class: "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white" %>
    </div>

    <div class="flex gap-2">
      <%= form.submit "Filtrar",
                      class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>

      <% if @nome_fornecedor.present? || @tipo_servico.present? %>
        <%= link_to "Limpar",
                    organizer_supplier_contracts_path,
                    class: "inline-flex items-center justify-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700" %>
      <% end %>
    </div>
  <% end %>
</div>


<div class="bg-white dark:bg-gray-800 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl overflow-hidden">
  <div class="min-w-full overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900/50">
        <tr>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Fornecedor / Evento</th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white"> Tipo de serviço </th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Valor</th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Status</th>
          <th class="hidden md:table-cell px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Data Assinatura</th>
          <th class="relative py-3.5 pl-3 pr-6 sm:pr-0"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800">
        <% @contracts.each do |contract| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900 dark:text-white"><%= contract.supplier.razao_social %></div>
              <div class="text-xs text-gray-500"><%= contract.event.nome %></div>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
              <%= contract.supplier.tipo_servico.presence || "Não informado" %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm font-bold text-red-600 dark:text-red-400">
              <%= number_to_currency(contract.valor) %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm">
              <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium ring-1 ring-inset 
                <%= contract.status == 'signed' ? 'bg-green-50 text-green-700 ring-green-600/20' : 'bg-gray-50 text-gray-700 ring-gray-600/20' %>">
                <%= contract.status.humanize %>
              </span>
            </td>
            <td class="hidden md:table-cell whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              <%= contract.assinado_em ? l(contract.assinado_em) : "Pendente" %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
              <%= link_to "Editar", edit_organizer_supplier_contract_path(contract), class: "text-blue-600 hover:text-blue-900 mr-4" %>
              <% if contract.arquivo_pdf.attached? %>
                <%= link_to "PDF", url_for(contract.arquivo_pdf), target: "_blank", class: "text-gray-400 hover:text-red-500" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Paginação -->
    <div class="mt-2 flex justify-center">
      <div class="glass-card p-2 rounded-2xl border-gray-500 flex items-center gap-1 text-white">
        
        <%= paginate @contracts,
                    params: {
                      nome_fornecedor: @nome_fornecedor.presence,
                      tipo_servico: @tipo_servico.presence
                    },
                    window: 2,
                    outer_window: 1,
                    class: "urbanrace-pagination" %>

      </div>
    </div>
  </div>
</div>