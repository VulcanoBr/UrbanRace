<%= form_with model: [:organizer, supplier_contract_form], url: url, method: (supplier_contract_form.persisted? ? :patch : :post), class: "space-y-8" do |f| %>
  <div class="bg-white dark:bg-gray-800 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl p-6 md:p-8">
    <% if supplier_contract_form.errors.any? %>
      <div class=" mb-8 rounded-2xl border border-red-200 bg-red-50 p-6" >
        <h3 class=" text-sm font-bold text-red-700 mb-3 ">
          Corrija os erros abaixo
        </h3>

        <ul class=" list-disc ml-5 text-sm text-red-600 ">
          <% supplier_contract_form.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
      <div class="sm:col-span-3">
        <%= f.label :supplier_id, "Fornecedor", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.collection_select :supplier_id, Supplier.all, :id, :razao_social, { prompt: "Selecione o Fornecedor" }, class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300 shadow-sm focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <div class="sm:col-span-3">
        <%= f.label :event_id, "Evento Destinado", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.collection_select :event_id, Event.all, :id, :nome, { prompt: "Selecione o Evento" }, class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300 shadow-sm focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :valor, "Valor do Contrato (R$)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.text_field :valor, placeholder: "0.000,00", class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300 shadow-sm focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :status, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.select :status, [["Negociação", "negotiating"], ["Assinado", "signed"], ["Concluído", "completed"], ["Cancelado", "cancelled"]], {}, class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300 shadow-sm focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :assinado_em, "Data da Assinatura", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.date_field :assinado_em, class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300 shadow-sm focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <div class="sm:col-span-6">
        <%= f.label :arquivo_pdf, "Anexar Contrato Digitalizado (PDF)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.file_field :arquivo_pdf, class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-x-4">
    <%= link_to "Cancelar", organizer_supplier_contracts_path, class: "text-sm font-semibold text-gray-900 dark:text-white" %>
    <%= f.submit "Salvar Lançamento", class: "rounded-md bg-blue-600 px-6 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
  </div>
<% end %>