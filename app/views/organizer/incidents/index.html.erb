<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Ocorrências Médicas</h1>
    <p class="mt-2 text-sm text-gray-500">Monitoramento em tempo real do evento: <%= @event.nome %></p>
  </div>
</div>

<div class="bg-white dark:bg-gray-800 shadow-xl rounded-2xl overflow-hidden border border-red-100">
  <div class="p-6 bg-red-600 text-white flex justify-between items-center">
    <h3 class="font-bold flex items-center gap-2">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
      </span>
      CENTRAL DE ALERTAS
    </h3>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900/50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Hora</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">KM</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Tipo / Gravidade</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Identificação</th>
          <th class="relative px-6 py-3"></th>
        </tr>
      </thead>
      
      <%# Canal de Broadcast via Solid Cable %>
      <%= turbo_stream_from "event_#{@event.id}_incidents" %>
      
      <tbody id="incidents_list" class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @incidents.each do |incident| %>
          <%= render "incident_row", incident: incident %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>