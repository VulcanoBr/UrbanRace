<%# app/views/organizer/results/edit.html.erb %>
<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Voltar para resultados",
          organizer_event_results_path(@event),
          class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Editar resultado</h1>
  <%= render "form",
        result_form: @result_form,
        url: organizer_event_result_path(@event, @result) %>
</div>
