<%# app/views/organizer/results/_form.html.erb %>
<%= form_with model: [:organizer, result_form],
      url:    url,
      method: result_form.persisted? ? :patch : :post,
      class:  "space-y-6" do |f| %>

  <% if result_form.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-5">
      <h3 class="font-semibold text-red-800 mb-2">
        <%= pluralize(result_form.errors.count, "erro", "erros") %> no formulário:
      </h3>
      <ul class="space-y-1 text-sm text-red-700 list-disc list-inside">
        <% result_form.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :event_id %>

  <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-2xl overflow-hidden">
    <div class="border-b border-gray-200 px-6 py-4">
      <h2 class="text-lg font-semibold text-gray-900">Dados do resultado</h2>
    </div>

    <div class="p-6 space-y-6">

      <%# Inscrição %>
      <div>
        <%= f.label :registration_id, "Inscrição (atleta)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :registration_id,
              options_from_collection_for_select(
                @event.registrations.includes(:athlete).order("athletes.nome"),
                :id,
                ->(r) { "#{r.numero_dorsal} — #{r.athlete.nome}" },
                result_form.registration_id
              ),
              { include_blank: "Selecione..." },
              class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
      </div>

      <%# Tempos %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :tempo_liquido, "Tempo líquido (HH:MM:SS)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :tempo_liquido,
                placeholder: "00:45:30",
                pattern:     "\\d{2}:\\d{2}:\\d{2}",
                class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm font-mono" %>
          <p class="text-xs text-gray-400 mt-1">Tempo desde que o atleta cruzou a largada (chip time)</p>
        </div>
        <div>
          <%= f.label :tempo_bruto, "Tempo bruto (HH:MM:SS)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :tempo_bruto,
                placeholder: "00:47:00",
                pattern:     "\\d{2}:\\d{2}:\\d{2}",
                class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm font-mono" %>
          <p class="text-xs text-gray-400 mt-1">Tempo desde o disparo oficial (gun time) — opcional</p>
        </div>
      </div>

      <%# Posições %>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div>
          <%= f.label :posicao_geral, "Pos. geral", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :posicao_geral, min: 1,
                class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
        </div>
        <div>
          <%= f.label :posicao_categoria, "Pos. categoria", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :posicao_categoria, min: 1,
                class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
        </div>
        <div>
          <%= f.label :posicao_sexo, "Pos. sexo", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :posicao_sexo, min: 1,
                class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
        </div>
        <div>
          <%= f.label :posicao_faixa_etaria, "Pos. faixa etária", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :posicao_faixa_etaria, min: 1,
                class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
        </div>
      </div>

      <%# Status e homologação %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :status_finalizacao, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :status_finalizacao,
                [["Concluído", "concluido"], ["DNS — Não largou", "dns"],
                 ["DNF — Não terminou", "dnf"], ["DSQ — Desqualificado", "dsq"]],
                {},
                class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
        </div>
        <div class="flex items-end pb-1">
          <label class="flex items-center gap-3 cursor-pointer">
            <%= f.check_box :homologado,
                  class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
            <div>
              <span class="text-sm font-medium text-gray-700">Homologado</span>
              <p class="text-xs text-gray-400">Marque após conferir o resultado</p>
            </div>
          </label>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200 bg-gray-50 px-6 py-4 flex items-center justify-end gap-4">
      <%= link_to "Cancelar",
            organizer_event_results_path(@event),
            class: "text-sm font-semibold text-gray-700 hover:text-gray-900" %>
      <%= f.submit result_form.persisted? ? "Salvar alterações" : "Criar resultado",
            class: "inline-flex items-center rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition cursor-pointer" %>
    </div>
  </div>
<% end %>
