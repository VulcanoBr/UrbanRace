<div class="mx-auto max-w-4xl">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Editar Atleta</h2>
    <%= button_to "Excluir Atleta", organizer_athlete_path(@athlete), method: :delete, data: { turbo_confirm: "Confirma exclusão?" }, class: "text-sm text-red-600 hover:text-red-800" %>
  </div>
  <%= render "form", athlete_form: @athlete_form, url: organizer_athlete_path(@athlete) %>
</div>