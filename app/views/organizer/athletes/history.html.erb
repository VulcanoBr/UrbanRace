<div class="mb-8 flex items-center justify-between">
  <div>
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2 text-sm text-gray-500">
        <li><%= link_to "Atletas", organizer_athletes_path, class: "hover:text-gray-700" %></li>
        <li><svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg></li>
        <li class="font-medium text-gray-900 dark:text-white">Histórico do Atleta</li>
      </ol>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= @athlete.nome %></h1>
    <p class="text-sm text-gray-600 dark:text-gray-400">CPF: <%= format_cpf(@athlete.cpf) %> | <%= @athlete.email_address %></p>
  </div>
</div>

<div class="bg-white dark:bg-gray-800 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl overflow-hidden">
  <div class="min-w-full overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900/50">
        <tr>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Evento</th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Distância</th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Pos. (Geral/Cat)</th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Tempo Líquido</th>
          <th class="px-6 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Pace Médio</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800">
        <% if @registrations.any? %>
          <% @registrations.each do |reg| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900 dark:text-white"><%= reg.event.nome %></div>
                <div class="text-xs text-gray-500"><%= reg.event.created_at.strftime("%d/%m/%Y") %></div>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                <%= reg.distance.nome %> (<%= reg.distance.km %>km)
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                <span class="font-semibold text-blue-600"><%= reg.result.posicao_geral %>º</span> / 
                <%= reg.result.posicao_categoria %>º
              </td>
              <td class="px-6 py-4 text-sm font-mono text-gray-900 dark:text-white">
                <%= reg.result.tempo_liquido %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                <%= reg.result.pace_medio %> min/km
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500 italic">
              Este atleta ainda não possui resultados homologados em eventos.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>