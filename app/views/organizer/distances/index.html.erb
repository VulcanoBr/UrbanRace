<div class="space-y-8">

  <!-- HEADER -->
  <div class="
    flex flex-col lg:flex-row
    lg:items-center
    lg:justify-between
    gap-6
  ">

    <div>
      <p class="
        text-sm
        font-semibold
        text-blue-600
        mb-2
      ">
        <%= link_to "← #{@event.nome}", organizer_event_path(@event) %>
      </p>

      <h1 class="
        text-4xl
        font-black
        tracking-tighter
        dark:text-white
      ">
        Distâncias
      </h1>

      <p class="
        mt-3
        text-sm
        text-gray-500
      ">
        Gerencie percursos, categorias e lotes do evento.
      </p>

    </div>

    <%= link_to "Nova Distância",
        new_organizer_event_distance_path(@event),
        class: primary_button_class %>

  </div>

  <!-- TABLE -->
  <div class="
    overflow-hidden
    rounded-3xl
    border
    bg-white
    dark:bg-gray-800
    shadow-sm
  ">

    <div class="overflow-x-auto">

      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">

        <!-- HEADER -->
        <thead class="
          bg-gray-50
          dark:bg-gray-900
        ">

          <tr>

            <th class="px-8 py-5 text-left text-xs font-black uppercase tracking-wider text-gray-500">
              Distância
            </th>

            <th class="px-6 py-5 text-center text-xs font-black uppercase tracking-wider text-gray-500">
              Ocupação
            </th>

            <th class="px-6 py-5 text-center text-xs font-black uppercase tracking-wider text-gray-500">
              Categorias
            </th>

            <th class="px-6 py-5 text-center text-xs font-black uppercase tracking-wider text-gray-500">
              Lotes
            </th>

            <th class="px-8 py-5 text-right text-xs font-black uppercase tracking-wider text-gray-500">
              Ações
            </th>

          </tr>

        </thead>

        <!-- BODY -->
        <tbody class="
          divide-y divide-gray-100
          dark:divide-gray-700
        ">

          <% @distances.each do |distance| %>

            <tr class="
              hover:bg-gray-50
              dark:hover:bg-gray-700/40
              transition
            ">

              <!-- DISTÂNCIA -->
              <td class="px-8 py-6">

                <div class="flex items-center gap-4">

                  <div class="
                    flex h-14 w-14
                    items-center justify-center
                    rounded-2xl
                    bg-blue-50
                    text-blue-700
                    font-black
                    text-lg
                  ">
                    <%= distance.km %>K
                  </div>

                  <div>

                    <p class="
                      font-bold
                      text-gray-900
                      dark:text-white
                    ">
                      <%= distance.nome %>
                    </p>

                    <p class="
                      mt-1
                      text-sm
                      text-gray-500
                    ">
                      <%= distance.vagas_total %> vagas totais
                    </p>

                  </div>

                </div>

              </td>

              <!-- OCUPAÇÃO -->
              <td class="px-6 py-6">

                <div class="max-w-[160px] mx-auto">

                  <div class="
                    mb-2
                    flex items-center
                    justify-between
                    text-xs
                    font-semibold
                  ">

                    <span class="px-3 py-1 h-full rounded-full bg-white">
                      <%= distance.vagas_ocupadas %>
                    </span>

                    <span class="px-3 py-1 h-full rounded-full bg-white"> 
                      <%= distance.percentual_ocupacao %>%
                    </span>

                  </div>

                  <div class="
                    h-2.5
                    overflow-hidden
                    rounded-full
                    bg-white
                    dark:bg-gray-700
                  ">

                    <div
                      class="h-full rounded-full bg-white"
                      style="width: <%= distance.percentual_ocupacao %>%">
                    </div>

                  </div>

                </div>

              </td>

              <!-- CATEGORIAS -->
              <td class="px-6 py-6 text-center">

                <%= link_to organizer_distance_categories_path(distance),
                    class: "
                      inline-flex items-center
                      rounded-full
                      bg-green-50
                      px-4 py-2
                      text-sm
                      font-bold
                      text-green-700
                      hover:bg-green-100
                      transition
                    " do %>

                  <%= distance.categories.count %>

                <% end %>

              </td>

              <!-- LOTES -->
              <td class="px-6 py-6 text-center">

                <%= link_to organizer_distance_lots_path(distance),
                    class: "
                      inline-flex items-center
                      rounded-full
                      bg-orange-50
                      px-4 py-2
                      text-sm
                      font-bold
                      text-orange-700
                      hover:bg-orange-100
                      transition
                    " do %>

                  <%= distance.lots.count %>

                <% end %>

              </td>

              <!-- AÇÕES -->
              <td class="px-8 py-6">

                <div class="
                  flex items-center
                  justify-end
                  gap-3
                ">

                  <%= link_to "Visualizar",
                      organizer_distance_path(distance),
                      class: "
                        rounded-xl
                        border
                        px-4 py-2
                        text-sm
                        font-semibold
                        text-blue-600
                        hover:bg-green-50
                        transition
                        dark:border-gray-700
                        dark:text-gray-300
                      " %>

                  <%= link_to "Editar",
                      edit_organizer_distance_path(distance),
                      class: "
                        rounded-xl
                        bg-blue-600
                        px-4 py-2
                        text-sm
                        font-semibold
                        text-white
                        hover:bg-blue-500
                        transition
                      " %>

                </div>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

  <!-- EMPTY STATE -->
  <% if @distances.empty? %>

    <div class="
      rounded-3xl
      border-2 border-dashed
      border-gray-300
      p-16
      text-center
      bg-white
      dark:bg-gray-800
    ">

      <h3 class="
        text-xl
        font-bold
        dark:text-white
      ">
        Nenhuma distância cadastrada
      </h3>

      <p class="
        mt-3
        text-sm
        text-gray-500
      ">
        Crie a primeira distância do evento.
      </p>

      <div class="mt-8">

        <%= link_to "Nova Distância",
            new_organizer_event_distance_path(@event),
            class: primary_button_class %>

      </div>

    </div>

  <% end %>

</div>