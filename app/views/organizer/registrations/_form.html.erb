<%= form_with model: registration_form, url: url,
    data: {
      controller: "dynamic-select",
      dynamic_select_url_value: update_options_organizer_registrations_path
    },
    method: (registration_form.persisted? ? :patch : :post),
    class: "space-y-8" do |f| %>

  <div class="bg-white dark:bg-gray-800 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl p-6 md:p-8">

    <% if registration_form.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-5 mb-6">
        <h3 class="font-semibold text-red-800">Existem erros no formulário</h3>
        <ul class="mt-3 space-y-1 text-sm text-red-700">
          <% registration_form.errors.full_messages.each do |msg| %>
            <li>• <%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6"
         data-controller="maskphone">

      <%# ── Evento ──────────────────────────────────────────────────────── %>
      <div class="sm:col-span-3">
        <%= f.label :event_id, "Evento",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.collection_select :event_id,
              Event.order(:nome), :id, :nome,
              { prompt: "Selecione o Evento" },
              {
                data: {
                  action: "change->dynamic-select#eventChanged",
                  dynamic_select_target: "eventSelect"
                },
                class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                        shadow-sm focus:ring-blue-500 dark:bg-gray-700
                        dark:border-gray-600 dark:text-white sm:text-sm"
              } %>
      </div>

      <%# ── Atleta ──────────────────────────────────────────────────────── %>
      <div class="sm:col-span-3" id="registration_athlete_wrapper">
        <%= f.label :athlete_id, "Atleta",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.collection_select :athlete_id,
              registration_form.athletes_options,
              :id,
              ->(a) { "#{a.nome} — #{a.cpf}" },
              {
                prompt: registration_form.event_id.present? ?
                        "Selecione o Atleta" : "Selecione o Evento primeiro"
              },
              {
                disabled: registration_form.event_id.blank?,
                class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                        shadow-sm focus:ring-blue-500 dark:bg-gray-700
                        dark:border-gray-600 dark:text-white sm:text-sm
                        disabled:opacity-50 disabled:cursor-not-allowed"
              } %>
        <% if registration_form.event_id.present? %>
          <p class="mt-1 text-xs text-gray-400">
            Exibindo apenas atletas sem inscrição ativa neste evento.
          </p>
        <% end %>
      </div>

      <%# ── Distância (depende do evento) ──────────────────────────────── %>
      <div class="sm:col-span-3" id="registration_distance_wrapper">
        <%= f.label :distance_id, "Distância",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.collection_select :distance_id,
              registration_form.distances_options, :id, :nome,
              {
                prompt: registration_form.event_id.present? ?
                        "Selecione a Distância" : "Selecione o Evento primeiro"
              },
              {
                disabled: registration_form.event_id.blank?,
                data: {
                  action: "change->dynamic-select#distanceChanged",
                  dynamic_select_target: "distanceSelect"
                },
                class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                        shadow-sm focus:ring-blue-500 dark:bg-gray-700
                        dark:border-gray-600 dark:text-white sm:text-sm
                        disabled:opacity-50 disabled:cursor-not-allowed"
              } %>
      </div>

      <%# ── Categoria (depende de evento + distância) ───────────────────── %>
      <div class="sm:col-span-3" id="registration_category_wrapper">
        <%= f.label :category_id, "Categoria",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.collection_select :category_id,
              registration_form.categories_options, :id, :nome,
              {
                prompt: registration_form.distance_id.present? ?
                        "Selecione a Categoria" : "Selecione a Distância primeiro"
              },
              {
                disabled: registration_form.distance_id.blank?,
                class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                        shadow-sm focus:ring-blue-500 dark:bg-gray-700
                        dark:border-gray-600 dark:text-white sm:text-sm
                        disabled:opacity-50 disabled:cursor-not-allowed"
              } %>
      </div>

      <%# ── Lote (depende de evento + distância) ───────────────────────── %>
      <div class="sm:col-span-3" id="registration_lot_wrapper">
        <%= f.label :lot_id, "Lote",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.collection_select :lot_id,
              registration_form.lots_options,
              :id,
              ->(l) { "Lote #{l.numero} — #{number_to_currency(l.preco)}" },
              {
                prompt: registration_form.distance_id.present? ?
                        "Selecione o Lote" : "Selecione a Distância primeiro"
              },
              {
                disabled: registration_form.distance_id.blank?,
                class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                        shadow-sm focus:ring-blue-500 dark:bg-gray-700
                        dark:border-gray-600 dark:text-white sm:text-sm
                        disabled:opacity-50 disabled:cursor-not-allowed"
              } %>
      </div>

      <%# ── Número do peito ─────────────────────────────────────────────── %>
      <div class="sm:col-span-2">
        <%= f.label :numero_dorsal, "Número do Peito",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.number_field :numero_dorsal,
              class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                      shadow-sm focus:ring-blue-500 dark:bg-gray-700
                      dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <%# ── Tamanho do kit ──────────────────────────────────────────────── %>
      <div class="sm:col-span-2">
        <%= f.label :tamanho_kit, "Tamanho Camiseta",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.select :tamanho_kit,
              Registration::KIT_SIZES,
              { prompt: "Selecione" },
              class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                      shadow-sm focus:ring-blue-500 dark:bg-gray-700
                      dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <%# ── Status ─────────────────────────────────────────────────────── %>
      <div class="sm:col-span-2">
        <%= f.label :status,
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.select :status,
              Registration.statuses.keys.map { |s| [s.humanize, s] },
              {},
              class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                      shadow-sm focus:ring-blue-500 dark:bg-gray-700
                      dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <%# ── Contato de emergência ───────────────────────────────────────── %>
      <div class="sm:col-span-3">
        <%= f.label :contato_emergencia, "Contato de Emergência",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.text_field :contato_emergencia,
              class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                      shadow-sm focus:ring-blue-500 dark:bg-gray-700
                      dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <%# ── Telefone de emergência ──────────────────────────────────────── %>
      <div class="sm:col-span-3">
        <%= f.label :fone_emergencia, "Telefone de Emergência",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.text_field :fone_emergencia,
              placeholder: "(99) 99999-9999",
              maxlength: "15",
              "data-maskphone-target": "inputPhone",
              "data-action": "keyup->maskphone#addMaskToPhoneFields",
              class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300
                      shadow-sm focus:ring-blue-500 dark:bg-gray-700
                      dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

    </div>
  </div>

  <div class="flex items-center justify-end gap-x-4">
    <%= link_to "Cancelar", organizer_registrations_path,
          class: "text-sm font-semibold text-gray-900 dark:text-white" %>
    <%= f.submit(
          registration_form.persisted? ? "Atualizar Inscrição" : "Salvar Inscrição",
          class: "rounded-md bg-blue-600 px-6 py-2 text-sm font-semibold
                  text-white shadow-sm hover:bg-blue-500 cursor-pointer"
        ) %>
  </div>

<% end %>