<div class="mx-auto max-w-3xl">
  <div class="bg-white dark:bg-gray-800 shadow rounded-xl overflow-hidden">
    <div class="px-6 py-8 border-b dark:border-gray-700 flex justify-between items-center">
      <div>
        <h2 class="text-2xl font-bold dark:text-white"><%= @registration.athlete.nome %></h2>
        <p class="text-blue-500 font-bold">Dorsal #<%= @registration.numero_dorsal %></p>
      </div>
      <div class="text-right">
        <span class="px-3 py-1 rounded-full text-sm font-bold <%= @registration.confirmado? ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
          <%= @registration.status.humanize %>
        </span>
      </div>
    </div>
    
    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Dados da Prova</h3>
        <dl class="space-y-3">
          <div class="flex justify-between">
            <dt class="text-gray-500">Evento:</dt>
            <dd class="font-medium dark:text-gray-300"><%= @registration.event.nome %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-gray-500">Categoria:</dt>
            <dd class="font-medium dark:text-gray-300"><%= @registration.category.nome %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-gray-500">Kit:</dt>
            <dd class="font-medium dark:text-gray-300">Tamanho <%= @registration.tamanho_kit %></dd>
          </div>
        </dl>
      </div>

      <div class="flex flex-col items-center justify-center bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
        
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=<%= @registration.qr_code_hash %>" 
             alt="QR Code" class="w-40 h-40 mx-auto shadow-sm">
    </div>
  </div>
</div>