<div class="mb-8">
  <h1 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight italic uppercase">Visão Geral do Negócio</h1>
  <p class="text-gray-500 font-medium">Bem-vindo, <%= current_organizer.name %>. Resumo operacional de todos os eventos ativos.</p>
</div>

<!-- 1. Grid de Métricas Globais -->
<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-10">
  <%= render "shared/admin/metric_card", title: "Base de Atletas", value: @global_stats[:total_atletas], sub: "Corredores únicos", trend: "neutral" %>
  <%= render "shared/admin/metric_card", title: "Faturamento Total", value: number_to_currency(@global_stats[:faturamento_total]), sub: "Soma de todos os eventos", trend: "up" %>
  
  <%# Card de Fila de Espera %>
  <%= render "shared/admin/metric_card", 
             title: "Fila de Espera", 
             value: @global_stats[:total_waitlist], 
             sub: "Atletas aguardando vaga", 
             trend: @global_stats[:total_waitlist] > 0 ? "up" : "neutral" %>

  <%# Card de Ocupação Geral %>
  <% percent_global = (@global_stats[:vagas_preenchidas].to_f / @global_stats[:vagas_totais] * 100).round(1) rescue 0 %>
  <%= render "shared/admin/metric_card", title: "Ocupação Geral", value: "#{percent_global}%", sub: "#{@global_stats[:vagas_preenchidas]} vagas vendidas", trend: "up" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  
  <!-- COLUNA DA ESQUERDA: Eventos e Detalhes da Fila -->
  <div class="lg:col-span-2 space-y-8">
    
    <!-- Seção: Próximas Largadas -->
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white uppercase tracking-tight">Próximas Largadas</h2>
        <%= link_to "Ver todos os eventos", organizer_events_path, class: "text-xs font-bold text-blue-600 hover:underline" %>
      </div>

      <% @upcoming_events.each do |event| %>
        <div class="bg-white dark:bg-gray-800 rounded-3xl border border-gray-100 dark:border-gray-700 p-6 shadow-sm hover:shadow-md transition group">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="bg-blue-50 dark:bg-blue-900/20 p-3 rounded-2xl text-blue-600 dark:text-blue-400 text-center min-w-[60px] border border-blue-100 dark:border-blue-800">
                <span class="block text-xl font-black leading-none"><%= event.data_largada.day %></span>
                <span class="text-[10px] font-bold uppercase"><%= l event.data_largada, format: "%b" %></span>
              </div>
              <div>
                <h3 class="font-black text-gray-900 dark:text-white text-lg group-hover:text-blue-600 transition"><%= event.nome %></h3>
                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">
                  <%= event.status.humanize %> • <%= event.distances.count %> distâncias
                </p>
              </div>
            </div>
            
            <div class="flex-1 max-w-xs">
              <% total_vagas = event.limite_atletas || 1 %>
              <% confirmed_count = event.registrations.confirmado.count %>
              <% percent = (confirmed_count.to_f / total_vagas * 100).round(0) %>
              <div class="flex justify-between text-[10px] font-bold mb-1.5">
                <span class="text-gray-400 uppercase tracking-widest">Vendas</span>
                <span class="text-blue-600"><%= percent %>%</span>
              </div>
              <div class="w-full bg-gray-100 dark:bg-gray-700 h-2 rounded-full overflow-hidden">
                <div class="bg-blue-600 h-full transition-all duration-1000" style="width: <%= percent %>%"></div>
              </div>
            </div>

            <%= link_to "ABRIR COCKPIT", organizer_event_path(event), class: "bg-gray-900 dark:bg-gray-700 text-white px-5 py-2.5 rounded-xl text-[10px] font-black hover:bg-blue-600 transition shadow-lg text-center" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Seção: Detalhamento da Fila de Espera -->
    <% if @waitlist_by_distance.any? %>
      <div class="bg-orange-50 dark:bg-orange-900/10 rounded-[40px] border border-orange-100 dark:border-orange-900/20 p-8 shadow-inner">
        <div class="flex items-center gap-3 mb-8">
          <div class="p-2.5 bg-orange-500 rounded-xl text-white shadow-lg shadow-orange-200 dark:shadow-none">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-black text-gray-900 dark:text-white uppercase tracking-tighter italic">Demanda Reprimida</h2>
            <p class="text-xs text-orange-600 font-bold uppercase tracking-widest">Atletas aguardando novas vagas</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @waitlist_by_distance.each do |item| %>
            <div class="bg-white dark:bg-gray-800 p-5 rounded-[24px] flex items-center justify-between border border-orange-200/50 dark:border-orange-800/30 shadow-sm hover:scale-[1.02] transition-transform">
              <div class="min-w-0">
                <p class="text-[9px] font-black text-orange-500 uppercase tracking-widest leading-none mb-1.5 truncate"><%= item.event_name %></p>
                <p class="text-sm font-bold text-gray-700 dark:text-gray-300 uppercase leading-none italic"><%= item.distance_name %></p>
              </div>
              <div class="text-right ml-4">
                <span class="text-3xl font-black text-gray-900 dark:text-white leading-none"><%= item.total %></span>
                <p class="text-[8px] font-black text-gray-400 uppercase tracking-tighter">Atletas</p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

  <!-- COLUNA DA DIREITA: Atividades Recentes -->
  <div class="space-y-6">
    <div class="bg-white dark:bg-gray-800 rounded-[32px] border border-gray-100 dark:border-gray-700 p-6 shadow-sm overflow-hidden">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 uppercase tracking-tight">Últimas Inscrições</h2>
      <div class="flow-root">
        <ul class="-my-5 divide-y divide-gray-100 dark:divide-gray-700">
          <% @recent_registrations.each do |reg| %>
            <li class="py-5">
              <div class="flex items-center space-x-4">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-black text-gray-900 dark:text-white truncate uppercase italic">
                    <%= reg.athlete.nome %>
                  </p>
                  <p class="text-[10px] text-gray-500 truncate font-bold uppercase tracking-widest">
                    Evento: <span class="text-blue-600"><%= reg.event.nome %></span>
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-[9px] font-black text-gray-400 uppercase"><%= time_ago_in_words(reg.created_at) %> atrás</p>
                  <span class="text-xs font-black text-green-600"><%= number_to_currency(reg.payment&.valor || 0) %></span>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
      
      <div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-700">
        <%= link_to "Ver base de atletas →", organizer_athletes_path, class: "block text-center text-[10px] font-black text-gray-400 hover:text-blue-600 uppercase tracking-widest transition" %>
      </div>
    </div>
  </div>

</div>