<%= form_with model: [:organizer, volunteer_form], url: url,
                      method: (volunteer_form.persisted? ? :patch : :post), class: "space-y-8" do |f| %>

  <% if volunteer_form.errors.any? %>
      <div class=" mb-8 rounded-2xl border border-red-200 bg-red-50 p-6" >
        <h3 class=" text-sm font-bold text-red-700 mb-3 ">
          Corrija os erros abaixo
        </h3>

        <ul class=" list-disc ml-5 text-sm text-red-600 ">
          <% volunteer_form.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <div class="bg-white dark:bg-gray-800 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl p-6 md:p-8" data-controller="maskphone">
    
    <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
      <div class="sm:col-span-4">
        <%= f.label :nome, "Nome Completo", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.text_field :nome, class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <div class="sm:col-span-3">
        <%= f.label :email, "E-mail de Contato", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.email_field :email, class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <div class="sm:col-span-3">
        <%= f.label :telefone, "WhatsApp / Celular", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.text_field :telefone, placeholder: "(99) 99999-9999",  maxlength: "15",
                                  "data-maskphone-target": "inputPhone", 
                                  "data-action": "keyup->maskphone#addMaskToPhoneFields",
            class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>

      <div class="sm:col-span-3">
        <%= f.label :funcao_preferida, "Função Preferida", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.select :funcao_preferida, 
            ["Hidratação", "Sinalização de Percurso", "Entrega de Kits", "Guarda-volumes", "Pós-Prova (Medalhas)", "Secretaria/Check-in", "Apoio Médico"], 
            { include_blank: "Selecione uma preferência" }, 
            class: "mt-1 block w-full rounded-md px-3 py-1 border-gray-300 shadow-sm focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm" %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-x-4">
    <%= link_to "Cancelar", organizer_volunteers_path, class: "text-sm font-semibold text-gray-900 dark:text-white" %>
    <%= f.submit "Salvar Voluntário", class: "rounded-md bg-blue-600 px-6 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
  </div>
<% end %>