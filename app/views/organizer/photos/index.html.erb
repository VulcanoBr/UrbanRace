<%# app/views/organizer/photos/index.html.erb %>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold dark:text-white">Galeria de Fotos</h1>
    <p class="text-sm text-gray-500">
      Fotos de atletas passam por IA para identificar dorsais.
      Fotos do evento são salvas diretamente.
    </p>
  </div>
</div>

<%# ── Resumo ──────────────────────────────────────────────────────── %>
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 border dark:border-gray-700 text-center">
    <p class="text-2xl font-black dark:text-white"><%= @resumo[:total_atletas] %></p>
    <p class="text-xs text-gray-500 mt-1">Fotos de atletas</p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 border dark:border-gray-700 text-center">
    <p class="text-2xl font-black text-green-600"><%= @resumo[:identificadas] %></p>
    <p class="text-xs text-gray-500 mt-1">Identificadas pela IA</p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 border dark:border-gray-700 text-center">
    <p class="text-2xl font-black text-amber-500"><%= @resumo[:pendentes] %></p>
    <p class="text-xs text-gray-500 mt-1">Aguardando IA</p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 border dark:border-gray-700 text-center">
    <p class="text-2xl font-black text-blue-600"><%= @resumo[:total_evento] %></p>
    <p class="text-xs text-gray-500 mt-1">Fotos do evento</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

  <%# ── Sidebar: dois formulários independentes ─────────────────── %>
  <div class="lg:col-span-1 space-y-4">

    <%# Formulário 1: Fotos de atletas (com IA) %>
    <div class="bg-white dark:bg-gray-800 p-6 rounded-3xl border-2 border-dashed border-blue-300 dark:border-blue-700">
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-blue-500 flex-shrink-0"></span>
        <h3 class="font-bold text-sm dark:text-white">Fotos de Atletas</h3>
      </div>
      <p class="text-xs text-gray-400 mb-4">A IA detecta o dorsal e associa ao atleta.</p>

      <%# IMPORTANTE: form_with model: @form_atleta — objeto dedicado %>
      <%# Sem reutilizar @upload_form nos dois forms (causa o card em branco) %>
      <%= form_with model: @form_atleta,
            url: bulk_upload_organizer_event_photos_path(@event),
            multipart: true,
            class: "space-y-3" do |f| %>

        <%= f.hidden_field :tipo, value: "atleta" %>

        <%= f.file_field :files,
              multiple: true,
              accept: "image/*",
              class: "block w-full text-xs text-gray-500
                      file:mr-3 file:py-2 file:px-3
                      file:rounded-full file:border-0
                      file:text-xs file:font-semibold
                      file:bg-blue-50 file:text-blue-700
                      hover:file:bg-blue-100" %>

        <% if @form_atleta.errors[:files].any? %>
          <p class="text-xs text-red-500"><%= @form_atleta.errors[:files].first %></p>
        <% end %>

        <%= f.submit "Processar com IA",
              class: "w-full bg-blue-600 text-white py-2.5 rounded-xl
                      font-black text-xs hover:bg-blue-700 cursor-pointer" %>
      <% end %>
    </div>

    <%# Formulário 2: Fotos do evento (sem IA) %>
    <div class="bg-white dark:bg-gray-800 p-6 rounded-3xl border-2 border-dashed border-gray-300 dark:border-gray-700">
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-gray-400 flex-shrink-0"></span>
        <h3 class="font-bold text-sm dark:text-white">Fotos do Evento</h3>
      </div>
      <p class="text-xs text-gray-400 mb-4">Bastidores, largada, chegada, pódio — sem IA.</p>

      <%# Objeto separado: @form_evento %>
      <%= form_with model: @form_evento,
            url: bulk_upload_organizer_event_photos_path(@event),
            multipart: true,
            class: "space-y-3" do |f| %>

        <%= f.hidden_field :tipo, value: "evento" %>

        <%= f.file_field :files,
              multiple: true,
              accept: "image/*",
              class: "block w-full text-xs text-gray-500
                      file:mr-3 file:py-2 file:px-3
                      file:rounded-full file:border-0
                      file:text-xs file:font-semibold
                      file:bg-gray-100 file:text-gray-600
                      hover:file:bg-gray-200" %>

        <% if @form_evento.errors[:files].any? %>
          <p class="text-xs text-red-500"><%= @form_evento.errors[:files].first %></p>
        <% end %>

        <%= f.submit "Salvar fotos",
              class: "w-full bg-gray-700 text-white py-2.5 rounded-xl
                      font-black text-xs hover:bg-gray-800 cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <%# ── Grade de Fotos ──────────────────────────────────────────── %>
  <div class="lg:col-span-3 space-y-8">

    <%# Fotos de atletas %>
    <% if @photos_atletas.any? %>
      <div>
        <h2 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-4">
          Fotos de atletas (<%= @resumo[:total_atletas] %>)
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4"
             id="photos_atletas">
          <% @photos_atletas.each do |photo| %>
            <%= render "photo_card", photo: photo, event: @event %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Fotos do evento %>
    <% if @photos_evento.any? %>
      <div>
        <h2 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-4">
          Fotos do evento (<%= @resumo[:total_evento] %>)
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">
          <% @photos_evento.each do |photo| %>
            <%= render "photo_card", photo: photo, event: @event %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @photos_atletas.empty? && @photos_evento.empty? %>
      <div class="text-center py-20 text-gray-400">
        <p class="text-5xl mb-4">📷</p>
        <p class="font-semibold">Nenhuma foto enviada ainda.</p>
        <p class="text-sm mt-1">Use os formulários ao lado para fazer o upload.</p>
      </div>
    <% end %>

  </div>
</div>
