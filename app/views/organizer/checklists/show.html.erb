

<div class="max-w-5xl mx-auto py-8 px-4">
  <div class="mb-10">
    <h1 class="text-3xl font-black text-gray-900 dark:text-white">Checklist Operacional</h1>
    <p class="text-gray-500">Cronograma de entregas e regularização legal do evento <%= @event.nome %></h2>.</p>
  </div>

  <!-- SEÇÃO 1: ENTREGAS DE FORNECEDORES -->
  <section class="mb-16">
    <h2 class="flex items-center gap-2 text-lg font-bold text-gray-700 dark:text-gray-300 mb-6 uppercase tracking-wider">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.806H14.25M16.5 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
      Logística e Fornecedores
    </h2>

    <div class="space-y-4">
      <% if @entregas.any? %>
        <% @entregas.each do |entrega| %>
          <div class="flex items-center gap-4 p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 rounded-full flex items-center justify-center <%= entrega.status == 'completed' ? 'bg-green-100 text-green-600' : 'bg-blue-100 text-blue-600' %>">
                <% if entrega.status == 'completed' %>
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg>
                <% else %>
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <% end %>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-bold text-gray-900 dark:text-white truncate"><%= entrega.descricao %></p>
              <p class="text-xs text-gray-500">Fornecedor: <%= entrega.supplier_contract.supplier.razao_social %></p>
            </div>
            <div class="text-right">
              <p class="text-xs font-mono font-bold text-blue-600"><%= l entrega.data_prevista %></p>
              <span class="text-[10px] font-black uppercase"><%= entrega.status.humanize %></span>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-400 italic">Nenhuma entrega de fornecedor agendada.</p>
      <% end %>
    </div>
  </section>

  <!-- SEÇÃO 2: LICENÇAS GOVERNAMENTAIS -->
  <section>
    <h2 class="flex items-center gap-2 text-lg font-bold text-gray-700 dark:text-gray-300 mb-6 uppercase tracking-wider">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
      Licenças e Alvarás
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% if @licencas.any? %>
        <% @licencas.each do |licenca| %>
          <div class="p-5 bg-white dark:bg-gray-800 rounded-2xl border-2 <%= licenca.status == 'approved' ? 'border-green-100 dark:border-green-900/30' : 'border-gray-100 dark:border-gray-700' %> shadow-sm">
            <div class="flex justify-between items-start mb-4">
              <div>
                <p class="font-black text-gray-900 dark:text-white leading-tight"><%= licenca.tipo %></p>
                <p class="text-xs text-gray-500 uppercase font-bold mt-1"><%= licenca.orgao %></p>
              </div>
              <span class="px-2 py-1 rounded text-[10px] font-black uppercase border <%= license_status_classes(licenca.status) %>">
                <%= licenca.status.humanize %>
              </span>
            </div>
            
            <div class="flex items-center justify-between mt-6 pt-4 border-t border-gray-50 dark:border-gray-700">
              <div class="text-[10px] text-gray-400">
                <p class="font-bold">PRAZO LIMITE</p>
                <p class="text-sm font-mono font-bold text-gray-700 dark:text-gray-300"><%= l licenca.prazo_aprovacao %></p>
              </div>
              
              <% if licenca.documento_pdf.attached? %>
                <%= link_to url_for(licenca.documento_pdf), target: "_blank", class: "text-blue-600 hover:text-blue-800 p-2 bg-blue-50 rounded-lg transition" do %>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="col-span-full p-8 text-center bg-gray-50 dark:bg-gray-900/50 rounded-3xl border-2 border-dashed">
          <p class="text-gray-400 italic">Nenhuma licença cadastrada para este evento.</p>
          <%= link_to "Configurar Licenças", organizer_event_licenses_path(@event), class: "text-blue-600 font-bold text-sm hover:underline mt-2 inline-block" %>
        </div>
      <% end %>
    </div>
  </section>
</div>