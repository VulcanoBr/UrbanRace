<div class="max-w-5xl mx-auto">

  <div class="mb-10">

    <p class="
      text-sm
      font-semibold
      text-blue-600
      mb-2
    ">
      <%= @category.distance.nome %>
    </p>

    <h1 class="
      text-4xl
      font-black
      tracking-tighter
      dark:text-white
    ">
      Editar Categoria
    </h1>

  </div>

  <%= render "form",
      category_form: @category_form,
      url: organizer_category_path(@category),
      submit_label: "Salvar Alterações" %>

</div>