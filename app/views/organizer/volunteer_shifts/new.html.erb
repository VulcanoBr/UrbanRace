<%# app/views/organizer/volunteer_shifts/new.html.erb %>
<div class="mx-auto max-w-3xl">
  <!-- Navegação superior -->
  <nav class="mb-4" aria-label="Back">
    <%= link_to organizer_event_volunteer_station_volunteer_shifts_path(@event, @station), class: "flex items-center text-sm font-bold text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition" do %>
      <svg class="mr-1 h-5 w-5 flex-shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
      </svg>
      Voltar para Lista de Equipe
    <% end %>
  </nav>

  <!-- Cabeçalho -->
  <div class="mb-8">
    <h2 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight">Escalar Voluntário</h2>
    <div class="mt-2 flex flex-wrap gap-2 items-center text-sm">
      <span class="text-gray-500 dark:text-gray-400">Posto:</span>
      <span class="font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20 px-2 py-0.5 rounded"><%= @station.nome %></span>
      <span class="text-gray-300 dark:text-gray-600">|</span>
      <span class="text-gray-500 dark:text-gray-400"><%= @event.nome %></span>
    </div>
  </div>

  <%# Renderiza o partial _form com a URL de criação %>
  <%= render "form", shift_form: @shift_form, url: organizer_event_volunteer_station_volunteer_shifts_path(@event, @station) %>
</div>