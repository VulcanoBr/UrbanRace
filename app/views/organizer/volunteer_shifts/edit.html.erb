<%# app/views/organizer/volunteer_shifts/edit.html.erb %>
<div class="mx-auto max-w-3xl">
  <!-- Navegação superior -->
  <nav class="mb-4" aria-label="Back">
    <%= link_to organizer_event_volunteer_station_volunteer_shifts_path(@event, @station), class: "flex items-center text-sm font-bold text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition" do %>
      <svg class="mr-1 h-5 w-5 flex-shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
      </svg>
      Voltar para Lista de Equipe
    <% end %>
  </nav>

  <!-- Cabeçalho com botão de remoção rápida -->
  <div class="md:flex md:items-center md:justify-between mb-8">
    <div class="min-w-0 flex-1">
      <h2 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight">Editar Escala</h2>
      <p class="mt-2 text-gray-500 dark:text-gray-400 font-medium">
        Alterando participação de: <span class="text-gray-900 dark:text-white underline decoration-blue-500 underline-offset-4"><%= @shift.volunteer.nome %></span>
      </p>
    </div>
    
    <div class="mt-4 flex md:ml-4 md:mt-0">
      <%= button_to organizer_event_volunteer_station_volunteer_shift_path(@event, @station, @shift), 
                    method: :delete, 
                    data: { turbo_confirm: "Deseja remover este voluntário desta escala? Esta ação não apaga o cadastro dele, apenas retira deste posto." },
                    class: "inline-flex items-center rounded-xl bg-white px-4 py-2 text-sm font-bold text-red-600 shadow-sm ring-1 ring-inset ring-red-200 hover:bg-red-50 dark:bg-gray-800 dark:ring-red-900/50 dark:text-red-400 transition" do %>
        <svg class="-ml-1 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Remover Escala
      <% end %>
    </div>
  </div>

  <%# Renderiza o partial _form com a URL de atualização (PATCH) %>
  <%= render "form", shift_form: @shift_form, url: organizer_event_volunteer_station_volunteer_shift_path(@event, @station, @shift) %>
</div>