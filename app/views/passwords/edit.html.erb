<div class="min-h-screen flex bg-white dark:bg-gray-900">

  <!-- LADO ESQUERDO -->
  <div class="flex-1 flex flex-col justify-center py-12 px-4 sm:px-6 lg:flex-none lg:w-1/2 xl:px-24">

    <div class="mx-auto w-full max-w-md">

      <!-- Logo Mobile -->
      <div class="flex justify-center mb-8 lg:hidden">
        <%= image_tag "logo_urbanrace_3d.png",
              class: "h-16 w-auto",
              alt: "UrbanRace" %>
      </div>

      <div class="mb-8">

        <h1 class="text-3xl font-black uppercase text-gray-900 dark:text-white">
          Criar nova senha
        </h1>

        <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
          Escolha uma senha forte para proteger sua conta.
        </p>

      </div>

      <%= form_with model: @user,
                    url: password_path(params[:token]),
                    method: :patch, scope: :user,
                    data: {
                      turbo: false,
                      controller: "password-strength"
                    },
                    class: "space-y-8" do |f| %>

        <% if @user.errors.any? %>

          <div class="rounded-2xl bg-red-50 border border-red-200 p-5">

            <h3 class="font-bold text-red-700 mb-2">
              Não foi possível alterar sua senha
            </h3>

            <ul class="text-sm text-red-600 space-y-1">

              <% @user.errors.full_messages.each do |msg| %>

                <li>• <%= msg %></li>

              <% end %>

            </ul>

          </div>

        <% end %>

        <!-- NOVA SENHA -->

        <div>

          <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
            Nova senha
          </label>

          <div class="relative">

            <%= f.password_field :password,
                  autocomplete: "new-password",
                  data: {
                    password_strength_target: "password",
                    action: "input->password-strength#analyze"
                  },
                  class: "block w-full rounded-xl border-gray-300 py-3 pr-14 focus:ring-blue-600 focus:border-blue-600 dark:bg-gray-800 dark:border-gray-700 dark:text-white" %>

             <button
              type="button"
              data-action="password-strength#toggleVisibility"
              data-password-target="password"
              class="absolute inset-y-0 right-0 px-4 flex items-center text-gray-400 hover:text-blue-600">

              👁

            </button>

          </div>

        </div>

        <!-- BARRA -->

        <div>

          <div class="w-full h-3 rounded-full bg-gray-200 overflow-hidden">

            <div

              data-password-strength-target="progress"

              class="h-full rounded-full transition-all duration-300"

              style="width:0%;">

            </div>

          </div>

          <p

            data-password-strength-target="level"

            class="mt-2 text-sm font-bold text-gray-500">

            Digite uma senha

          </p>

        </div>

        <!-- REQUISITOS -->

        <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-5">

          <h3 class="font-bold text-gray-700 dark:text-gray-200 mb-4">
            Sua senha deve conter:
          </h3>

          <ul class="space-y-2 text-sm">

            <li
              data-password-strength-target="length"
              class="text-gray-500">

              ○ Pelo menos 8 caracteres

            </li>

            <li
              data-password-strength-target="uppercase"
              class="text-gray-500">

              ○ Uma letra maiúscula

            </li>

            <li
              data-password-strength-target="lowercase"
              class="text-gray-500">

              ○ Uma letra minúscula

            </li>

            <li
              data-password-strength-target="number"
              class="text-gray-500">

              ○ Um número

            </li>

            <li
              data-password-strength-target="special"
              class="text-gray-500">

              ○ Um caractere especial

            </li>

          </ul>

        </div>

        <!-- CONFIRMAR -->

        <div>

          <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
            Confirmar senha
          </label>

          <div class="relative">

            <%= f.password_field :password_confirmation,

                  autocomplete: "new-password",

                  data: {

                    password_strength_target: "confirmation",

                    action: "input->password-strength#compare"

                  },

                  class: "block w-full rounded-xl border-gray-300 py-3 pr-14 focus:ring-blue-600 focus:border-blue-600 dark:bg-gray-800 dark:border-gray-700 dark:text-white" %>

            <button
              type="button"
              data-action="password-strength#toggleVisibility"
              data-password-target="confirmation"
              class="absolute inset-y-0 right-0 px-4 flex items-center text-gray-400 hover:text-blue-600">

              👁

            </button>

          </div>

        </div>

        <!-- CONFIRMAÇÃO -->

        <div>

          <p

            data-password-strength-target="match"

            class="text-sm font-bold text-gray-500">

            As senhas devem coincidir

          </p>

        </div>

        <!-- BOTÕES -->

        <div class="space-y-3">

          <%= f.submit "ALTERAR SENHA",

                disabled: true,

                data: {

                  password_strength_target: "submit"

                },

                class: "w-full rounded-xl bg-green-700 py-4 text-sm font-black uppercase tracking-widest text-white disabled:bg-gray-300 disabled:cursor-not-allowed hover:bg-green-800 transition" %>

          <%= link_to "Cancelar",

                new_session_path,

                class: "flex justify-center rounded-xl border border-gray-300 py-4 text-sm font-bold uppercase tracking-widest text-gray-500 hover:bg-gray-100 transition" %>

        </div>

      <% end %>

    </div>

  </div>

  <!-- LADO DIREITO -->

  <div class="hidden lg:flex lg:flex-1 relative items-center justify-center bg-green-800 overflow-hidden">

    <div class="absolute inset-0 bg-gradient-to-br from-green-800 to-blue-950"></div>

    <div class="relative z-10 text-center">

      <%= image_tag "logotipo_urbanrace.png",
            class: "max-w-md mx-auto drop-shadow-2xl" %>

      <p class="mt-10 text-blue-100 text-lg max-w-md">

        Sua segurança é nossa prioridade.

        Escolha uma senha forte para manter sua conta protegida.

      </p>

    </div>

  </div>

</div>