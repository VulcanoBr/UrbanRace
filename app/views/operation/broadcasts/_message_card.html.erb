<%# 
  Partial de Card de Mensagem para a Operação (Staff)
  Inclui a funcionalidade de confirmação de leitura em tempo real.
%>

<div id="<%= dom_id(message) %>" 
     class="p-5 rounded-[32px] border-l-[10px] shadow-md bg-white dark:bg-slate-900 transition-all duration-500 animate-in fade-in slide-in-from-top-4 
            <%= broadcast_theme(message.categoria) %>">
  
  <%# 1. Cabeçalho: Ícone, Hora e Local %>
  <div class="flex justify-between items-start mb-4">
    <div class="flex items-center gap-3">
      <div class="p-2 rounded-xl bg-white/50 shadow-sm">
        <%= broadcast_icon(message.categoria) %>
      </div>
      <div>
        <span class="text-[10px] font-black uppercase tracking-widest opacity-70 block leading-none">
          <%= message.sent_at&.strftime("%H:%M") || Time.current.strftime("%H:%M") %>
        </span>
        <span class="text-[10px] font-bold uppercase opacity-80">
          📍 <%= message.volunteer_station&.nome || "POSTO GERAL" %>
        </span>
      </div>
    </div>

    <%# Badge de Urgência %>
    <% if message.urgente? || message.categoria == "critical" %>
      <span class="flex h-3 w-3 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-red-600"></span>
      </span>
    <% end %>
  </div>

  <%# 2. Conteúdo: Título e Mensagem %>
    <h4 class="font-black text-lg leading-tight mb-2 uppercase italic tracking-tighter text-slate-900 dark:text-white">
      <%= message.titulo %>
    </h4>
    <p class="text-sm leading-relaxed opacity-90 font-bold text-slate-700 dark:text-slate-300">
      <%= message.corpo %>
    </p>
    
    <%# 3. Rodapé: Nome do Coordenador e Botão de Confirmação %>
    <div class="mt-5 pt-4 border-t border-black/5 flex justify-between items-center">
    <span class="text-[9px] font-black uppercase tracking-widest opacity-40">
      COORDENAÇÃO: <%= message.sender.name %>
    </span>

    <%# Container do botão - adicione 'flex' para alinhar melhor o texto de confirmação %>
    <div id="<%= dom_id(message, :button) %>" class="flex items-center">
      <% if message.lida_em.present? %>
        <span class="text-[9px] font-black text-green-600 uppercase">Confirmado ✓</span>
      <% else %>
        <%= button_to confirm_operation_event_broadcast_path(@event, message), 
                      method: :post,
                      class: "text-[10px] font-black uppercase bg-slate-900 text-white hover:bg-orange-600 px-4 py-2 rounded-xl shadow-lg transition-all cursor-pointer" do %>
          OK, CIENTE
        <% end %>
      <% end %>
    </div>
  </div>
</div>