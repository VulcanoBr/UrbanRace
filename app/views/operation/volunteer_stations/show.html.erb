<div class="grid grid-cols-2 gap-4 mt-8">
  <h3 class="col-span-2 text-sm font-bold text-gray-500 uppercase">Solicitar Recursos</h3>
  
  <%= button_to "FALTA ÁGUA", operation_resource_requests_path(volunteer_station_id: @station.id, item: "Água"), 
      method: :post, class: "bg-blue-100 text-blue-700 p-4 rounded-xl font-bold active:bg-blue-200" %>
      
  <%= button_to "FALTA GELO", operation_resource_requests_path(volunteer_station_id: @station.id, item: "Gelo"), 
      method: :post, class: "bg-cyan-100 text-cyan-700 p-4 rounded-xl font-bold active:bg-cyan-200" %>

  <%= button_to "MAIS FRUTAS", operation_resource_requests_path(volunteer_station_id: @station.id, item: "Frutas"), 
      method: :post, class: "bg-green-100 text-green-700 p-4 rounded-xl font-bold active:bg-green-200" %>
</div>