<div class="space-y-4">
  <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
    <h1 class="text-xl font-black text-slate-900 mb-4">ENTREGA DE KIT</h1>
    
    <%= form_with url: operation_event_kit_deliveries_path(@event), method: :get, class: "flex gap-2" do |f| %>
      <%= f.text_field :query, value: params[:query], placeholder: "Nome, CPF ou Dorsal", 
          class: "flex-1 rounded-xl border-slate-200 text-sm focus:ring-blue-500 focus:border-blue-500" %>
      <%= f.submit "BUSCAR", class: "bg-slate-900 text-white px-4 rounded-xl text-[10px] font-black" %>
    <% end %>
  </div>

  <div class="space-y-2">
    <% @registrations.each do |reg| %>
      <%= link_to operation_event_kit_delivery_path(@event, reg), 
          class: "block bg-white p-4 rounded-2xl border border-slate-200 active:bg-slate-50 transition-colors" do %>
        <div class="flex justify-between items-start">
          <div>
            <p class="text-xs font-black text-slate-900 uppercase"><%= reg.athlete.nome %></p>
            <p class="text-[10px] text-slate-500 font-bold uppercase"><%= reg.distance.nome %> • TAM: <%= reg.tamanho_kit %></p>
          </div>
          <% if reg.kit_entregue? %>
             <span class="bg-green-100 text-green-700 text-[8px] font-black px-2 py-1 rounded-full">ENTREGUE</span>
          <% else %>
             <span class="bg-blue-100 text-blue-700 text-[8px] font-black px-2 py-1 rounded-full">PENDENTE</span>
          <% end %>
        </div>
        <div class="mt-2 flex items-center justify-between">
           <span class="text-[10px] text-slate-400 font-mono">CPF: <%= format_cpf(reg.athlete.cpf) %></span>
           <span class="text-[10px] font-black text-slate-900">#<%= reg.numero_dorsal %></span>
        </div>
      <% end %>
    <% end %>
    
    <% if @registrations.empty? && params[:query].present? %>
      <div class="text-center py-10">
        <p class="text-sm text-slate-500 font-bold">Nenhum atleta encontrado.</p>
      </div>
    <% end %>
  </div>

  <% if @registrations.total_pages > 1 %>
    <div class="py-6 flex justify-center">
      <div class="bg-white px-4 py-2 rounded-full shadow-sm border border-slate-200">
        <%= paginate @registrations, window: 1 %>
      </div>
    </div>
  <% end %>
  
</div>