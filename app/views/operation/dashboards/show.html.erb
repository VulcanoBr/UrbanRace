<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 h-[calc(100vh-120px)]">
  <div class="fixed bottom-24 right-4 z-50">
      <%= link_to new_operation_event_incident_path(@event), 
          class: "bg-red-600 text-white p-4 rounded-full shadow-2xl flex items-center justify-center animate-bounce" do %>
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
      <% end %>
  </div>
  <!-- Coluna 1: Ranking ao Vivo (EX-08) -->
  <div class="bg-black text-green-400 p-6 rounded-2xl shadow-xl overflow-hidden flex flex-col">
    <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
      </span>
      Líderes em Prova
    </h3>
    
    <div id="live_ranking_list" class="flex-1 overflow-y-auto font-mono text-sm">
      <%= turbo_stream_from "ranking_event_#{@event.id}" %>
      <%= render "ranking_table", results: @results %>
    </div>
  </div>

  <!-- Coluna 2: Status dos Postos (EX-04) -->
  <div class="bg-white p-6 rounded-2xl border shadow-sm flex flex-col">
    <h3 class="font-bold text-gray-900 mb-4">Monitoramento de Postos</h3>
    <div class="space-y-4 flex-1 overflow-y-auto">
      <% @event.volunteer_stations.each do |station| %>
        <div class="p-3 bg-gray-50 rounded-lg flex justify-between items-center">
          <div>
            <p class="font-bold text-sm"><%= station.nome %></p>
            <p class="text-xs text-gray-500">KM <%= station.km_posicao %></p>
          </div>
          <div class="text-right">
            <p class="text-xs font-bold text-blue-600"><%= station.athlete_checkins.count %> passagens</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Coluna 3: Alertas e Incidentes (EX-12) -->
  <div class="bg-red-50 p-6 rounded-2xl border border-red-100 flex flex-col">
    <h3 class="font-bold text-red-800 mb-4 flex justify-between">
      Ocorrências Ativas
      <span class="bg-red-200 px-2 py-0.5 rounded text-xs"><%= @incidents.count %></span>
    </h3>
    <div id="incidents_list" class="space-y-3 flex-1 overflow-y-auto">
      <%= turbo_stream_from "command_center_event_#{@event.id}" %>
      <% @incidents.each do |incident| %>
        <%= render "operation/incidents/incident_alert", incident: incident %>
      <% end %>
    </div>
  </div>

  <div class="max-w-md mx-auto py-6 px-4">
  
  <!-- Canal Solid Cable / Turbo Stream -->
    <%= turbo_stream_from "event_#{@event.id}_broadcasts" %>

    <div id="broadcast_alerts_list" class="space-y-4">
      <!-- Aqui as mensagens novas "caem" sozinhas via Turbo -->
      <% @event.broadcast_messages.where("sent_at > ?", 2.hours.ago).each do |msg| %>
        <%= render "operation/broadcasts/message_card", message: msg %>
      <% end %>
    </div>
    
  </div>

</div>