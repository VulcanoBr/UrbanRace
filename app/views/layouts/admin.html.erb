<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>UrbanRace Admin</title>

    <meta name="viewport"
          content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application",
        "data-turbo-track": "reload" %>

    <%= javascript_include_tag "application",
        type: "module",
        "data-turbo-track": "reload" %>
  </head>

  <body class="
    min-h-screen
    bg-gray-50
    dark:bg-gray-900
    flex
  ">

    <%# Sidebar Desktop %>
    <%= render "shared/admin/sidebar_desktop" %>

    <div class="flex-1 flex flex-col">

      <%# Topbar %>
      <%= render "shared/admin/topbar" %>

      <main class="flex-1 p-6 lg:p-8">
        <div class="max-w-7xl mx-auto">
          <%= render "shared/flash" %> <%# ADICIONE ESTA LINHA AQUI %>
          <%= yield %>
        </div>
      </main>

    </div>
    <%= render "shared/confirm_modal" %>
  </body>
</html>