<div class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-black mb-8 text-gray-900">Minhas Fotos 📸</h1>

  <% if @photo_registrations.any? %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <% @photo_registrations.each do |reg_photo| %>
        <div class="relative group aspect-square overflow-hidden rounded-3xl bg-gray-100 shadow-sm border border-gray-200">
          
          <%# Imagem da Foto %>
          <%= image_tag reg_photo.photo.arquivo, 
                        class: "object-cover w-full h-full group-hover:scale-110 transition duration-700" %>

          <%# Nome do Evento (Sempre Visível) %>
          <div class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
            <p class="text-[10px] font-black text-white uppercase tracking-widest truncate">
              <%= reg_photo.photo.event.nome %>
            </p>
          </div>

          <%# Overlay de Download (Aparece no Hover) %>
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition duration-300 flex items-center justify-center backdrop-blur-[2px]">
            <%= link_to rails_blob_path(reg_photo.photo.arquivo, disposition: "attachment"), 
                        class: "bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-xl font-black text-[10px] tracking-widest shadow-xl transform scale-90 group-hover:scale-100 transition duration-300" do %>
              DOWNLOAD HD
            <% end %>
          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-24 bg-gray-50 rounded-[40px] border-2 border-dashed border-gray-200">
      <div class="text-5xl mb-4">⏳</div>
      <p class="text-gray-500 font-bold uppercase tracking-widest text-xs">
        A IA ainda está processando as fotos dos seus eventos.
      </p>
      <p class="text-gray-400 text-xs mt-2">Assim que identificarmos seu dorsal, as fotos aparecerão aqui automaticamente.</p>
    </div>
  <% end %>
</div>