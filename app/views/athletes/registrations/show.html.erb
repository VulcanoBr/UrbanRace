
<div class="max-w-5xl mx-auto space-y-6">

  <!-- ================================================================
       CABEÇALHO DA INSCRIÇÃO
       ================================================================ -->

  <div class="bg-white dark:bg-gray-800 rounded-[32px] shadow-xl border border-gray-200 dark:border-gray-700 overflow-hidden">

    <div class="p-8">
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">

        <div>
          <p class="text-xs font-black uppercase tracking-widest text-blue-600">
            Minha inscrição
          </p>

          <h1 class="mt-2 text-2xl md:text-3xl font-black text-gray-900 dark:text-white">
            <%= @registration.event.nome %>
          </h1>

          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
            Inscrição #<%= @registration.id %>
          </p>
        </div>

        <% if @registration.numero_dorsal.present? %>
          <div class="text-center">
            <p class="text-xs font-bold uppercase tracking-widest text-gray-400">
              Dorsal
            </p>

            <p class="mt-1 text-4xl font-black text-blue-600">
              <%= @registration.numero_dorsal %>
            </p>
          </div>
        <% end %>

      </div>
    </div>


    <!-- ================================================================
         DADOS DA INSCRIÇÃO
         ================================================================ -->

    <div class="border-t border-gray-100 dark:border-gray-700">

      <dl class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">

        <!-- Atleta -->
        <div class="p-6 border-b md:border-r border-gray-100 dark:border-gray-700">

          <dt class="text-xs font-bold uppercase tracking-wider text-gray-400">
            Atleta
          </dt>

          <dd class="mt-2 font-semibold text-gray-900 dark:text-white">
            <%= @registration.athlete.nome %>
          </dd>

        </div>


        <!-- Distância -->
        <div class="p-6 border-b lg:border-r border-gray-100 dark:border-gray-700">

          <dt class="text-xs font-bold uppercase tracking-wider text-gray-400">
            Distância
          </dt>

          <dd class="mt-2 font-semibold text-gray-900 dark:text-white">
            <%= @registration.distance.nome %>
          </dd>

        </div>


        <!-- Categoria -->
        <div class="p-6 border-b md:border-r lg:border-r border-gray-100 dark:border-gray-700">

          <dt class="text-xs font-bold uppercase tracking-wider text-gray-400">
            Categoria
          </dt>

          <dd class="mt-2 font-semibold text-gray-900 dark:text-white">
            <%= @registration.category.nome %>
          </dd>

        </div>


        <!-- Lote -->
        <div class="p-6 border-b border-gray-100 dark:border-gray-700">

          <dt class="text-xs font-bold uppercase tracking-wider text-gray-400">
            Lote
          </dt>

          <dd class="mt-2 font-semibold text-gray-900 dark:text-white">
            <%= @registration.lot.numero %>
          </dd>

        </div>

      </dl>

    </div>

  </div>


  <!-- ================================================================
       RESULTADO DA PROVA
       ================================================================ -->

  <% if @result.present? %>

    <div class="bg-white dark:bg-gray-800 rounded-[32px] shadow-xl border border-gray-200 dark:border-gray-700 overflow-hidden">

      <div class="p-8">

        <div class="flex items-center justify-between mb-6">

          <div>
            <p class="text-xs font-black uppercase tracking-widest text-blue-600">
              Resultado
            </p>

            <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
              Seu resultado na prova
            </h2>
          </div>

          <% if @result.homologado? %>

            <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400 text-xs font-bold">
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              Homologado
            </span>

          <% else %>

            <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-400 text-xs font-bold">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              Aguardando homologação
            </span>

          <% end %>

        </div>


        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

          <!-- Posição geral -->
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-900/50 p-5">

            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">
              Posição geral
            </p>

            <p class="mt-2 text-2xl font-black text-gray-900 dark:text-white">
              <%= @result.posicao_geral.presence || "—" %>
            </p>

          </div>


          <!-- Posição categoria -->
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-900/50 p-5">

            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">
              Posição categoria
            </p>

            <p class="mt-2 text-2xl font-black text-gray-900 dark:text-white">
              <%= @result.posicao_categoria.presence || "—" %>
            </p>

          </div>


          <!-- Tempo líquido -->
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-900/50 p-5">

            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">
              Tempo líquido
            </p>

            <p class="mt-2 text-2xl font-black text-gray-900 dark:text-white">
              <%= @result.tempo_liquido.presence || "—" %>
            </p>

          </div>


          <!-- Pace -->
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-900/50 p-5">

            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">
              Pace médio
            </p>

            <p class="mt-2 text-2xl font-black text-gray-900 dark:text-white">
              <%= @result.pace_medio.presence || "—" %>
            </p>

          </div>

        </div>

      </div>

    </div>

  <% end %>


  <!-- ================================================================
       CERTIFICADO
       ================================================================ -->

  <% if @result.nil? %>

    <!-- --------------------------------------------------------------
         SEM RESULTADO
         -------------------------------------------------------------- -->

    <div class="bg-white dark:bg-gray-800 rounded-[32px] shadow-xl border border-gray-100 dark:border-gray-700 overflow-hidden">

      <div class="p-8 flex items-start gap-4">

        <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-gray-100 dark:bg-gray-700 text-gray-500 flex items-center justify-center">
          <span class="text-xl">📄</span>
        </div>

        <div>

          <h3 class="text-lg font-black text-gray-900 dark:text-white">
            Certificado ainda não disponível
          </h3>

          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
            O certificado será disponibilizado após a conclusão e homologação do seu resultado.
          </p>

        </div>

      </div>

    </div>


  <% elsif @certificate.nil? %>

    <!-- --------------------------------------------------------------
         RESULTADO EXISTE, MAS CERTIFICATE AINDA NÃO EXISTE
         -------------------------------------------------------------- -->

    <div class="bg-white dark:bg-gray-800 rounded-[32px] shadow-xl border border-gray-100 dark:border-gray-700 overflow-hidden">

      <div class="p-8 flex items-start gap-4">

        <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-gray-100 dark:bg-gray-700 text-gray-500 flex items-center justify-center">
          <span class="text-xl">📄</span>
        </div>

        <div>

          <h3 class="text-lg font-black text-gray-900 dark:text-white">
            Certificado ainda não disponível
          </h3>

          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
            O certificado será disponibilizado após a homologação do resultado.
          </p>

        </div>

      </div>

    </div>


  <% elsif !@certificate.gerado? %>

    <!-- --------------------------------------------------------------
         CERTIFICATE EXISTE, MAS AINDA NÃO FOI GERADO
         -------------------------------------------------------------- -->

    <div class="bg-white dark:bg-gray-800 rounded-[32px] shadow-xl border border-amber-100 dark:border-amber-900 overflow-hidden">

      <div class="p-8 flex items-start gap-4">

        <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-400 flex items-center justify-center">
          <span class="text-xl">⏳</span>
        </div>

        <div>

          <h3 class="text-lg font-black text-gray-900 dark:text-white">
            Certificado em processamento
          </h3>

          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
            Seu resultado está homologado. O certificado estará disponível assim que a geração for concluída.
          </p>

        </div>

      </div>

    </div>


  <% else %>

    <!-- --------------------------------------------------------------
         CERTIFICATE GERADO
         -------------------------------------------------------------- -->

    <div class="bg-white dark:bg-gray-800 rounded-[32px] shadow-xl border border-green-100 dark:border-green-900 overflow-hidden">

      <div class="p-8">

        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">

          <div class="flex items-start gap-4">

            <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-400 flex items-center justify-center">

              <svg xmlns="http://www.w3.org/2000/svg"
                   fill="none"
                   viewBox="0 0 24 24"
                   stroke-width="2"
                   stroke="currentColor"
                   class="w-6 h-6">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12.75 11.25 15 15 9.75" />

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 3.75 19.5 7.5v5.25c0 4.5-3.375 7.875-7.5 9-4.125-1.125-7.5-4.5-7.5-9V7.5L12 3.75Z" />

              </svg>

            </div>


            <div>

              <h3 class="text-lg font-black text-gray-900 dark:text-white">
                Certificado disponível
              </h3>

              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                Seu certificado de participação foi gerado e está disponível.
              </p>

              <% if @certificate.gerado_em.present? %>

                <p class="text-xs text-gray-400 mt-2">
                  Gerado em
                  <%= l(@certificate.gerado_em, format: :short) %>
                </p>

              <% end %>

            </div>

          </div>


          <%= link_to certificate_athletes_registration_path(@registration),
                      target: "_blank",
                      rel: "noopener",
                      class: "inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm transition-colors" do %>

            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="2"
                 stroke="currentColor"
                 class="w-5 h-5">

              <path stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A2.625 2.625 0 0 1 12 5.625v-1.5A3.375 3.375 0 0 0 8.625.75H6.75A3.75 3.75 0 0 0 3 4.5v15A3.75 3.75 0 0 0 6.75 23.25h10.5A3.75 3.75 0 0 0 21 19.5v-5.25Z" />

              <path stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 14.25h6M9 17.25h6" />

            </svg>

            Ver certificado

          <% end %>

        </div>

      </div>

    </div>

  <% end %>

</div>