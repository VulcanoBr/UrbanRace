<!-- app/views/athletes/transfers/new.html.erb -->

<div class="min-h-screen bg-gray-50 dark:bg-gray-950 px-4 py-8 sm:px-6 lg:px-8">

  <div class="mx-auto max-w-2xl">

    <div class="mb-8">
      <%= link_to athletes_registration_path(@registration),
          class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-500 hover:text-orange-600" do %>
        ← Voltar para inscrição
      <% end %>

      <h1 class="mt-6 text-3xl font-black tracking-tight text-gray-900 dark:text-white">
        Transferir inscrição
      </h1>

      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
        Transfira sua vaga para outra pessoa.
      </p>
    </div>

    <div class="rounded-3xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">

      <div class="border-b border-gray-100 p-6 dark:border-gray-800">
        <div class="flex items-start gap-4">

          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-orange-100 text-orange-600 dark:bg-orange-500/10 dark:text-orange-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M7 7h10M7 12h10M7 17h6" />
            </svg>
          </div>

          <div>
            <h2 class="font-black text-gray-900 dark:text-white">
              <%= @registration.event.nome %>
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              <%= @registration.distance.nome %>
              ·
              <%= @registration.category.nome %>
            </p>

            <% if @registration.numero_dorsal.present? %>
              <p class="mt-2 text-xs font-bold uppercase tracking-wider text-orange-600">
                Dorsal #<%= @registration.numero_dorsal %>
              </p>
            <% end %>
          </div>

        </div>
      </div>

      <div class="p-6">

        <div class="mb-6 rounded-2xl border border-blue-100 bg-blue-50 p-4 dark:border-blue-900/50 dark:bg-blue-950/30">
          <p class="text-sm leading-6 text-blue-800 dark:text-blue-200">
            Informe o e-mail da pessoa que receberá sua inscrição.
            Se ela já possuir uma conta no UrbanRace, a transferência será
            concluída imediatamente. Caso contrário, enviaremos um convite
            válido por 48 horas.
          </p>
        </div>

        <%= form_with model: @transfer_form,
                      url: athletes_registration_transfer_path(@registration),
                      class: "space-y-6" do |form| %>

          <% if @transfer_form.errors.any? %>
            <div class="rounded-2xl border border-red-200 bg-red-50 p-4 dark:border-red-900/50 dark:bg-red-950/30">
              <ul class="space-y-1 text-sm text-red-700 dark:text-red-300">
                <% @transfer_form.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div>
            <%= form.label :cpf_destino, "CPF do destinatário", class: "block text-sm font-bold text-gray-900 dark:text-white" %>
            <%= form.text_field :cpf_destino, placeholder: "000.000.000-00", maxlength: "14",
                class: "mt-2 block w-full rounded-2xl border-gray-300 px-4 py-3 shadow-sm focus:border-orange-500 focus:ring-orange-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white",
                data: { controller: "maskcpfcnpj", action: "keyup->maskcpfcnpj#addMaskToCpfCnpjFields" } %>
            <p class="mt-2 text-xs text-gray-500">
              Informe o CPF da pessoa que receberá sua inscrição.
            </p>
          </div>

          <div>
            <%= form.label :email_destino,
                "E-mail do destinatário",
                class: "block text-sm font-bold text-gray-900 dark:text-white" %>

            <%= form.email_field :email_destino,
                autocomplete: "email",
                placeholder: "nome@exemplo.com",
                class: "mt-2 block w-full rounded-2xl border-gray-300 px-4 py-3 shadow-sm focus:border-orange-500 focus:ring-orange-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" %>

            <p class="mt-2 text-xs text-gray-500">
              Se o CPF já estiver cadastrado, a transferência será realizada imediatamente. Caso contrário, enviaremos um convite válido por 48 horas.
            </p>
          </div>

          <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-800/60">
            <div class="flex gap-3">
              <div class="mt-0.5 text-amber-500">
                ⚠
              </div>

              <div>
                <p class="text-sm font-bold text-gray-900 dark:text-white">
                  Atenção
                </p>

                <p class="mt-1 text-xs leading-5 text-gray-500">
                  Depois que a transferência for concluída, você perderá o
                  direito de participar desta inscrição.
                </p>
              </div>
            </div>
          </div>

          <div class="flex flex-col-reverse mb-4 gap-3 sm:flex-row sm:justify-end">

            <%= link_to "Cancelar",
                athletes_area_do_corredor_path,
                class: "rounded-2xl border border-gray-300 px-5 py-3 text-center text-sm font-bold text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800" %>

            <%= form.submit "Iniciar transferência",
                class: "rounded-2xl bg-orange-600 px-5 py-3 text-sm font-black text-white shadow-sm transition hover:bg-orange-700" %>

          </div>

        <% end %>

        <div class="px-6 py-4  border-t border-gray-100">
          <p class="text-xs font-semibold text-gray-300 mb-2">Requisitos para transferencia:</p>
          <ul class="text-xs text-gray-400 space-y-1">
            <li class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Inscricao confirmada (pagamento aprovado)
            </li>
            <li class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Check-in ainda nao realizado
            </li>
            <li class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Evento ainda nao finalizado ou cancelado
            </li>
            <li class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Destinatario não inscrito no evento
            </li>
          </ul>
        </div>

      </div>
    </div>
  </div>
</div>