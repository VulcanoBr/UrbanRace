<div class="bg-white dark:bg-gray-800 rounded-[34px] border border-gray-100 shadow-sm hover:shadow-xl transition">

  <div class="p-8">

    <div class="flex flex-col lg:flex-row lg:justify-between gap-8">

      <!-- Informações -->

      <div class="flex-1">

        <div class="flex flex-wrap gap-2 mb-4">

          <span class="bg-blue-50 text-blue-700 px-3 py-1 rounded-xl text-xs font-black uppercase">
            <%= l result.event.data_largada, format: "%d/%m/%Y" %>
          </span>

          <% if result.homologado? %>

            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-xl text-xs font-black uppercase">
              Homologado
            </span>

          <% else %>

            <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-xl text-xs font-black uppercase">
              Em análise
            </span>

          <% end %>

        </div>

        <h2 class="text-2xl font-black text-gray-900 dark:text-white">

          <%= result.event.nome %>

        </h2>

        <p class="text-gray-400 font-black mt-2">

          <%= result.registration.distance.nome %>

        </p>

      </div>

      <!-- Tempo -->

      <div class="text-center">

        <p class="text-xs uppercase font-black tracking-widest text-gray-400">
          Tempo Líquido
        </p>

        <p class="text-4xl font-black text-orange-500 mt-2">
          <%= result.tempo_liquido %>
        </p>

        <p class="text-sm text-gray-400 font-black mt-2">

          Pace

          <strong>

            <%= result.pace_medio %>

          </strong>

        </p>

      </div>

    </div>

    <!-- Estatísticas -->

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mt-10">

      <div>
        <p class="text-xs uppercase text-gray-400 font-black">
          Geral
        </p>

        <p class="text-2xl font-black text-orange-500">
          <%= result.posicao_geral %>°
        </p>
      </div>

      <div>
        <p class="text-xs uppercase text-gray-400 font-black">
          Sexo
        </p>

        <p class="text-2xl font-black text-orange-500">
          <%= result.posicao_sexo.present? ? "#{result.posicao_sexo}°" : "--" %>
        </p>
      </div>

      <div>
        <p class="text-xs uppercase text-gray-400 font-black">
          Categoria
        </p>

        <p class="text-2xl font-black text-orange-500">
          <%= result.posicao_categoria.present? ? "#{result.posicao_categoria}°" : "--" %>
        </p>
      </div>

      <div>
        <p class="text-xs uppercase text-gray-400 font-black">
          Faixa Etária
        </p>

        <p class="text-2xl font-black text-orange-500">
          <%= result.posicao_faixa_etaria.present? ? "#{result.posicao_faixa_etaria}°" : "--" %>
        </p>
      </div>

    </div>

    <!-- Botões -->

    <div class="mt-10 flex flex-wrap gap-3">

      <% if result.certificate.present? %>

        <%= link_to "Baixar Certificado",
            certificate_athletes_registration_path(result.registration),
            target: "_blank",
            class: "bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-xl font-black transition" %>

      <% else %>

        <span class="bg-gray-100 text-gray-400 px-6 py-3 rounded-xl font-bold">

          Certificado em processamento

        </span>

      <% end %>

      <%= link_to "Ver Detalhes",
          athletes_result_path(result),
          class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-black transition" %>

      <button
        class="bg-gray-100 hover:bg-gray-200 px-6 py-3 rounded-xl font-black transition">

        Compartilhar

      </button>

    </div>

  </div>

</div>