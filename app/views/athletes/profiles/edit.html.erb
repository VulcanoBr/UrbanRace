<%# app/views/athletes/profiles/edit.html.erb %>
<div class="max-w-4xl mx-auto">
  <div class="mb-10">
    <h1 class="text-3xl font-black text-gray-900 dark:text-white tracking-tighter uppercase">Meu Perfil</h1>
    <p class="text-gray-500 mt-2">Mantenha seus dados atualizados para sua segurança nos eventos.</p>
  </div>

  <%= form_with model: @profile_form, url: athletes_profile_path, method: :patch, class: "space-y-8" do |f| %>
    
    <div class="bg-white dark:bg-gray-800 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
      <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="md:col-span-2">
          <%= f.label :nome, "Nome Completo", class: "block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.text_field :nome, class: "w-full rounded-xl border-gray-300 dark:bg-gray-900 dark:text-white focus:ring-blue-500 shadow-sm" %>
        </div>

        <div data-controller="maskphone">
          <%= f.label :telefone, "Telefone / WhatsApp", class: "block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.text_field :telefone, placeholder: "  (99) 99999-9999",  maxlength: "15",
                            "data-maskphone-target": "inputPhone", "data-action": "keyup->maskphone#addMaskToPhoneFields",
                            class: "w-full rounded-xl px-3 py-1 border-gray-300 dark:bg-gray-900 dark:text-white focus:ring-blue-500 shadow-sm" %>
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-400 mb-1 italic">E-mail (Não alterável)</label>
          <div class="w-full rounded-xl border border-white bg-gray-500 dark:bg-gray-700 px-4 py-2 text-white text-sm">
            <%= current_user.email_address %>
          </div>
        </div>

        <div class="md:col-span-2 border-t border-gray-100 dark:border-gray-700 pt-6 mt-4">
          <h3 class="text-sm font-black text-gray-400 uppercase tracking-widest mb-4">Alterar Senha</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= f.label :password, "Nova Senha", class: "block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1" %>
              <%= f.password_field :password, placeholder: "Mínimo 8 caracteres", class: "w-full rounded-xl px-3 py-1 border-gray-300 dark:bg-gray-900 dark:text-white focus:ring-blue-500 shadow-sm" %>
            </div>
            <div>
              <%= f.label :password_confirmation, "Confirmar Nova Senha", class: "block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1" %>
              <%= f.password_field :password_confirmation, class: "w-full rounded-xl px-3 py-1 border-gray-300 dark:bg-gray-900 dark:text-white focus:ring-blue-500 shadow-sm" %>
            </div>
          </div>
          <p class="mt-4 text-xs text-gray-400 italic">Deixe os campos de senha em branco caso não queira alterá-la.</p>
        </div>
      </div>
    </div>

    <div class="flex justify-end">
      <%= f.submit "SALVAR ALTERAÇÕES", class: "bg-blue-600 text-white px-8 py-3 rounded-2xl font-black text-sm hover:bg-blue-700 transition shadow-lg shadow-blue-200 cursor-pointer" %>
    </div>
  <% end %>

  <%# --- SEÇÃO LGPD (O código que você já tinha) --- %>
  <div class="mt-16 border-t border-red-100 dark:border-red-900/30 pt-10 pb-20">
    <h3 class="text-lg font-bold text-red-600 mb-2 uppercase tracking-tight">Privacidade e Dados (LGPD)</h3>
    <p class="text-sm text-gray-500 mb-8">Gerencie como suas informações são tratadas na plataforma.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-3xl border border-gray-200 dark:border-gray-700">
        <p class="font-bold text-gray-900 dark:text-white">Baixar Meus Dados</p>
        <p class="text-xs text-gray-500 mt-1 mb-6">Receba um arquivo JSON com seu histórico de inscrições e resultados.</p>
        <%= link_to "EXPORTAR DADOS", export_data_athletes_profile_path, class: "inline-block bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 px-4 py-2 rounded-xl font-bold text-[10px] text-gray-700 dark:text-gray-200 hover:bg-gray-100 transition" %>
      </div>

      <div class="p-6 bg-red-50 dark:bg-red-900/10 rounded-3xl border border-red-100 dark:border-red-900/30">
        <p class="font-bold text-red-700">Encerrar Conta</p>
        <p class="text-xs text-red-600/70 mt-1 mb-6">Anonimiza seus dados pessoais. Seus resultados passados serão mantidos sem identificação.</p>
        <%= link_to "SOLICITAR EXCLUSÃO", privacy_request_athletes_profile_path, class: "inline-block bg-red-600 px-4 py-2 rounded-xl font-bold text-[10px] text-white hover:bg-red-700 transition shadow-sm" %>
      </div>
    </div>
  </div>
</div>