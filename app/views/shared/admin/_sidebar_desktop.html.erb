<aside class="hidden lg:flex lg:w-64 lg:flex-col lg:inset-y-0 border-r border-gray-200 bg-white dark:bg-gray-800 dark:border-gray-700">
  <div class="flex flex-col flex-1 min-h-0">
    <!-- Logo -->
    <div class="flex items-center justify-center h-20 flex-shrink-0 px-6 border-b border-gray-100 dark:border-gray-700">
      <%= link_to organizer_dashboard_path, class: "flex items-center justify-center" do %>
        <%= image_tag "logo_urbanrace_3d.png", 
            alt: "UrbanRace", 
            class: "h-24 w-full object-contain drop-shadow-md transition-transform duration-300 hover:scale-105" %>
      <% end %>
    </div>
    <nav class="flex-1 px-4 py-6 space-y-4 overflow-y-auto">
      
      <!-- 1. GERAL (Fase 1) -->
      <div>
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Geral</h3>
        <ul class="space-y-1">
          <%= render "shared/admin/nav_link", label: "Dashboard", path: organizer_dashboard_path, icon: "chart-bar" %>
          <%= render "shared/admin/nav_link", label: "Meus Eventos", path: organizer_events_path, icon: "calendar" %>
          <%= render "shared/admin/nav_link", label: "Base de Atletas", path: organizer_athletes_path, icon: "users" %>
        </ul>
      </div>

      <!-- 2. INSCRIÇÕES E FINANCEIRO (Fase 1 e 2) -->
      <div>
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Inscrições e Vendas</h3>
        <ul class="space-y-1">
          <%= render "shared/admin/nav_link", label: "Inscrições (Global)", path: organizer_registrations_path, icon: "ticket" %>
          <%= render "shared/admin/nav_link", label: "Contratos Fornecedores", path: organizer_supplier_contracts_path, icon: "currency-dollar" %>
          <%= render "shared/admin/nav_link", label: "Contratos Patrocinadores", path: organizer_sponsor_contracts_path, icon: "currency-dollar" %>
        </ul>
      </div>

      <!-- 3. LOGÍSTICA E OPERAÇÃO (Fase 2) -->
      <div>
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Logística</h3>
        <ul class="space-y-1">
          <%= render "shared/admin/nav_link", label: "Fornecedores", path: organizer_suppliers_path, icon: "truck" %>
          <%= render "shared/admin/nav_link", label: "Patrocinadores", path: organizer_sponsors_path, icon: "gift" %>
          <%= render "shared/admin/nav_link", label: "Voluntários", path: organizer_volunteers_path, icon: "user-group" %>
        </ul>
      </div>

    </nav>

    <!-- Footer Sidebar -->
    <div class="
      border-t
      border-gray-200
      dark:border-gray-700
      p-4  mb-2
      bg-gray-50
      dark:bg-gray-800
    ">

      <%= button_to session_path,
          method: :delete,
          class: "
            w-full
            flex
            items-center
            justify-center
            gap-3
            px-4
            py-3
            rounded-xl
            bg-red-600
            hover:bg-red-700
            text-white
            font-semibold
            transition-colors
            duration-200
          " do %>

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m-3-3l-3 3m0 0l3 3m-3-3h12.75" />
        </svg>

        <span>Sair do Sistema</span>

      <% end %>

    </div>

  </div>
</aside>