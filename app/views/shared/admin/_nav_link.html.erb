<%# app/views/shared/admin/_nav_link.html.erb %>
<% 
  # Verifica se a página atual corresponde ao path para destacar o link
  active = current_page?(path) 
  active_classes = "bg-blue-50 text-blue-700 dark:bg-gray-700 dark:text-blue-400"
  inactive_classes = "text-gray-600 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
%>

<li>
  <%= link_to path, class: "group flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors duration-150 #{active ? active_classes : inactive_classes}" do %>
    <!-- Espaço para ícone (Placeholder SVG - Recomendo usar Heroicons) -->
    <svg class="mr-3 h-6 w-6 flex-shrink-0 <%= active ? 'text-blue-600 dark:text-blue-400' : 'text-gray-400 group-hover:text-gray-500 dark:text-gray-500' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
       <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
    </svg>
    <%= label %>
  <% end %>
</li>