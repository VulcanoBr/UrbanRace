<%# app/views/shared/admin/_topbar.html.erb %>
<header class="h-16 flex items-center justify-between px-4 md:px-8 bg-white border-b border-gray-200 dark:bg-gray-800 dark:border-gray-700 sticky top-0 z-10">
  <div class="flex items-center">
    <!-- Botão menu mobile (Gatilha o Stimulus no body) -->
    <button data-action="click->menu#toggle" class="lg:hidden p-2 rounded-md text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
    
    <div class="hidden md:block ml-4 relative">
       <input type="text" placeholder="Buscar atleta ou dorsal..." class="bg-gray-100 border-none rounded-full px-4 py-2 text-sm w-64 focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white">
    </div>
  </div>

  <div class="flex items-center gap-4">
    <!-- Dark Mode Toggle (Stimulus ou JS simples) -->
    <button onclick="toggleDarkMode()" class="p-2 rounded-full text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700">
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" /></svg>
    </button>

    <!-- Notificações -->
    <div class="relative">
      <span class="absolute top-0 right-0 block h-2 w-2 rounded-full bg-red-500 ring-2 ring-white"></span>
      <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
    </div>

    <!-- Perfil do Organizador -->
    <div class="flex items-center gap-3 ml-4 border-l pl-4 dark:border-gray-700">
      <div class="text-right hidden sm:block">
        <p class="text-sm font-semibold dark:text-white"><%= Current.organizer&.name %></p>
        <p class="text-xs text-gray-500">Administrador</p>
      </div>
      <%= button_to session_path, method: :delete, class: "text-gray-400 hover:text-red-500" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" /></svg>
      <% end %>
    </div>
  </div>
</header>