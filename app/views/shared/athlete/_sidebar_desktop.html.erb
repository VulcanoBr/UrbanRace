<%# app/views/shared/athlete/_sidebar_desktop.html.erb %>
<aside class="hidden lg:flex lg:w-64 lg:flex-col border-r border-gray-200 bg-white dark:bg-gray-800 dark:border-gray-700">
  <div class="flex flex-col flex-1 min-h-0">
    
    <!-- Logo Identidade (Ajustado conforme solicitado) -->
    <div class="flex items-center justify-center h-20 flex-shrink-0 px-6 border-b border-gray-100 dark:border-gray-700">
      <%= link_to athletes_area_do_corredor_path, class: "flex items-center justify-center" do %>
        <%= image_tag "logo_urbanrace_3d.png", 
            alt: "UrbanRace", 
            class: "h-24 w-full object-contain drop-shadow-md transition-transform duration-300 hover:scale-105" %>
      <% end %>
    </div>

    <nav class="flex-1 px-4 py-8 space-y-2 overflow-y-auto">
      <h3 class="text-[10px] font-black text-gray-400 uppercase tracking-widest px-3 mb-4">Menu do Corredor</h3>
      
      <%= render "shared/admin/nav_link", label: "Minhas Provas", path: athletes_area_do_corredor_path, icon: "ticket" %>
      <%= render "shared/admin/nav_link", label: "Minhas Fotos IA", path: athletes_photos_path, icon: "camera" %>
      <%= render "shared/admin/nav_link", label: "Meu Perfil", path: edit_athletes_profile_path, icon: "user" %>
      <%= render "shared/admin/nav_link", label: "Resultados", path: athletes_results_path, icon: "trophy" %>
    </nav>

    <!-- Footer da Sidebar (Perfil e Logout) -->
    <div class="p-4 border-t border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/50">
      <div class="flex items-center gap-3 mb-4 px-2">
        <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-xs shadow-sm">
          <%= current_user.nome[0..1].upcase %>
        </div>
        <div class="truncate">
          <p class="text-xs font-bold text-gray-900 dark:text-white truncate"><%= current_user.nome %></p>
          <p class="text-[10px] text-gray-500 truncate uppercase font-medium">Atleta</p>
        </div>
      </div>

      <%= button_to session_path, method: :delete, class: "
            w-full
            flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-red-600 hover:bg-red-700
            text-white
            font-semibold transition-colors duration-200 " do %>

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m-3-3l-3 3m0 0l3 3m-3-3h12.75" />
        </svg>

        <span>Sair do Sistema</span>

      <% end %>
    </div>

  </div>
</aside>