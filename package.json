{
  "name": "app",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --loader:.png=file --loader:.jpg=file --loader:.svg=file --watch",
    "build:css": "npx @tailwindcss/cli -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@rails/request.js": "^0.0.13",
    "@tailwindcss/cli": "^4.3.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "tailwindcss": "^4.3.0"
  }
}
